{
  "AppSettings": {
    "ShowDetailedErrors": false
  },
  "RconEncryption": {
    // Leave empty - a unique key is generated automatically on first startup.
    "Key": ""
  },
  "Jwt": {
    // Leave empty - a unique key is generated automatically on first startup.
    "Key": "",
    "Issuer": "RustRconServerManager",
    "Audience": "RustRconServerManager"
  },
  "SteamApi": {
    // Get one at https://steamcommunity.com/dev/apikey (used for player profile/VAC-ban lookups)
    "ApiKey": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;port=3306;database=RustRconServerManager;user=RustRconServerManager;password=;SslMode=none"
  },
  "Smtp": {
    // Required for the "forgot password" email flow. Leave Host empty to disable it.
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "",
    "EnableSsl": true
  },
  "ProxyCheck": {
    // Get one at https://proxycheck.io/ (used for VPN/proxy detection in Server Protection)
    "ApiKey": "",
    "HmacKey": ""
  },
  "Cors": {
    // Extra allowed origins if you host the frontend separately from this API. Same-origin and localhost are always allowed.
    "AllowedOrigins": []
  },
  "Logging": {
    // The real minimum level is controlled at runtime from the Panel Settings page
    // (stored in PanelSettings.MinimumLogLevel, applied via LogLevelState) - this
    // "Default" is only the fallback used in the brief window before that value is
    // loaded from the database on startup.
    "LogLevel": {
      "Default": "Error"
    }
  },
  "AllowedHosts": "*"
}
