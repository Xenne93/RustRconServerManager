@page "/forgot-password"
@layout LoginLayout
@using RustRconServerManager.Shared.Authorization
@using RustRconServerManager.Frontend.Services
@using System.Net.Http.Json
@inject NavigationHelper NavHelper
@inject HttpClient Http

<section class="flex justify-center items-center min-h-screen overflow-y-auto bg-[rgb(var(--body-bg))]">
    <div class="w-full max-w-md px-4">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-white">Rust RCON Server Manager</h1>
            <p class="text-slate-400 mt-2">Password Recovery</p>
            <!-- Progress indicator -->
            <div class="w-full bg-slate-800 rounded-full h-1 mt-4">
                <div class="bg-orange-500 h-1 rounded-full transition-all duration-300" style="width: @(currentStep == Step.RequestCode ? "50%" : "100%")"></div>
            </div>
            <small class="text-slate-500">Step @(currentStep == Step.RequestCode ? "1" : "2") of 2</small>
        </div>

        <div class="rounded-xl border border-slate-700/50 bg-gradient-to-br from-slate-900/80 to-slate-950/80 backdrop-blur-sm">
            <div class="p-6 flex flex-col items-center">
                <!-- Icon -->
                <div class="w-16 h-16 rounded-full bg-orange-500/20 flex items-center justify-center my-4">
                    @if (currentStep == Step.RequestCode)
                    {
                        <i class="fa-solid fa-envelope text-orange-400 text-2xl"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-key text-orange-400 text-2xl"></i>
                    }
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="w-full rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 mb-4 text-sm">
                        @errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="w-full rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-4 py-3 mb-4 text-sm">
                        @successMessage
                    </div>
                }

                @if (currentStep == Step.RequestCode)
                {
                    <form class="text-center w-full">
                        <p class="text-slate-400 text-sm mb-4">Enter your email address and we'll send you a recovery code.</p>

                        <div class="mb-4">
                            <input @bind="email" @bind:event="oninput"
                                   class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 transition-colors"
                                   type="email" placeholder="Email" @onkeypress="HandleKeyPress" />
                        </div>

                        <div class="mb-4">
                            <button @onclick="SendRecoveryCode"
                                    class="w-full bg-orange-500 hover:bg-orange-600 text-white font-medium py-2.5 px-4 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                    type="button" disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="tw-spinner inline-block w-4 h-4 mr-2 align-middle"></span>
                                }
                                Send Recovery Code
                            </button>
                        </div>

                        <button @onclick='() => NavHelper.NavigateTo("/login")' class="text-orange-400 hover:text-orange-300 text-sm transition-colors" type="button">
                            <i class="fas fa-arrow-left mr-1"></i> Back to login
                        </button>
                    </form>
                }
                else if (currentStep == Step.ResetPassword)
                {
                    <form class="text-center w-full">
                        <p class="text-slate-400 text-sm mb-4">Enter the 6-digit code sent to your email along with your new password.</p>

                        <div class="mb-4">
                            <label class="block text-left text-sm text-slate-300 mb-1">Email</label>
                            <input @bind="email"
                                   class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-2.5 text-slate-400 cursor-not-allowed"
                                   type="email" readonly />
                        </div>

                        <div class="mb-4">
                            <label class="block text-left text-sm text-slate-300 mb-1">Recovery Code</label>
                            <input @bind="code" @bind:event="oninput"
                                   class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-2.5 text-white text-center tracking-widest placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 transition-colors"
                                   type="text" placeholder="Enter 6-digit code" maxlength="6" @onkeypress="HandleKeyPress" />
                        </div>

                        <div class="mb-4">
                            <label class="block text-left text-sm text-slate-300 mb-1">New Password</label>
                            <input @bind="newPassword" @bind:event="oninput"
                                   class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 transition-colors"
                                   type="password" placeholder="Enter new password" @onkeypress="HandleKeyPress" />
                        </div>

                        <div class="mb-4">
                            <label class="block text-left text-sm text-slate-300 mb-1">Confirm Password</label>
                            <input @bind="confirmPassword" @bind:event="oninput"
                                   class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 transition-colors"
                                   type="password" placeholder="Re-enter new password" @onkeypress="HandleKeyPress" />
                        </div>

                        <div class="mb-4">
                            <button @onclick="ResetPassword"
                                    class="w-full bg-orange-500 hover:bg-orange-600 text-white font-medium py-2.5 px-4 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                    type="button" disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="tw-spinner inline-block w-4 h-4 mr-2 align-middle"></span>
                                }
                                Reset Password
                            </button>
                        </div>

                        <button @onclick="BackToStep1" class="text-orange-400 hover:text-orange-300 text-sm transition-colors" type="button">
                            <i class="fas fa-arrow-left mr-1"></i> Send a new code
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private enum Step { RequestCode, ResetPassword }

    private Step currentStep = Step.RequestCode;
    private bool isProcessing = false;
    private string email = string.Empty;
    private string code = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string? errorMessage;
    private string? successMessage;

    private async Task HandleKeyPress(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (currentStep == Step.RequestCode)
                await SendRecoveryCode();
            else
                await ResetPassword();
        }
    }

    private async Task SendRecoveryCode()
    {
        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Please enter your email address.";
            isProcessing = false;
            return;
        }

        try
        {
            var dto = new Authorization_ForgotPasswordDTO { Email = email };
            var response = await Http.PostAsJsonAsync("/api/Auth/forgot-password", dto);
            var result = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();

            successMessage = result?["message"] ?? "Recovery code sent.";
            currentStep = Step.ResetPassword;
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ResetPassword()
    {
        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(code))
        {
            errorMessage = "Please enter the recovery code.";
            isProcessing = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Please enter a new password.";
            isProcessing = false;
            return;
        }

        if (newPassword != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            isProcessing = false;
            return;
        }

        try
        {
            var dto = new Authorization_ResetPasswordDTO
            {
                Email = email,
                Code = code,
                NewPassword = newPassword,
                ConfirmPassword = confirmPassword
            };

            var response = await Http.PostAsJsonAsync("/api/Auth/reset-password", dto);
            var result = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();

            if (response.IsSuccessStatusCode)
            {
                successMessage = result?["message"] ?? "Password reset successfully.";
                await Task.Delay(2000);
                NavHelper.NavigateTo("/login");
            }
            else
            {
                errorMessage = result?["message"] ?? "Failed to reset password.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void BackToStep1()
    {
        currentStep = Step.RequestCode;
        code = string.Empty;
        newPassword = string.Empty;
        confirmPassword = string.Empty;
        errorMessage = null;
        successMessage = null;
    }
}
