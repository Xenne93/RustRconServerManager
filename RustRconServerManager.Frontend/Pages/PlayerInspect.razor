@* Search Results Modal *@
<TwModal @bind-IsOpen="showSearchModal" Title='@($"Search Results: \"{searchQuery}\"")' Size="lg" MaxHeight="60vh">
    <ChildContent>
        @if (searchResults.Count == 0)
        {
            <div class="rounded-lg bg-blue-500/10 border border-blue-500/30 text-blue-400 px-4 py-3 text-sm">
                <i class="fas fa-info-circle mr-2"></i>No messages found matching "@searchQuery"
            </div>
        }
        else
        {
            <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-4 py-3 text-sm mb-4">
                <i class="fas fa-check-circle mr-2"></i>Found @searchResults.Count message(s)
            </div>
            <div class="max-h-[400px] overflow-y-auto rounded-lg border border-slate-700/50">
                <table class="w-full text-sm">
                    <thead class="sticky top-0 bg-slate-800/90 backdrop-blur z-10">
                        <tr class="border-b border-slate-700/50">
                            <th class="px-3 py-2 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400 w-44">Timestamp</th>
                            <th class="px-3 py-2 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400 w-24">Channel</th>
                            <th class="px-3 py-2 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var msg in searchResults)
                        {
                            <tr class="border-b border-slate-700/30 hover:bg-slate-800/40">
                                <td class="px-3 py-2"><span class="text-xs text-slate-500">@msg.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss")</span></td>
                                <td class="px-3 py-2">
                                    @{
                                        var (channelName, channelClass) = GetChannelInfo(msg.Channel);
                                    }
                                    <span class="@channelClass">@channelName</span>
                                </td>
                                <td class="px-3 py-2 text-slate-300">@HighlightSearchTerm(msg.Message, searchQuery)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button class="tw-btn-ghost px-4 py-2 text-sm" @onclick="CloseSearchModal">Close</button>
    </FooterContent>
</TwModal>

@* Report Detail Modal *@
<TwModal @bind-IsOpen="showReportModal" Title="Report Details" Size="lg">
    <ChildContent>
        @if (selectedReport != null)
        {
            @* Reporter Information *@
            <div class="mb-4">
                <h6 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Reporter Information</h6>
                <div class="rounded-lg border border-slate-700/50 bg-slate-800/30 p-3">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <span class="text-xs text-slate-400">Name:</span>
                            <span class="text-sm text-white ml-1">@selectedReport.ReporterName</span>
                        </div>
                        <div>
                            <span class="text-xs text-slate-400">Steam ID:</span>
                            <span class="text-xs text-slate-300 font-mono ml-1">@selectedReport.ReporterId</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Reported Player *@
            <div class="mb-4">
                <h6 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Reported Player</h6>
                <div class="rounded-lg border border-slate-700/50 bg-slate-800/30 p-3">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <span class="text-xs text-slate-400">Name:</span>
                            <span class="text-sm text-white ml-1">@selectedReport.ReportedName</span>
                        </div>
                        <div>
                            <span class="text-xs text-slate-400">Steam ID:</span>
                            <span class="text-xs text-slate-300 font-mono ml-1">@selectedReport.ReportedId</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Report Details *@
            <div class="mb-4">
                <h6 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Report Information</h6>
                <div class="space-y-3">
                    <div>
                        <span class="text-xs text-slate-400">Type:</span>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-slate-500/20 text-slate-400 ml-1">@selectedReport.Type</span>
                    </div>
                    <div>
                        <span class="text-xs text-slate-400 block mb-1">Subject:</span>
                        <div class="rounded bg-slate-900/50 border border-slate-700/30 p-2 text-sm text-white">@selectedReport.Subject</div>
                    </div>
                    @if (!string.IsNullOrEmpty(selectedReport.Message))
                    {
                        <div>
                            <span class="text-xs text-slate-400 block mb-1">Message:</span>
                            <div class="rounded bg-slate-900/50 border border-slate-700/30 p-2 text-sm text-slate-300">@selectedReport.Message</div>
                        </div>
                    }
                    <div>
                        <span class="text-xs text-slate-400">Created:</span>
                        <span class="text-sm text-white ml-1">@selectedReport.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss")</span>
                    </div>
                </div>
            </div>

            @* Status Selection *@
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-300 mb-1">Status</label>
                <select class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                        @bind="editReportStatus">
                    <option value="Pending">Pending</option>
                    <option value="Reviewed">Reviewed</option>
                    <option value="Dismissed">Dismissed</option>
                    <option value="Action Taken">Action Taken</option>
                </select>
            </div>

            @* Admin Notes *@
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-300 mb-1">Admin Notes</label>
                <textarea class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white placeholder:text-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                          rows="4" @bind="editReportAdminNotes" placeholder="Add notes about this report..."></textarea>
            </div>

            @* Archive Toggle *@
            <div class="mb-4">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" class="w-4 h-4 rounded border-slate-600 bg-slate-800 text-orange-500 focus:ring-orange-500/50" @bind="editReportIsArchived" />
                    <span class="text-sm text-slate-300">Archive this report</span>
                </label>
                <p class="text-xs text-slate-500 mt-1 ml-6">Archived reports are hidden from the active list</p>
            </div>

            @if (selectedReport.ReviewedAt.HasValue)
            {
                <div class="rounded-lg bg-blue-500/10 border border-blue-500/30 text-blue-400 px-4 py-2 text-xs">
                    Last reviewed: @selectedReport.ReviewedAt.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss")
                </div>
            }
        }
    </ChildContent>
    <FooterContent>
        <button class="tw-btn-ghost px-4 py-2 text-sm" @onclick="CloseReportModal">Close</button>
        <button class="tw-btn-primary px-4 py-2 text-sm" @onclick="SaveReport">
            <i class="fas fa-save mr-1"></i>Save Changes
        </button>
    </FooterContent>
</TwModal>

