    private (string Name, string Class) GetChannelInfo(string channel)
    {
        return channel switch
        {
            "0" => ("Global", "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-orange-500/20 text-orange-400"),
            "1" => ("Team", "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-500/20 text-emerald-400"),
            "2" => ("Server", "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-amber-500/20 text-amber-400"),
            "3" => ("Local", "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-blue-500/20 text-blue-400"),
            "4" => ("Cards", "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-slate-500/20 text-slate-400"),
            _ => (channel, "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-slate-500/20 text-slate-400")
        };
    }

