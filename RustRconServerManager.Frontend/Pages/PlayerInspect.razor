    // ========== CLEAR PLAYER DATA ==========

    private bool showClearDataModal = false;
    private bool isClearingData = false;
    private string clearDataError = "";
    private string clearDataSuccess = "";
    private bool clearChat, clearKills, clearDeaths, clearNotes, clearReports, clearBanHistory;
    private bool AnyClearOptionSelected => clearChat || clearKills || clearDeaths || clearNotes || clearReports || clearBanHistory;

    private void OpenClearDataModal()
    {
        clearChat = clearKills = clearDeaths = clearNotes = clearReports = clearBanHistory = false;
        clearDataError = clearDataSuccess = "";
        showClearDataModal = true;
    }

    private async Task ClearSelectedData()
    {
        if (!AnyClearOptionSelected) return;
        await ExecuteClearData(deletePlayer: false);
    }

    private async Task DeletePlayerAndAllData()
    {
        await ExecuteClearData(deletePlayer: true);
    }

    private async Task ExecuteClearData(bool deletePlayer)
    {
        try
        {
            isClearingData = true;
            clearDataError = clearDataSuccess = "";

            var request = new
            {
                ServerId = currentServerId,
                ChatMessages = deletePlayer || clearChat,
                Kills = deletePlayer || clearKills,
                Deaths = deletePlayer || clearDeaths,
                Notes = deletePlayer || clearNotes,
                Reports = deletePlayer || clearReports,
                BanHistory = deletePlayer || clearBanHistory,
                All = deletePlayer,
                DeletePlayer = deletePlayer
            };

            var response = await Http.PostAsJsonAsync($"/api/PlayerInspect/{SteamId}/clear-data", request);
            if (response.IsSuccessStatusCode)
            {
                if (deletePlayer)
                {
                    showClearDataModal = false;
                    NavHelper.NavigateTo("players", true);
                }
                else
                {
                    clearDataSuccess = "Selected data cleared successfully.";
                    clearChat = clearKills = clearDeaths = clearNotes = clearReports = clearBanHistory = false;
                    await LoadPlayerData();
                    if (killsLoaded) { killsPage = 0; await LoadKills(); }
                    if (deathsLoaded) { deathsPage = 0; await LoadDeaths(); }
                }
            }
            else
            {
                clearDataError = "Failed to clear data. Please try again.";
            }
        }
        catch (Exception ex)
        {
            clearDataError = $"Error: {ex.Message}";
        }
        finally
        {
            isClearingData = false;
        }
    }

