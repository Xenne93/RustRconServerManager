                            <p class="text-slate-500 text-sm mb-4">Inventory can only be retrieved when the player is online.</p>
                            <button class="tw-btn-secondary opacity-50 cursor-not-allowed" disabled>
                                <i class="fas fa-box-open mr-2"></i>Get Player Inventory
                            </button>
                        </div>
                    }
                    else if (inventoryData == null && !isLoadingInventory)
                    {
                        <div class="text-center py-8">
                            <i class="fas fa-box-open text-3xl text-slate-600 mb-3 block"></i>
                            <p class="text-slate-400 text-sm mb-4">Click the button below to retrieve the player's current inventory from the server.</p>
