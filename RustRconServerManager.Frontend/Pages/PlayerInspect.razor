    private MarkupString HighlightSearchTerm(string message, string searchTerm)
    {
        if (string.IsNullOrEmpty(message) || string.IsNullOrEmpty(searchTerm))
            return new MarkupString(message);

        var highlightedMessage = message.Replace(searchTerm,
            $"<mark style='background-color: #f97316; color: white; padding: 2px 4px; border-radius: 2px; font-weight: 500;'>{searchTerm}</mark>",
            StringComparison.OrdinalIgnoreCase);

        return new MarkupString(highlightedMessage);
    }

