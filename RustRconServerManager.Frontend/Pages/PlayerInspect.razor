                                            @if (item.MaxCondition > 0)
                                            {
                                                var condPercent = (item.Condition / item.MaxCondition) * 100;
                                                var condColor = condPercent > 60 ? "#4ade80" : condPercent > 25 ? "#facc15" : "#f87171";
                                                <div class="absolute bottom-0 left-0 right-0 h-1 bg-slate-900/80 rounded-b-lg overflow-hidden">
                                                    <div style="width: @(condPercent.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%; background: @condColor; height: 100%;"></div>
