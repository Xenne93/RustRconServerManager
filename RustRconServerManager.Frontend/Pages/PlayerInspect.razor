@page "/inspect/{SteamId}"
@using Microsoft.AspNetCore.Authorization
@using Blazored.LocalStorage
@using RustRconServerManager.Frontend.Components.Layout
@using RustRconServerManager.Frontend.Components
@using RustRconServerManager.Frontend.Components.UI
@using RustRconServerManager.Frontend.Utilities
@using RustRconServerManager.Shared.PlayerInspect
@using RustRconServerManager.Shared.PlayerNotes
@using RustRconServerManager.Shared.PlayerList
@using RustRconServerManager.Frontend.Services
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject NavigationManager Nav
@inject ServerValidationHelper ServerValidationHelper
@inject IJSRuntime JSRuntime

@attribute [Authorize]

<ContentWrapper>
    @if (isLoading)
    {
        <div class="tw-card">
            <div class="tw-card-body">
                <div class="text-center py-8">
                    <div class="tw-spinner mx-auto mb-3"></div>
                    <p class="text-slate-500 text-sm">Loading player data...</p>
                </div>
            </div>
        </div>
    }
    else if (playerData == null)
    {
        <div class="rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 text-sm mb-4">
            <i class="fas fa-exclamation-triangle mr-2"></i>
            Player not found or you don't have access to view this player.
        </div>
        <button class="tw-btn-ghost px-4 py-2 text-sm" @onclick='() => Nav.NavigateTo(NavHelper.GetUrl("players"))'>
            <i class="fas fa-arrow-left mr-2"></i>Back to Player List
        </button>
    }
    else
    {
        @* Header *@
        <div class="flex items-center gap-3 mb-6">
            <button class="h-9 w-9 flex items-center justify-center rounded-lg border border-slate-700 text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
                    @onclick='() => Nav.NavigateTo(NavHelper.GetUrl("players"))'>
                <i class="fas fa-arrow-left text-sm"></i>
            </button>
            <h1 class="text-2xl font-bold text-white">Player Inspect</h1>
        </div>

        @* Player Overview Card *@
        <div class="tw-card mb-6">
            <div class="tw-card-header">
                <div class="flex items-center gap-2">
                    <i class="fas fa-user text-orange-400 text-sm"></i>
                    <span class="text-sm font-semibold text-white">Player Overview</span>
                </div>
            </div>
            <div class="tw-card-body">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    @* Avatar and Basic Info *@
                    <div class="text-center">
                        @if (!string.IsNullOrEmpty(playerData.PlayerData.Avatar))
                        {
                            <img src="@playerData.PlayerData.Avatar" alt="@playerData.PlayerData.Name"
                                 class="w-32 h-32 rounded-xl object-cover mx-auto mb-3 ring-2 ring-slate-700" />
                        }
                        else
                        {
                            <div class="w-32 h-32 rounded-xl bg-gradient-to-br from-orange-500/30 to-amber-600/30 flex items-center justify-center mx-auto mb-3 ring-2 ring-slate-700">
                                <i class="fas fa-user text-4xl text-orange-300"></i>
                            </div>
                        }
                        <h4 class="text-lg font-bold text-white">@playerData.PlayerData.Name</h4>
                        <p class="text-slate-500 text-xs font-mono mt-1">@playerData.PlayerData.SteamId</p>

                        <div class="flex flex-wrap items-center justify-center gap-2 mt-3">
                            @if (playerData.PlayerData.IsOnline)
                            {
                                <span class="tw-badge-success text-xs"><i class="fas fa-circle mr-1 text-[8px]"></i>Online</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-slate-500/20 text-slate-400">
                                    <i class="fas fa-circle mr-1 text-[8px]"></i>Offline
                                </span>
                            }

                            @if (playerData.PlayerData.IsBanned)
                            {
                                <span class="tw-badge-danger text-xs"><i class="fas fa-ban mr-1"></i>Banned</span>
                                @if (playerData.PlayerData.IsGlobalBan)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-amber-500/20 text-amber-400">
                                        <i class="fas fa-globe mr-1"></i>Global
                                    </span>
                                }
                            }

                            @if (playerData.PlayerData.VACBanned)
                            {
                                <span class="tw-badge-danger text-xs">
                                    <i class="fas fa-shield-alt mr-1"></i>
                                    VAC (@playerData.PlayerData.NumberOfVACBans ban@(playerData.PlayerData.NumberOfVACBans > 1 ? "s" : ""))
                                </span>
                                @if (playerData.PlayerData.DaysSinceLastVACBan.HasValue)
                                {
                                    <span class="text-xs text-slate-500">@playerData.PlayerData.DaysSinceLastVACBan days ago</span>
                                }
                            }
                        </div>

                        <div class="flex flex-wrap items-center justify-center gap-2 mt-4">
                            <a href="https://steamcommunity.com/profiles/@playerData.PlayerData.SteamId" target="_blank" rel="noopener noreferrer"
                               class="tw-btn-primary px-3 py-1.5 text-xs">
                                <i class="fab fa-steam mr-1.5"></i>Steam Profile
                            </a>
                            <button class="tw-btn-success px-3 py-1.5 text-xs" @onclick="OpenGiveItemDialog"
                                    disabled="@(!playerData.PlayerData.IsOnline)"
                                    title="@(playerData.PlayerData.IsOnline ? "Give item to player" : "Player must be online")">
                                <i class="fas fa-gift mr-1.5"></i>Give Item
                            </button>
                            <button class="px-3 py-1.5 text-xs font-medium rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 border border-red-500/30 transition-colors"
                                    @onclick="OpenClearDataModal">
                                <i class="fas fa-trash-alt mr-1.5"></i>Clear Data
                            </button>
                        </div>
                    </div>

                    @* Connection Information *@
                    <div>
                        <h6 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">Connection Information</h6>
                        <div class="space-y-2.5">
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">First Seen</span>
                                <span class="text-sm text-white">@playerData.PlayerData.FirstSeen.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">Last Seen</span>
                                <span class="text-sm text-white">@playerData.PlayerData.LastSeen.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">Total Playtime</span>
                                <span class="text-sm text-white">@playerData.PlayerData.TotalPlaytimeHours.ToString("F1") hours</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">Country</span>
                                <span class="text-sm text-white">
                                    @if (!string.IsNullOrEmpty(playerData.PlayerData.Country))
                                    {
                                        var flagUrl = CountryFlagHelper.GetFlagImageUrl(playerData.PlayerData.Country);
                                        @if (!string.IsNullOrEmpty(flagUrl))
                                        {
                                            <img src="@flagUrl" alt="@playerData.PlayerData.Country" class="w-5 h-3.5 rounded-sm inline mr-1" />
                                        }
                                        @playerData.PlayerData.Country
                                    }
                                    else
                                    {
                                        <span class="text-slate-500">Unknown</span>
                                    }
                                </span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">Steam Age</span>
                                <span class="text-sm text-white">
                                    @if (playerData.PlayerData.SteamAccountCreated.HasValue)
                                    {
                                        var accountAge = DateTime.UtcNow - playerData.PlayerData.SteamAccountCreated.Value;
                                        var years = (int)(accountAge.TotalDays / 365.25);
                                        <span>@years year@(years != 1 ? "s" : "")</span>
                                        <span class="text-slate-500 text-xs ml-1">(@playerData.PlayerData.SteamAccountCreated.Value.ToString("MMM yyyy"))</span>
                                    }
                                    else if (playerData.PlayerData.ProfileVisibility == 1)
                                    {
                                        <span class="text-slate-500">Private</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-500">Unknown</span>
                                    }
                                </span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">Rust Hours</span>
                                <span class="text-sm text-white">
                                    @if (playerData.PlayerData.RustPlaytimeMinutes.HasValue)
                                    {
                                        var hours = playerData.PlayerData.RustPlaytimeMinutes.Value / 60.0;
                                        @hours.ToString("N0")
                                        <span class="text-slate-500 text-xs ml-0.5">hours</span>
                                    }
                                    else if (playerData.PlayerData.ProfileVisibility == 1)
                                    {
                                        <span class="text-slate-500">Private</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-500">Unknown</span>
                                    }
                                </span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">Last IP</span>
                                <span class="text-sm">
                                    @if (!string.IsNullOrEmpty(playerData.PlayerData.LastIp))
                                    {
                                        <span class="font-mono text-xs px-2 py-0.5 rounded bg-blue-500/10 text-blue-400">@playerData.PlayerData.LastIp</span>
                                        @if (playerData.PlayerData.IsVpn)
                                        {
                                            <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 ml-1">VPN</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-slate-500">Unknown</span>
                                    }
                                </span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">VAC Status</span>
                                <span class="text-sm">
                                    @if (playerData.PlayerData.VACBanned)
                                    {
                                        <span class="tw-badge-danger text-[10px]">
                                            <i class="fas fa-shield-alt mr-1"></i>
                                            @playerData.PlayerData.NumberOfVACBans VAC Ban@(playerData.PlayerData.NumberOfVACBans > 1 ? "s" : "")
                                        </span>
                                        @if (playerData.PlayerData.DaysSinceLastVACBan.HasValue)
                                        {
                                            <span class="text-slate-500 text-xs ml-1">@playerData.PlayerData.DaysSinceLastVACBan d ago</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="tw-badge-success text-[10px]"><i class="fas fa-check mr-1"></i>Clean</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>

                    @* Current Stats *@
                    <div>
                        <h6 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">
                            Current Stats @(playerData.PlayerData.IsOnline ? "" : "(Last Known)")
                        </h6>
                        <div class="space-y-2.5">
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">Ping</span>
                                <span class="text-sm">
                                    @if (playerData.PlayerData.CurrentPing.HasValue)
                                    {
                                        <span class="text-white">@playerData.PlayerData.CurrentPing ms</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-600">-</span>
                                    }
                                </span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">Health</span>
                                <span class="text-sm">
                                    @if (playerData.PlayerData.CurrentHealth.HasValue)
                                    {
                                        <span class="text-red-400 font-medium">@playerData.PlayerData.CurrentHealth.Value.ToString("F0") HP</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-600">-</span>
                                    }
                                </span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">Team</span>
                                <span class="text-sm">
                                    @if (playerData.PlayerData.CurrentTeamId.HasValue && playerData.PlayerData.CurrentTeamId.Value > 0)
                                    {
                                        <span class="text-white">Team @playerData.PlayerData.CurrentTeamId</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-500">Solo</span>
                                    }
                                </span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">Position</span>
                                <span class="text-sm">
                                    @if (playerData.PlayerData.CurrentPosition != null)
                                    {
                                        <span class="font-mono text-xs text-slate-300">
                                            @playerData.PlayerData.CurrentPosition.X.ToString("F0"), @playerData.PlayerData.CurrentPosition.Y.ToString("F0"), @playerData.PlayerData.CurrentPosition.Z.ToString("F0")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-600">-</span>
                                    }
                                </span>
                            </div>
                        </div>

                        <h6 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3 mt-6">Statistics</h6>
                        <div class="space-y-2.5">
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">Total Kills</span>
                                <span class="text-sm font-semibold text-emerald-400">@playerData.PlayerData.TotalKills</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">Total Deaths</span>
                                <span class="text-sm font-semibold text-red-400">@playerData.PlayerData.TotalDeaths</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm text-slate-400">K/D Ratio</span>
                                <span class="text-sm font-semibold text-blue-400">
                                    @if (playerData.PlayerData.TotalDeaths > 0)
                                    {
                                        @((playerData.PlayerData.TotalKills / (double)playerData.PlayerData.TotalDeaths).ToString("F2"))
                                    }
                                    else if (playerData.PlayerData.TotalKills > 0)
                                    {
                                        @playerData.PlayerData.TotalKills.ToString("F2")
                                    }
                                    else
                                    {
                                        <span>0.00</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Ban Information Card *@
        @if (playerData.PlayerData.IsBanned)
        {
            <div class="rounded-xl border border-red-500/30 bg-red-500/5 mb-6">
                <div class="px-4 py-3 border-b border-red-500/30 bg-red-500/10 rounded-t-xl">
                    <div class="flex items-center gap-2">
                        <i class="fas fa-ban text-red-400 text-sm"></i>
                        <span class="text-sm font-semibold text-red-400">Active Ban Information</span>
                    </div>
                </div>
                <div class="p-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">Reason</p>
                            <p class="text-sm text-white">@(playerData.PlayerData.BanReason ?? "No reason provided")</p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">Expires</p>
                            <p class="text-sm">
                                @if (playerData.PlayerData.BanExpiry.HasValue)
                                {
                                    <span class="text-white">@playerData.PlayerData.BanExpiry.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-red-400 font-semibold">Permanent</span>
                                }
                            </p>
                            @if (playerData.PlayerData.IsGlobalBan)
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-amber-500/20 text-amber-400 mt-1">
                                    <i class="fas fa-globe mr-1"></i>Global Ban (All Servers)
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Tabs *@
        <div class="mb-6">
            <div class="flex flex-wrap gap-1 border-b border-slate-700/50 pb-px overflow-x-auto">
                <button class="px-3 py-2 text-sm font-medium transition-colors whitespace-nowrap @(activeTab == "chat" ? "text-orange-400 border-b-2 border-orange-400" : "text-slate-400 hover:text-white")"
                        @onclick='() => SetActiveTab("chat")'>
                    <i class="fas fa-comments mr-1.5"></i>Chat (@totalChatMessages)
                </button>
                <button class="px-3 py-2 text-sm font-medium transition-colors whitespace-nowrap @(activeTab == "kills" ? "text-orange-400 border-b-2 border-orange-400" : "text-slate-400 hover:text-white")"
                        @onclick='() => SetActiveTab("kills")'>
                    <i class="fas fa-crosshairs mr-1.5"></i>Kills (@playerData.PlayerData.TotalKills)
                </button>
                <button class="px-3 py-2 text-sm font-medium transition-colors whitespace-nowrap @(activeTab == "deaths" ? "text-orange-400 border-b-2 border-orange-400" : "text-slate-400 hover:text-white")"
                        @onclick='() => SetActiveTab("deaths")'>
                    <i class="fas fa-skull mr-1.5"></i>Deaths (@playerData.PlayerData.TotalDeaths)
                </button>
                <button class="px-3 py-2 text-sm font-medium transition-colors whitespace-nowrap @(activeTab == "bans" ? "text-orange-400 border-b-2 border-orange-400" : "text-slate-400 hover:text-white")"
                        @onclick='() => SetActiveTab("bans")'>
                    <i class="fas fa-gavel mr-1.5"></i>Ban History (@playerData.BanHistory.Count)
                </button>
                <button class="px-3 py-2 text-sm font-medium transition-colors whitespace-nowrap @(activeTab == "ip-history" ? "text-orange-400 border-b-2 border-orange-400" : "text-slate-400 hover:text-white")"
                        @onclick='() => SetActiveTab("ip-history")'>
                    <i class="fas fa-network-wired mr-1.5"></i>IP History (@playerData.IpHistory.Count)
                </button>
                <button class="px-3 py-2 text-sm font-medium transition-colors whitespace-nowrap @(activeTab == "notes" ? "text-orange-400 border-b-2 border-orange-400" : "text-slate-400 hover:text-white")"
                        @onclick='() => { SetActiveTab("notes"); LoadPlayerNotes(); }'>
                    <i class="fas fa-sticky-note mr-1.5"></i>Notes (@playerNotes.Count)
                </button>
                <button class="px-3 py-2 text-sm font-medium transition-colors whitespace-nowrap @(activeTab == "reports" ? "text-orange-400 border-b-2 border-orange-400" : "text-slate-400 hover:text-white")"
                        @onclick='() => { SetActiveTab("reports"); LoadPlayerReports(); }'>
                    <i class="fas fa-flag mr-1.5"></i>Reports (@playerReports.Count)
                </button>
                <button class="px-3 py-2 text-sm font-medium transition-colors whitespace-nowrap @(activeTab == "inventory" ? "text-orange-400 border-b-2 border-orange-400" : "text-slate-400 hover:text-white")"
                        @onclick='() => SetActiveTab("inventory")'>
                    <i class="fas fa-box-open mr-1.5"></i>Inventory
                </button>
            </div>
        </div>

        @* Tab Content *@

        @* Chat History *@
        @if (activeTab == "chat")
        {
            <div class="tw-card">
                <div class="tw-card-body">
                    @if (totalChatMessages == 0 && !isLoadingChat)
                    {
                        <p class="text-slate-500 text-sm text-center py-6">No chat messages found</p>
                    }
                    else
                    {
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
                            <span class="text-xs text-slate-500">
                                Showing @chatMessages.Count of @totalChatMessages messages
                                @if (hasMoreChat)
                                {
                                    <span> — click "Load More" below</span>
                                }
                            </span>
                            <div class="flex gap-2">
                                <input type="text"
                                       class="bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-1.5 text-white placeholder:text-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 w-56"
                                       @bind="searchQuery" @bind:event="oninput" placeholder="Search messages..." />
                                <button class="tw-btn-primary px-3 py-1.5 text-xs" @onclick="SearchChatMessages"
                                        disabled="@(string.IsNullOrWhiteSpace(searchQuery) || isSearching)">
                                    @if (isSearching)
                                    {
                                        <div class="tw-spinner w-3 h-3 mr-1"></div>
                                    }
                                    else
                                    {
                                        <i class="fas fa-search mr-1"></i>
                                    }
                                    Search
                                </button>
                            </div>
                        </div>
                        <div class="max-h-[500px] overflow-y-auto rounded-lg border border-slate-700/50">
                            <table class="w-full text-sm">
                                <thead class="sticky top-0 bg-slate-800/90 backdrop-blur z-10">
                                    <tr class="border-b border-slate-700/50">
                                        <th class="px-3 py-2 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400 w-44">Timestamp</th>
                                        <th class="px-3 py-2 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400 w-24">Channel</th>
                                        <th class="px-3 py-2 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Message</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var msg in chatMessages)
                                    {
                                        <tr class="border-b border-slate-700/30 hover:bg-slate-800/40">
                                            <td class="px-3 py-2"><span class="text-xs text-slate-500">@msg.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss")</span></td>
                                            <td class="px-3 py-2">
                                                @{
                                                    var (channelName, channelClass) = GetChannelInfo(msg.Channel);
                                                }
                                                <span class="@channelClass">@channelName</span>
                                            </td>
                                            <td class="px-3 py-2 text-slate-300">@msg.Message</td>
                                        </tr>
                                    }
                                    @if (isLoadingChat)
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center py-4">
                                                <div class="tw-spinner w-4 h-4 mx-auto mb-1"></div>
                                                <span class="text-xs text-slate-500">Loading more messages...</span>
                                            </td>
                                        </tr>
                                    }
                                    @if (hasMoreChat && !isLoadingChat)
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center py-3">
                                                <button class="tw-btn-ghost px-3 py-1.5 text-xs border border-slate-700" @onclick="LoadChatMessages">
                                                    <i class="fas fa-chevron-down mr-1.5"></i>Load More Messages
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        @* Kills Tab *@
        @if (activeTab == "kills")
        {
            <div class="tw-card">
                <div class="tw-card-body">
                    @if (isLoadingKills)
                    {
                        <div class="text-center py-6">
                            <div class="tw-spinner w-4 h-4 mx-auto mb-2"></div>
                            <span class="text-xs text-slate-500">Loading kills...</span>
                        </div>
                    }
                    else if (totalKills == 0)
                    {
                        <p class="text-slate-500 text-sm text-center py-6">No kills recorded</p>
                    }
                    else
                    {
                        <div class="flex justify-between items-center mb-3">
                            <span class="text-xs text-slate-500">
                                Showing @(killsPage * killsPageSize + 1)–@(Math.Min((killsPage + 1) * killsPageSize, totalKills)) of @totalKills kills
                            </span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-slate-700/50 bg-slate-800/20">
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Timestamp</th>
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Victim</th>
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Type</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var kill in killsList)
                                    {
                                        <tr class="border-b border-slate-700/30 hover:bg-slate-800/40">
                                            <td class="px-3 py-2.5"><span class="text-xs text-slate-500">@kill.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss")</span></td>
                                            <td class="px-3 py-2.5"><span class="text-sm font-medium text-white">@kill.VictimName</span></td>
                                            <td class="px-3 py-2.5">
                                                @if (kill.IsPVP)
                                                {
                                                    <span class="tw-badge-danger text-[10px]"><i class="fas fa-skull-crossbones mr-1"></i>PVP</span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-slate-500/20 text-slate-400">
                                                        <i class="fas fa-robot mr-1"></i>PVE
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (KillsTotalPages > 1)
                        {
                            <div class="flex items-center justify-center gap-2 mt-4">
                                <button class="tw-btn-ghost px-2.5 py-1.5 text-xs" disabled="@(killsPage == 0)" @onclick="() => KillsGoToPage(killsPage - 1)">
                                    <i class="fas fa-chevron-left"></i>
                                </button>
                                <span class="text-xs text-slate-400">Page @(killsPage + 1) of @KillsTotalPages</span>
                                <button class="tw-btn-ghost px-2.5 py-1.5 text-xs" disabled="@(killsPage >= KillsTotalPages - 1)" @onclick="() => KillsGoToPage(killsPage + 1)">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        }

