    /// <summary>
    /// Cancel note form
    /// </summary>
    private void CancelNoteForm()
    {
        showNoteForm = false;
        editingNoteId = null;
        newNoteText = "";
    }

    /// <summary>
    /// Save note (create or update)
    /// </summary>
    private async Task SaveNote()
    {
        if (string.IsNullOrWhiteSpace(newNoteText) || isSavingNote)
            return;

        try
        {
            isSavingNote = true;
            StateHasChanged();

            if (editingNoteId.HasValue)
            {
                // Update existing note
                var updateRequest = new UpdatePlayerNoteRequest
                {
                    NoteId = editingNoteId.Value,
                    Note = newNoteText
                };

                var response = await Http.PutAsJsonAsync($"api/PlayerNotes/{editingNoteId.Value}", updateRequest);
                if (response.IsSuccessStatusCode)
                {
                    var updatedNote = await response.Content.ReadFromJsonAsync<PlayerNoteDTO>();
                    if (updatedNote != null)
                    {
                        var index = playerNotes.FindIndex(n => n.Id == editingNoteId.Value);
                        if (index >= 0)
                        {
                            playerNotes[index] = updatedNote;
                        }
                    }
                }
            }
            else
            {
                // Create new note
                var createRequest = new CreatePlayerNoteRequest
                {
                    SteamId = SteamId,
                    ServerId = currentServerId,
                    Note = newNoteText
                };

                var response = await Http.PostAsJsonAsync("api/PlayerNotes", createRequest);
                if (response.IsSuccessStatusCode)
                {
                    var newNote = await response.Content.ReadFromJsonAsync<PlayerNoteDTO>();
                    if (newNote != null)
                    {
                        playerNotes.Insert(0, newNote);
                    }
                }
            }

            CancelNoteForm();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving note: {ex.Message}");
        }
        finally
        {
            isSavingNote = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Delete a note
    /// </summary>
    private async Task DeleteNote(int noteId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this note?"))
            return;

        try
        {
            var response = await Http.DeleteAsync($"api/PlayerNotes/{noteId}");
            if (response.IsSuccessStatusCode)
            {
                playerNotes.RemoveAll(n => n.Id == noteId);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting note: {ex.Message}");
        }
    }

