        @* Ban History Tab *@
        @if (activeTab == "bans")
        {
            <div class="space-y-4">
                @if (playerData.BanHistory.Count == 0)
                {
                    <div class="tw-card">
                        <div class="tw-card-body">
                            <p class="text-slate-500 text-sm text-center py-6">No ban history</p>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var ban in playerData.BanHistory)
                    {
                        <div class="rounded-xl border @(ban.IsActive ? "border-red-500/30 bg-red-500/5" : "border-emerald-500/30 bg-emerald-500/5")">
                            <div class="px-4 py-3 border-b @(ban.IsActive ? "border-red-500/30 bg-red-500/10" : "border-emerald-500/30 bg-emerald-500/10") rounded-t-xl">
                                <div class="flex justify-between items-center">
                                    <div class="flex items-center gap-2">
                                        <i class="fas fa-gavel @(ban.IsActive ? "text-red-400" : "text-emerald-400") text-sm"></i>
                                        <span class="text-sm font-semibold text-white">@ban.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span>
                                        @if (ban.IsGlobalBan)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-amber-500/20 text-amber-400">Global</span>
                                        }
                                    </div>
                                    <div>
                                        @if (ban.IsActive)
                                        {
                                            <span class="tw-badge-danger text-[10px]">Active</span>
                                        }
                                        else
                                        {
                                            <span class="tw-badge-success text-[10px]">Lifted</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="p-4">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div class="space-y-2">
                                        <h6 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                                            <i class="fas fa-info-circle mr-1"></i>Ban Details
                                        </h6>
                                        <div class="flex justify-between">
                                            <span class="text-sm text-slate-400">Reason</span>
                                            <span class="text-sm text-white">@ban.Reason</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-sm text-slate-400">Banned By</span>
                                            <span class="text-sm text-white">@(ban.BannedBy ?? "Unknown")</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-sm text-slate-400">Duration</span>
                                            <span class="text-sm text-white">
                                                @if (ban.DurationHours.HasValue && ban.DurationHours.Value > 0)
                                                {
                                                    if (ban.DurationHours.Value >= 24)
                                                    {
                                                        @((ban.DurationHours.Value / 24.0).ToString("F1"))
                                                        <span class="text-slate-500 text-xs"> days</span>
                                                    }
                                                    else
                                                    {
                                                        @ban.DurationHours
                                                        <span class="text-slate-500 text-xs"> hours</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-red-400">Permanent</span>
                                                }
                                            </span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-sm text-slate-400">Expires</span>
                                            <span class="text-sm text-white">
                                                @if (ban.ExpiryDate.HasValue)
                                                {
                                                    @ban.ExpiryDate.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                                                }
                                                else
                                                {
                                                    <span class="text-red-400">Never</span>
                                                }
                                            </span>
                                        </div>
                                    </div>
                                    <div>
                                        @if (!ban.IsActive)
                                        {
                                            <h6 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                                                <i class="fas fa-unlock mr-1"></i>Unban Details
                                            </h6>
                                            <div class="space-y-2">
                                                <div class="flex justify-between">
                                                    <span class="text-sm text-slate-400">Lifted By</span>
                                                    <span class="text-sm text-white">@(ban.LiftedBy ?? "Unknown")</span>
                                                </div>
                                                <div class="flex justify-between">
                                                    <span class="text-sm text-slate-400">Lifted At</span>
                                                    <span class="text-sm text-white">
                                                        @if (ban.LiftedAt.HasValue)
                                                        {
                                                            @ban.LiftedAt.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                                                        }
                                                        else
                                                        {
                                                            <span class="text-slate-500">Unknown</span>
                                                        }
                                                    </span>
                                                </div>
                                                <div class="flex justify-between">
                                                    <span class="text-sm text-slate-400">Lift Reason</span>
                                                    <span class="text-sm text-white">@(ban.LiftReason ?? "No reason provided")</span>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="rounded-lg bg-red-500/10 border border-red-500/30 p-3">
                                                <p class="text-sm font-semibold text-red-400"><i class="fas fa-exclamation-triangle mr-2"></i>This ban is currently active</p>
                                                @if (ban.ExpiryDate.HasValue)
                                                {
                                                    var timeUntilExpiry = ban.ExpiryDate.Value - DateTime.UtcNow;
                                                    @if (timeUntilExpiry.TotalHours > 24)
                                                    {
                                                        <p class="text-xs text-slate-400 mt-1">Expires in <span class="text-white font-medium">@timeUntilExpiry.Days day(s)</span></p>
                                                    }
                                                    else if (timeUntilExpiry.TotalHours > 0)
                                                    {
                                                        <p class="text-xs text-slate-400 mt-1">Expires in <span class="text-white font-medium">@timeUntilExpiry.Hours hour(s)</span></p>
                                                    }
                                                    else
                                                    {
                                                        <p class="text-xs text-amber-400 mt-1">Ban has expired (waiting for sync)</p>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @* IP History Tab *@
        @if (activeTab == "ip-history")
        {
            <div class="tw-card">
                <div class="tw-card-body">
                    @if (playerData.IpHistory.Count == 0)
                    {
                        <p class="text-slate-500 text-sm text-center py-6">No IP history available for this player</p>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-slate-700/50 bg-slate-800/20">
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">IP Address</th>
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Country</th>
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Type</th>
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">First Used</th>
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Last Used</th>
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Times Used</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ip in playerData.IpHistory)
                                    {
                                        <tr class="border-b border-slate-700/30 hover:bg-slate-800/40">
                                            <td class="px-3 py-2.5"><span class="font-mono text-xs text-slate-300">@ip.IpAddress</span></td>
                                            <td class="px-3 py-2.5">
                                                @if (!string.IsNullOrEmpty(ip.Country))
                                                {
                                                    var flagUrl = CountryFlagHelper.GetFlagImageUrl(ip.Country);
                                                    <div class="flex items-center gap-1.5">
                                                        @if (!string.IsNullOrEmpty(flagUrl))
                                                        { <img src="@flagUrl" alt="@ip.Country" title="@ip.Country" class="w-5 h-3.5 rounded-sm" /> }
                                                        <span class="text-xs text-slate-400">@ip.Country</span>
                                                    </div>
                                                }
                                                else
                                                { <span class="text-slate-600">-</span> }
                                            </td>
                                            <td class="px-3 py-2.5">
                                                @if (ip.IsVpn)
                                                { <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">VPN</span> }
                                                else
                                                { <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Residential</span> }
                                            </td>
                                            <td class="px-3 py-2.5"><span class="text-xs text-slate-500">@ip.FirstUsed.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span></td>
                                            <td class="px-3 py-2.5"><span class="text-xs text-slate-500">@ip.LastUsed.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span></td>
                                            <td class="px-3 py-2.5"><span class="font-mono text-xs text-slate-400">@ip.TimesUsed</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        @* Notes Tab *@
        @if (activeTab == "notes")
        {
            <div class="tw-card">
                <div class="tw-card-header">
                    <div class="flex items-center gap-2">
                        <i class="fas fa-sticky-note text-amber-400 text-sm"></i>
                        <span class="text-sm font-semibold text-white">Player Notes</span>
                    </div>
                    <button class="tw-btn-primary px-3 py-1.5 text-xs" @onclick="ShowAddNoteForm">
                        <i class="fas fa-plus mr-1"></i>Add Note
                    </button>
                </div>
                <div class="tw-card-body">
                    @if (isLoadingNotes)
                    {
                        <div class="text-center py-6">
                            <div class="tw-spinner mx-auto mb-2"></div>
                            <p class="text-slate-500 text-xs">Loading notes...</p>
                        </div>
                    }
                    else if (playerNotes.Count == 0)
                    {
                        <p class="text-slate-500 text-sm text-center py-6">No notes found for this player</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var note in playerNotes)
                            {
                                <div class="rounded-lg border border-slate-700/50 bg-slate-800/30 p-4">
                                    <div class="flex justify-between items-start mb-2">
                                        <div class="text-xs text-slate-500">
                                            <i class="fas fa-user mr-1"></i>@note.CreatedBy
                                            <i class="fas fa-clock ml-2 mr-1"></i>@note.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                                            @if (note.CreatedAt != note.UpdatedAt)
                                            {
                                                <span class="ml-2">(edited @note.UpdatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm"))</span>
                                            }
                                        </div>
                                        <div class="flex gap-1">
                                            <button class="h-7 w-7 flex items-center justify-center rounded text-slate-400 hover:text-blue-400 hover:bg-slate-700 transition-colors" @onclick="() => EditNote(note)">
                                                <i class="fas fa-edit text-xs"></i>
                                            </button>
                                            <button class="h-7 w-7 flex items-center justify-center rounded text-slate-400 hover:text-red-400 hover:bg-slate-700 transition-colors" @onclick="() => DeleteNote(note.Id)">
                                                <i class="fas fa-trash text-xs"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="text-sm text-slate-300 whitespace-pre-wrap break-words rounded bg-slate-900/50 border border-slate-700/30 p-3">
                                        @note.Note
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (showNoteForm)
                    {
                        <div class="rounded-lg border border-orange-500/30 bg-slate-800/30 p-4 mt-4">
                            <p class="text-sm font-semibold text-white mb-3">@(editingNoteId.HasValue ? "Edit Note" : "Add New Note")</p>
                            <textarea class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white placeholder:text-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 mb-3"
                                      rows="5" @bind="newNoteText" placeholder="Enter your note here..."></textarea>
                            <div class="flex gap-2">
                                <button class="tw-btn-primary px-3 py-1.5 text-sm" @onclick="SaveNote" disabled="@(string.IsNullOrWhiteSpace(newNoteText) || isSavingNote)">
                                    @if (isSavingNote)
                                    {
                                        <div class="tw-spinner w-3 h-3 mr-2"></div>
                                    }
                                    <i class="fas fa-save mr-1"></i>Save
                                </button>
                                <button class="tw-btn-ghost px-3 py-1.5 text-sm" @onclick="CancelNoteForm">
                                    <i class="fas fa-times mr-1"></i>Cancel
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* Reports Tab *@
        @if (activeTab == "reports")
        {
            <div class="tw-card">
                <div class="tw-card-body">
                    @if (isLoadingReports)
                    {
                        <div class="text-center py-6">
                            <div class="tw-spinner mx-auto mb-2"></div>
                            <p class="text-slate-500 text-xs">Loading reports...</p>
                        </div>
                    }
                    else if (playerReports.Count == 0)
                    {
                        <p class="text-slate-500 text-sm text-center py-6">No reports found for this player</p>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-slate-700/50 bg-slate-800/20">
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Reported At</th>
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Reporter</th>
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Type</th>
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Subject</th>
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Status</th>
                                        <th class="px-3 py-2.5 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-400">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var report in playerReports)
                                    {
                                        <tr class="border-b border-slate-700/30 hover:bg-slate-800/40 @(report.IsArchived ? "opacity-50" : "")">
                                            <td class="px-3 py-2.5"><span class="text-xs text-slate-500">@report.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span></td>
                                            <td class="px-3 py-2.5">
                                                <div class="text-sm font-medium text-white">@report.ReporterName</div>
                                                <div class="text-xs text-slate-500 font-mono">@report.ReporterId</div>
                                            </td>
                                            <td class="px-3 py-2.5">
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-slate-500/20 text-slate-400">@report.Type</span>
                                            </td>
                                            <td class="px-3 py-2.5">
                                                <div class="text-sm text-slate-300 max-w-[250px] truncate">@report.Subject</div>
                                                @if (!string.IsNullOrWhiteSpace(report.Message))
                                                {
                                                    <div class="text-xs text-slate-500 max-w-[250px] truncate">@report.Message</div>
                                                }
                                            </td>
                                            <td class="px-3 py-2.5">
                                                @{
                                                    var statusClass = report.Status switch
                                                    {
                                                        "Pending" => "bg-amber-500/20 text-amber-400",
                                                        "Reviewed" => "bg-emerald-500/20 text-emerald-400",
                                                        "Dismissed" => "bg-slate-500/20 text-slate-400",
                                                        "Actioned" => "bg-blue-500/20 text-blue-400",
                                                        _ => "bg-blue-500/20 text-blue-400"
                                                    };
                                                }
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium @statusClass">@report.Status</span>
                                                @if (report.IsArchived)
                                                {
                                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-medium bg-slate-500/20 text-slate-500 mt-1 block">Archived</span>
                                                }
                                            </td>
                                            <td class="px-3 py-2.5">
                                                <div class="flex gap-1">
                                                    <button class="h-7 w-7 flex items-center justify-center rounded text-slate-400 hover:text-blue-400 hover:bg-slate-700 transition-colors" @onclick="() => ViewReport(report)">
                                                        <i class="fas fa-eye text-xs"></i>
                                                    </button>
                                                    <button class="h-7 w-7 flex items-center justify-center rounded text-slate-400 hover:text-red-400 hover:bg-slate-700 transition-colors" @onclick="() => DeleteReport(report)">
