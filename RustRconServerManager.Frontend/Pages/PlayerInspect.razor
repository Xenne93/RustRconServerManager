            var response = await Http.GetFromJsonAsync<ChatSearchResponse>(
                $"/api/PlayerInspect/{SteamId}/chat/search?serverId={currentServerId}&query={Uri.EscapeDataString(searchQuery)}&take=100");

            if (response != null)
            {
                searchResults = response.Messages;
                showSearchModal = true;
            }
        }
        catch (Exception ex)
        {
