    /// <summary>
    /// Save report changes
    /// </summary>
    private async Task SaveReport()
    {
        if (selectedReport == null)
            return;

        try
        {
            var updateRequest = new
            {
                Status = editReportStatus,
                AdminNotes = editReportAdminNotes,
                IsArchived = editReportIsArchived
            };

            var response = await Http.PutAsJsonAsync($"api/Dashboard/UpdateReport/{selectedReport.Id}", updateRequest);

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine($"Report updated successfully");
                CloseReportModal();
                await LoadPlayerReports();
            }
            else
            {
                Console.WriteLine($"Failed to update report");
                await JSRuntime.InvokeVoidAsync("alert", "Failed to update report");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating report: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "Error updating report");
        }
    }

    /// <summary>
    /// Delete a report
    /// </summary>
    private async Task DeleteReport(PlayerReportDto report)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete this report?"))
            return;

        try
        {
            var response = await Http.DeleteAsync($"api/Dashboard/DeleteReport/{report.Id}");

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine($"Report deleted successfully");
                await LoadPlayerReports();
            }
            else
            {
                Console.WriteLine($"Failed to delete report");
                await JSRuntime.InvokeVoidAsync("alert", "Failed to delete report");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting report: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "Error deleting report");
        }
    }
