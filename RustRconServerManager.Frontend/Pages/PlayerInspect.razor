    protected override async Task OnInitializedAsync()
    {
        bool hasAccess = await ServerValidationHelper.ValidateActiveServerAsync();
        if (!hasAccess)
            return;

        await LoadPlayerData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check if we need to activate a specific tab from query string
            var uri = new Uri(Nav.Uri);
            var queryString = uri.Query;

            if (!string.IsNullOrEmpty(queryString) && queryString.Contains("tab="))
            {
                var tabMatch = System.Text.RegularExpressions.Regex.Match(queryString, @"tab=([^&]+)");
                if (tabMatch.Success)
                {
                    activeTab = tabMatch.Groups[1].Value;
                    StateHasChanged();
                }
            }
        }
    }

    private async Task SetActiveTab(string tab)
    {
        activeTab = tab;
        if (tab == "kills" && !killsLoaded)
            await LoadKills();
        else if (tab == "deaths" && !deathsLoaded)
            await LoadDeaths();
    }

    private async Task LoadPlayerInventory()
    {
        isLoadingInventory = true;
        inventoryError = null;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync($"/api/PlayerInspect/{SteamId}/inventory");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                inventoryData = System.Text.Json.JsonSerializer.Deserialize<PlayerInventoryData>(json, new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                inventoryError = string.IsNullOrEmpty(error) ? "Failed to retrieve inventory." : error.Trim('"');
            }
        }
        catch (Exception ex)
        {
            inventoryError = $"Error: {ex.Message}";
        }
        finally
        {
            isLoadingInventory = false;
            StateHasChanged();
        }
    }

    private async Task LoadPlayerData()
    {
        try
        {
            isLoading = true;
            currentServerId = await LocalStorage.GetItemAsync<int>("activeServerId");

            playerData = await Http.GetFromJsonAsync<PlayerInspect_ResponseDTO>($"/api/PlayerInspect/{SteamId}?serverId={currentServerId}");

            // Load initial chat messages
            if (playerData != null)
            {
                await LoadChatMessages();
                // Load player reports count
                await LoadPlayerReportsCount();
                // Load player notes count
                await LoadPlayerNotes();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading player data: {ex.Message}");
            playerData = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadChatMessages()
    {
        if (isLoadingChat || string.IsNullOrEmpty(SteamId))
            return;

        try
        {
            isLoadingChat = true;
            var response = await Http.GetFromJsonAsync<ChatMessagesResponse>(
                $"/api/PlayerInspect/{SteamId}/chat?serverId={currentServerId}&skip={chatSkip}&take={chatTake}");

            if (response != null)
            {
                chatMessages.AddRange(response.Messages);
                totalChatMessages = response.TotalCount;
                hasMoreChat = response.HasMore;
                chatSkip += chatTake;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading chat messages: {ex.Message}");
        }
        finally
        {
            isLoadingChat = false;
        }
    }

    private async Task SearchChatMessages()
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || isSearching)
