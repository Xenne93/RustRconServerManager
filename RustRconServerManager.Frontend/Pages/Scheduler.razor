@page "/Scheduler"
@using Microsoft.AspNetCore.Authorization
@using Blazored.LocalStorage
@using Blazored.SessionStorage
@using RustRconServerManager.Frontend.Components.Layout
@using RustRconServerManager.Frontend.Components.Scheduler
@using RustRconServerManager.Shared.Scheduler
@using System.Net.Http.Json
@using System.Text.Json
@using RustRconServerManager.Frontend.Services
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject ISessionStorageService SessionStorage
@inject NavigationManager Nav
@inject NavigationHelper NavHelper
@inject IJSRuntime JSRuntime
@inject ServerValidationHelper ServerValidationHelper
@implements IAsyncDisposable

@attribute [Authorize]

<ContentWrapper>
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
        <h3 class="text-xl font-semibold text-white">Command Scheduler</h3>
        <button class="bg-orange-500 hover:bg-orange-600 text-white font-medium py-2 px-4 rounded-lg transition-colors" @onclick="OpenCreateForm">
            <i class="fas fa-plus mr-2"></i>New Schedule
        </button>
    </div>

    <div class="flex items-start gap-3 rounded-lg bg-blue-500/5 border border-blue-500/20 px-4 py-3 mb-6">
        <i class="fas fa-circle-info text-blue-400 mt-0.5"></i>
        <p class="text-sm text-slate-300">Automate your server management by scheduling RCON commands to run at specific times or intervals. Set up recurring restarts, broadcast messages, trigger wipes, or any other command — the scheduler handles it for you.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">
        <div class="lg:col-span-8">
            <TwCard HeaderTitle="Schedule Types" HeaderIcon="fas fa-info-circle">
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                    <div class="flex items-start gap-3 p-3 rounded-lg bg-slate-800/40 border border-slate-700/30">
                        <div class="p-2 rounded-lg bg-orange-500/10 text-orange-400 shrink-0">
                            <i class="fas fa-clock text-sm"></i>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-white">One-Time</p>
                            <p class="text-xs text-slate-500">Run once at a specific date and time</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-3 rounded-lg bg-slate-800/40 border border-slate-700/30">
                        <div class="p-2 rounded-lg bg-blue-500/10 text-blue-400 shrink-0">
                            <i class="fas fa-stopwatch text-sm"></i>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-white">Minutes</p>
                            <p class="text-xs text-slate-500">Repeat every X minutes</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-3 rounded-lg bg-slate-800/40 border border-slate-700/30">
                        <div class="p-2 rounded-lg bg-emerald-500/10 text-emerald-400 shrink-0">
                            <i class="fas fa-hourglass-half text-sm"></i>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-white">Hourly</p>
                            <p class="text-xs text-slate-500">Repeat every X hours</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-3 rounded-lg bg-slate-800/40 border border-slate-700/30">
                        <div class="p-2 rounded-lg bg-amber-500/10 text-amber-400 shrink-0">
                            <i class="fas fa-sun text-sm"></i>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-white">Daily</p>
                            <p class="text-xs text-slate-500">Same time every day</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-3 rounded-lg bg-slate-800/40 border border-slate-700/30">
                        <div class="p-2 rounded-lg bg-purple-500/10 text-purple-400 shrink-0">
                            <i class="fas fa-calendar-week text-sm"></i>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-white">Weekly</p>
                            <p class="text-xs text-slate-500">Pick days and time</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-3 rounded-lg bg-slate-800/40 border border-slate-700/30">
                        <div class="p-2 rounded-lg bg-rose-500/10 text-rose-400 shrink-0">
                            <i class="fas fa-calendar-alt text-sm"></i>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-white">Monthly</p>
                            <p class="text-xs text-slate-500">Specific day each month</p>
                        </div>
                    </div>
                </div>
            </TwCard>
        </div>
        <div class="lg:col-span-4">
            <TwCard HeaderTitle="Server Clock" HeaderIcon="fas fa-clock">
                <div class="text-center mb-4">
                    <p class="text-3xl font-bold text-orange-400 tracking-tight font-mono">@CurrentLocalTime.ToLocalTime().ToString("HH:mm:ss")</p>
                    <p class="text-xs text-slate-500 mt-1">Your Local Time</p>
                </div>
                <div class="grid grid-cols-2 gap-3 mb-4">
                    <div class="p-2.5 rounded-lg bg-slate-800/50 border border-slate-700/30 text-center">
                        <p class="text-sm font-semibold text-slate-300 font-mono">@CurrentUtcTime.ToString("HH:mm:ss")</p>
                        <p class="text-[10px] uppercase tracking-wider text-slate-500 mt-0.5">UTC</p>
                    </div>
                    <div class="p-2.5 rounded-lg bg-slate-800/50 border border-slate-700/30 text-center">
                        <p class="text-sm font-semibold text-slate-300 truncate" title="@userTimeZoneName">@userUtcOffset</p>
                        <p class="text-[10px] uppercase tracking-wider text-slate-500 mt-0.5">Timezone</p>
                    </div>
                </div>
            </TwCard>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="rounded-lg bg-blue-500/10 border border-blue-500/30 text-blue-400 px-4 py-3 text-sm">
            <i class="fas fa-spinner fa-spin mr-2"></i>Loading schedules...
        </div>
    }
    else if (ScheduledCommands.Count == 0)
    {
        <TwCard HeaderTitle="Server Command Scheduler">
            <div class="text-center py-8">
                <i class="fas fa-calendar-alt text-4xl text-slate-600 mb-4"></i>
                <p class="text-slate-400 mb-4">No scheduled commands yet.</p>
                <button class="bg-orange-500 hover:bg-orange-600 text-white font-medium py-2 px-4 rounded-lg transition-colors" @onclick="OpenCreateForm">
                    <i class="fas fa-plus mr-2"></i>Create Schedule
                </button>
            </div>
        </TwCard>
    }
    else
    {
        <TwCard HeaderTitle="Server Command Scheduler" NoPadding="true">
            <div class="overflow-x-auto">
                <table class="tw-table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Active</th>
                            <th>Name</th>
                            <th>Schedule</th>
                            <th>Next Execution</th>
                            <th>Last Execution</th>
                            <th style="width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cmd in ScheduledCommands)
                        {
                            <tr>
                                <td>
                                    <label class="relative inline-flex items-center cursor-pointer">
                                        <input type="checkbox" checked="@cmd.IsActive" @onchange="@((ChangeEventArgs e) => ToggleActive(cmd, (bool)e.Value))" class="sr-only peer" />
                                        <div class="w-9 h-5 bg-slate-600 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-500"></div>
                                    </label>
                                </td>
                                <td>
                                    <div class="font-semibold">@cmd.Name</div>
                                    <small class="text-slate-400">@cmd.Command</small>
                                    @if (!string.IsNullOrEmpty(cmd.Description))
                                    {
                                        <div class="text-sm text-slate-400">@cmd.Description</div>
                                    }
                                </td>
                                <td>
                                    <TwBadge Variant="info">@GetScheduleTypeLabel(cmd.ScheduleTypeValue)</TwBadge>
                                    <br />
                                    <small class="text-slate-400">@cmd.GetScheduleDescription()</small>
                                </td>
                                <td>
                                    @if (cmd.NextExecutionAt.HasValue)
                                    {
                                        <span>@cmd.NextExecutionAt.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">—</span>
                                    }
                                </td>
                                <td>
                                    @if (cmd.LastExecutedAt.HasValue)
                                    {
                                        <span>@cmd.LastExecutedAt.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span>
                                        <br />
                                        @if (cmd.LastExecutionSuccess == true)
                                        {
                                            <small class="text-emerald-400"><i class="fas fa-check"></i> Success</small>
                                        }
                                        else if (cmd.LastExecutionSuccess == false)
                                        {
                                            <small class="text-red-400"><i class="fas fa-exclamation"></i> Failed</small>
                                            @if (!string.IsNullOrEmpty(cmd.LastExecutionError))
                                            {
                                                <div class="text-sm text-red-400" title="@cmd.LastExecutionError">@cmd.LastExecutionError.Substring(0, Math.Min(50, cmd.LastExecutionError.Length))</div>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="flex items-center gap-1">
                                        <button class="px-2 py-1 text-xs bg-emerald-500/20 text-emerald-400 hover:bg-emerald-500/30 rounded transition-colors" @onclick="@(() => ExecuteNow(cmd.Id))" title="Execute immediately">
                                            <i class="fas fa-play"></i>
                                        </button>
                                        <button class="px-2 py-1 text-xs bg-blue-500/20 text-blue-400 hover:bg-blue-500/30 rounded transition-colors" @onclick="@(async () => await EditSchedule(cmd))">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="px-2 py-1 text-xs bg-red-500/20 text-red-400 hover:bg-red-500/30 rounded transition-colors" @onclick="@(() => DeleteSchedule(cmd.Id))">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </TwCard>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 text-sm mt-4">
            <strong>Error:</strong> @ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-4 py-3 text-sm mt-4">
            <strong>Success:</strong> @SuccessMessage
        </div>
    }
</ContentWrapper>

<ScheduleForm @ref="ScheduleFormComponent" ServerId="@SelectedServerId" OnSaved="RefreshSchedules" />

@code {
    private List<ScheduledCommandDto> ScheduledCommands { get; set; } = new();
    private ScheduleForm ScheduleFormComponent { get; set; }
    private int SelectedServerId { get; set; } = 0;
    private bool IsLoading { get; set; } = false;
    private string ErrorMessage { get; set; } = "";
    private string SuccessMessage { get; set; } = "";
    private DateTime CurrentUtcTime { get; set; } = DateTime.UtcNow;
    private DateTime CurrentLocalTime { get; set; } = DateTime.UtcNow;
    private string userTimeZoneName = "Detecting...";
    private string userUtcOffset = "";
    private bool userIsDst = false;
    private System.Timers.Timer _clockTimer { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Validate server access
            bool hasAccess = await ServerValidationHelper.ValidateActiveServerAsync();
            if (!hasAccess)
                return;

            // Get selected server ID (already validated)
            SelectedServerId = await ServerValidationHelper.GetActiveServerIdAsync();

            // Start clock update timer
            _clockTimer = new System.Timers.Timer(1000); // Update every second
            _clockTimer.Elapsed += (s, e) => UpdateCurrentTime();
            _clockTimer.AutoReset = true;
            _clockTimer.Start();

            UpdateCurrentTime();
            await LoadSchedules();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error initializing: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                userTimeZoneName = await JSRuntime.InvokeAsync<string>("eval", "Intl.DateTimeFormat().resolvedOptions().timeZone");
                var offsetMinutes = await JSRuntime.InvokeAsync<int>("eval", "new Date().getTimezoneOffset()");
                var offsetHours = -offsetMinutes / 60.0;
                userUtcOffset = $"UTC{(offsetHours >= 0 ? "+" : "")}{offsetHours:0.##}";
                userIsDst = await JSRuntime.InvokeAsync<bool>("eval",
                    @"(function() {
                        var jan = new Date(new Date().getFullYear(), 0, 1).getTimezoneOffset();
                        var jul = new Date(new Date().getFullYear(), 6, 1).getTimezoneOffset();
                        var stdOffset = Math.max(jan, jul);
                        return new Date().getTimezoneOffset() < stdOffset;
                    })()");
                StateHasChanged();
            }
            catch
            {
                userTimeZoneName = "Unknown";
                userUtcOffset = "UTC+0";
                userIsDst = false;
            }
        }
    }

    private async Task LoadSchedules()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = "";
            System.Console.WriteLine($"[Scheduler.LoadSchedules] Fetching schedules for server {SelectedServerId}");
            var response = await Http.GetAsync($"/api/scheduler/server/{SelectedServerId}");

            System.Console.WriteLine($"[Scheduler.LoadSchedules] Response Status: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                System.Console.WriteLine($"[Scheduler.LoadSchedules] Response Content: {content}");
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                ScheduledCommands = JsonSerializer.Deserialize<List<ScheduledCommandDto>>(content, options) ?? new();
                System.Console.WriteLine($"[Scheduler.LoadSchedules] Deserialized {ScheduledCommands.Count} schedules");
                StateHasChanged();
            }
            else
            {
                ErrorMessage = "Failed to load schedules";
                System.Console.WriteLine($"[Scheduler.LoadSchedules] Failed with status {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading schedules: {ex.Message}";
            System.Console.WriteLine($"[Scheduler.LoadSchedules] Exception: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OpenCreateForm()
    {
        if (ScheduleFormComponent != null)
        {
            await ScheduleFormComponent.ResetFormAsync();
        }
    }

    private async Task EditSchedule(ScheduledCommandDto cmd)
    {
        if (ScheduleFormComponent != null)
        {
            await ScheduleFormComponent.ResetFormAsync(cmd);
        }
    }

    private async Task ExecuteNow(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Execute this command now?"))
        {
            try
            {
                var response = await Http.PostAsJsonAsync($"/api/scheduler/{id}/execute-now", new { });

                if (response.IsSuccessStatusCode)
                {
                    SuccessMessage = "Command executed successfully";
                    await RefreshSchedules();
                }
                else
                {
                    var content = await response.Content.ReadAsStringAsync();
                    ErrorMessage = $"Failed to execute command: {content}";
                }
            }
            catch (Exception ex)
            {
                ErrorMessage = $"Error executing: {ex.Message}";
            }
        }
    }

    private async Task DeleteSchedule(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this scheduled command?"))
        {
            try
            {
                var response = await Http.DeleteAsync($"/api/scheduler/{id}");

                if (response.IsSuccessStatusCode)
                {
                    SuccessMessage = "Scheduled command deleted successfully";
                    await RefreshSchedules();
                }
                else
                {
                    ErrorMessage = "Failed to delete scheduled command";
                }
            }
            catch (Exception ex)
            {
                ErrorMessage = $"Error deleting: {ex.Message}";
            }
        }
    }

    private async Task ToggleActive(ScheduledCommandDto cmd, bool isActive)
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"/api/scheduler/{cmd.Id}/toggle-active", new { });

            if (response.IsSuccessStatusCode)
            {
                await RefreshSchedules();
            }
            else
            {
                ErrorMessage = "Failed to toggle schedule";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error toggling: {ex.Message}";
        }
    }

    private async Task RefreshSchedules()
    {
        System.Console.WriteLine($"[Scheduler] RefreshSchedules called. SelectedServerId={SelectedServerId}");
        await LoadSchedules();
        SuccessMessage = "Scheduled command saved successfully";
        System.Console.WriteLine($"[Scheduler] LoadSchedules completed. Loaded {ScheduledCommands.Count} schedules");
        // Clear success message after 5 seconds
        _ = Task.Delay(5000).ContinueWith(_ => { SuccessMessage = ""; StateHasChanged(); });
    }

    private string GetScheduleTypeLabel(int scheduleType)
    {
        return scheduleType switch
        {
            0 => "One-Time",
            5 => "Minutes",
            1 => "Hourly",
            2 => "Daily",
            3 => "Weekly",
            4 => "Monthly",
            _ => "Unknown"
        };
    }

    private void UpdateCurrentTime()
    {
        CurrentUtcTime = DateTime.UtcNow;
        CurrentLocalTime = DateTime.UtcNow;
        StateHasChanged();
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        _clockTimer?.Dispose();
        await Task.CompletedTask;
    }
}
