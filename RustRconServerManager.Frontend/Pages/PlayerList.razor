    /// <summary>
    /// Filters players based on search term
    /// </summary>
    private List<PlayerList_PlayerDTO> FilterPlayers(List<PlayerList_PlayerDTO> players)
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
            return players;

        var term = searchTerm.ToLower();
        return players.Where(p =>
            (p.Name ?? "").ToLower().Contains(term) ||
            (p.SteamId ?? "").ToLower().Contains(term) ||
            (p.Country ?? "").ToLower().Contains(term) ||
            (p.LastIp ?? "").ToLower().Contains(term)
        ).ToList();
    }

    /// <summary>
    /// Sorts players based on current sort column and direction
    /// </summary>
    private List<PlayerList_PlayerDTO> SortPlayers(List<PlayerList_PlayerDTO> players)
    {
        var sorted = sortColumn switch
        {
            "Name" => players.OrderBy(p => p.Name ?? ""),
            "SteamID" => players.OrderBy(p => p.SteamId ?? ""),
            "Ping" => players.OrderBy(p => p.CurrentPing ?? int.MaxValue),
            "Health" => players.OrderBy(p => p.Health ?? double.MinValue),
            "Country" => players.OrderBy(p => p.Country ?? ""),
            "SteamAge" => players.OrderBy(p => p.SteamAccountCreated ?? DateTime.MinValue),
            "RustHours" => players.OrderBy(p => p.RustPlaytimeMinutes ?? int.MinValue),
            "IP" => players.OrderBy(p => p.LastIp ?? ""),
            "FirstSeen" => players.OrderBy(p => p.FirstSeen),
            "LastSeen" => players.OrderBy(p => p.LastSeen),
            _ => players.OrderBy(p => p.Name ?? "")
        };

        return sortAscending ? sorted.ToList() : sorted.Reverse().ToList();
    }

    /// <summary>
    /// Handles column header click for sorting
    /// </summary>
    private void OnColumnHeaderClick(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    /// <summary>
    /// Gets sort icon markup for a column
    /// </summary>
    private MarkupString GetSortIcon(string column)
    {
        if (sortColumn != column)
            return new MarkupString("");

        return sortAscending
            ? new MarkupString("<i class=\"fas fa-chevron-up text-[10px] text-orange-400\"></i>")
            : new MarkupString("<i class=\"fas fa-chevron-down text-[10px] text-orange-400\"></i>");
    }

    /// <summary>
    /// Calculates total ban duration in hours
    /// </summary>
    private long GetTotalBanHours()
    {
        long totalHours = banDurationHours;
        totalHours += (long)banDurationDays * 24;
        totalHours += (long)banDurationWeeks * 24 * 7;
        totalHours += (long)banDurationMonths * 24 * 30;
        totalHours += (long)banDurationYears * 24 * 365;
        return totalHours;
    }

