    /// <summary>
    /// Executes the ban action
    /// </summary>
    private async Task ExecuteBan()
    {
        if (selectedPlayerForBan == null)
            return;

        try
        {
            int serverId = await LocalStorage.GetItemAsync<int>("activeServerId");

            var banData = new
            {
                SteamId = selectedPlayerForBan.SteamId,
                PlayerName = selectedPlayerForBan.Name,
                Reason = banReason,
                DurationHours = GetTotalBanHours(),
                IsGlobalBan = isGlobalBan,
                ServerId = serverId,
                InternalNote = string.IsNullOrWhiteSpace(banInternalNote) ? (string?)null : banInternalNote
            };

            var response = await Http.PostAsJsonAsync("/api/dashboard/ban-player", banData);

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine($"Player {selectedPlayerForBan.Name} has been banned");
                await CancelBan();

                await Task.Delay(1000);
                await FetchPlayerData();
            }
            else
            {
                Console.WriteLine($"Failed to ban player {selectedPlayerForBan.Name}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error banning player: {ex.Message}");
        }
    }

