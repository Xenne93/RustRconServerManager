    protected override async Task OnInitializedAsync()
    {
        bool hasAccess = await ServerValidationHelper.ValidateActiveServerAsync();
        if (!hasAccess)
            return;

        _ = TickLoop();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FetchPlayerData();
        }
        await Task.CompletedTask;
    }

    private async Task TickLoop()
    {
        try
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                await FetchPlayerData();
            }
        }
        catch (OperationCanceledException)
        {
            // Ignored: we cancel on dispose
        }
    }

    private async Task FetchPlayerData()
    {
        try
        {
            int serverId = await LocalStorage.GetItemAsync<int>("activeServerId");

            var url = $"/api/Dashboard/GetPlayerList/{serverId}?offlinePage={offlinePage}&offlinePageSize={pageSize}";
            if (!string.IsNullOrWhiteSpace(searchTerm))
                url += $"&search={Uri.EscapeDataString(searchTerm)}";

            var result = await Http.GetFromJsonAsync<PlayerList_PlayerListDTO>(url);
            if (result != null)
            {
                playerListData = result;

                // If server clamped or data shrunk below current page, step back
                var totalPages = Math.Max(1, (int)Math.Ceiling((double)playerListData.OfflineFilteredTotal / playerListData.OfflinePageSize));
                if (offlinePage > totalPages)
                {
                    offlinePage = totalPages;
                    _ = FetchPlayerData();
                    return;
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching player data: {ex.Message}");
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        offlinePage = 1;

        _searchDebounceCts?.Cancel();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        try
        {
            await Task.Delay(300, token);
            if (!token.IsCancellationRequested)
                await FetchPlayerData();
        }
        catch (TaskCanceledException)
        {
            // Newer keystroke superseded this one
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && (size == 100 || size == 200 || size == 500))
        {
            pageSize = size;
            offlinePage = 1;
            await FetchPlayerData();
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1) page = 1;
        if (page == offlinePage) return;
        offlinePage = page;
        await FetchPlayerData();
    }

