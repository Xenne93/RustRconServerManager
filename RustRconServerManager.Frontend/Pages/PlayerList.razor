            <div>
                <label class="block text-sm font-medium text-slate-300 mb-1">Kick Reason</label>
                <textarea class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white placeholder:text-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                          rows="3" @bind="kickReason" placeholder="Enter reason for kick (optional)..."></textarea>
            </div>
        }
    </ChildContent>
    <FooterContent>
