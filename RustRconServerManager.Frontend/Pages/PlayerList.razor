    /// <summary>
    /// Loads all notes for the selected player
    /// </summary>
    private async Task LoadPlayerNotes()
    {
        if (selectedPlayerForNotes == null) return;

        isLoadingNotes = true;
        StateHasChanged();

        try
        {
            int serverId = await LocalStorage.GetItemAsync<int>("activeServerId");

            var response = await Http.GetAsync($"/api/PlayerNotes/{selectedPlayerForNotes.SteamId}?serverId={serverId}");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PlayerNotesResponseDTO>();
                if (result != null)
                {
                    playerNotes = result.Notes;
                }
            }
            else
            {
                Console.WriteLine($"Error loading notes: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading notes: {ex.Message}");
        }
        finally
        {
            isLoadingNotes = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Saves a new or updated note
    /// </summary>
    private async Task SaveNote()
    {
        if (selectedPlayerForNotes == null || string.IsNullOrWhiteSpace(newNoteText)) return;

        isSavingNote = true;
        StateHasChanged();

        try
        {
            int serverId = await LocalStorage.GetItemAsync<int>("activeServerId");

            if (editingNoteId.HasValue)
            {
                var updateRequest = new UpdatePlayerNoteRequest
                {
                    NoteId = editingNoteId.Value,
                    Note = newNoteText
                };

                var response = await Http.PutAsJsonAsync($"/api/PlayerNotes/{editingNoteId.Value}", updateRequest);

                if (response.IsSuccessStatusCode)
                {
                    await LoadPlayerNotes();
                    showNoteForm = false;
                    newNoteText = "";
                    editingNoteId = null;
                }
            }
            else
            {
                var createRequest = new CreatePlayerNoteRequest
                {
                    SteamId = selectedPlayerForNotes.SteamId,
                    ServerId = serverId,
                    Note = newNoteText
                };

                var response = await Http.PostAsJsonAsync("/api/PlayerNotes", createRequest);

                if (response.IsSuccessStatusCode)
                {
                    await LoadPlayerNotes();
                    showNoteForm = false;
                    newNoteText = "";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving note: {ex.Message}");
        }
        finally
        {
            isSavingNote = false;
            StateHasChanged();
        }
    }

