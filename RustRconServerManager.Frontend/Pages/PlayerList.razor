    private async Task ExecutePlayerAction(string actionName, string rconCommand, string playerName)
    {
        try
        {
            int serverId = await LocalStorage.GetItemAsync<int>("activeServerId");

            Console.WriteLine($"[DEBUG] Executing action '{actionName}' with command: {rconCommand}");
            Console.WriteLine($"[DEBUG] ServerId: {serverId}");

            Console.WriteLine($"[DEBUG] Sending request to /api/Rcon/SendCustomCommand");

            var response = await Http.PostAsJsonAsync("/api/Rcon/SendCustomCommand", new { Command = rconCommand });

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine($"Player action '{actionName}' executed successfully for {playerName}");
                StateHasChanged();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Failed to execute action '{actionName}' for player {playerName}. Status: {response.StatusCode}. Response: {content}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error executing player action '{actionName}': {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }

