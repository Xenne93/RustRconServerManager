    private string GetSteamAge(DateTime created)
    {
        var age = DateTime.UtcNow - created;
        if (age.TotalDays >= 365)
            return $"{(int)(age.TotalDays / 365)}y";
        if (age.TotalDays >= 30)
            return $"{(int)(age.TotalDays / 30)}mo";
        return $"{(int)age.TotalDays}d";
    }

