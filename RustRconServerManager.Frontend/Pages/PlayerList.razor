@page "/players"
@page "/PlayerList"
@using Microsoft.AspNetCore.Authorization
@using Blazored.LocalStorage
@using Blazored.SessionStorage
@using RustRconServerManager.Frontend.Components.Layout
@using RustRconServerManager.Frontend.Components.Auth
@using RustRconServerManager.Frontend.Components
@using RustRconServerManager.Frontend.Components.UI
@using RustRconServerManager.Frontend.Utilities
@using RustRconServerManager.Shared.PlayerList
@using RustRconServerManager.Shared.PlayerNotes
@using RustRconServerManager.Frontend.Services
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject ISessionStorageService SessionStorage
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ServerValidationHelper ServerValidationHelper
@implements IAsyncDisposable

@attribute [Authorize]
<PageAccessGuard PageRoute="players">

<ContentWrapper>
    @* Header *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-white">Player List</h1>
            @if (playerListData != null)
            {
                <p class="text-slate-400 text-sm mt-1">
                    @(playerListData.TotalOnline + playerListData.TotalOffline) total players
                    &bull; @playerListData.TotalOnline online
                    &bull; @playerListData.TotalBanned banned
                </p>
            }
        </div>
    </div>

    @* Quick Stats *@
    @if (playerListData != null)
    {
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
            <div class="rounded-lg border border-slate-700/50 bg-slate-800/30 p-4">
                <p class="text-xs text-slate-400 uppercase tracking-wider">Total Players</p>
                <p class="text-2xl font-bold text-white mt-1">@(playerListData.TotalOnline + playerListData.TotalOffline)</p>
            </div>
            <div class="rounded-lg border border-emerald-500/30 bg-emerald-500/10 p-4">
                <p class="text-xs text-emerald-400 uppercase tracking-wider">Online Now</p>
                <p class="text-2xl font-bold text-emerald-400 mt-1">@playerListData.TotalOnline</p>
            </div>
            <div class="rounded-lg border border-slate-500/30 bg-slate-500/10 p-4">
                <p class="text-xs text-slate-400 uppercase tracking-wider">Offline</p>
                <p class="text-2xl font-bold text-slate-400 mt-1">@playerListData.TotalOffline</p>
            </div>
            <div class="rounded-lg border border-red-500/30 bg-red-500/10 p-4">
                <p class="text-xs text-red-400 uppercase tracking-wider">Banned</p>
                <p class="text-2xl font-bold text-red-400 mt-1">@playerListData.TotalBanned</p>
            </div>
        </div>
    }

    @* Search Bar + Page Size *@
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center gap-3">
        <div class="relative flex-1 max-w-md">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input type="text"
                   class="w-full pl-9 pr-4 py-2.5 bg-slate-800/50 border border-slate-700 rounded-lg text-white placeholder:text-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                   placeholder="Search players by name, Steam ID, country, or IP..."
                   value="@searchTerm"
                   @oninput="OnSearchInput" />
        </div>
        <div class="flex items-center gap-2">
            <label class="text-xs text-slate-400 whitespace-nowrap">Per page</label>
            <select class="px-3 py-2.5 bg-slate-800/50 border border-slate-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                    value="@pageSize"
                    @onchange="OnPageSizeChanged">
                <option value="100">100</option>
                <option value="200">200</option>
                <option value="500">500</option>
            </select>
        </div>
    </div>

    @if (playerListData == null)
    {
        <div class="tw-card">
            <div class="tw-card-body">
                <div class="text-center py-8">
                    <div class="tw-spinner mx-auto mb-3"></div>
                    <p class="text-slate-500 text-sm">Loading player data...</p>
                </div>
            </div>
        </div>
    }
    else
    {
        @* Online Players Section *@
        <div class="tw-card mb-6">
            <div class="tw-card-header">
                <div class="flex items-center gap-2">
                    <div class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-pulse"></div>
                    <span class="text-sm font-semibold text-white">Online Players (@playerListData.TotalOnline)</span>
                </div>
                <span class="text-xs text-slate-500">Click a row for actions</span>
            </div>
            @if (playerListData.OnlinePlayers.Count == 0)
            {
                <div class="tw-card-body">
                    <p class="text-slate-500 text-sm">No players online</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-slate-700/50 bg-slate-800/20">
                                <th class="px-3 py-2.5 text-left"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.Name)">Player @GetSortIcon(ColumnHeaders.Name)</button></th>
                                <th class="px-3 py-2.5 text-left hidden xl:table-cell"><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Steam ID</span></th>
                                <th class="px-3 py-2.5 text-left"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.Ping)">Ping @GetSortIcon(ColumnHeaders.Ping)</button></th>
                                <th class="px-3 py-2.5 text-left"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.Health)">HP @GetSortIcon(ColumnHeaders.Health)</button></th>
                                <th class="px-3 py-2.5 text-left"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.Country)">Country @GetSortIcon(ColumnHeaders.Country)</button></th>
                                <th class="px-3 py-2.5 text-left hidden lg:table-cell"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.SteamAge)">Steam Age @GetSortIcon(ColumnHeaders.SteamAge)</button></th>
                                <th class="px-3 py-2.5 text-left hidden lg:table-cell"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.RustHours)">Rust Hours @GetSortIcon(ColumnHeaders.RustHours)</button></th>
                                <th class="px-3 py-2.5 text-left hidden lg:table-cell"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.IP)">IP @GetSortIcon(ColumnHeaders.IP)</button></th>
                                <th class="px-3 py-2.5 text-left hidden xl:table-cell"><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Team</span></th>
                                <th class="px-3 py-2.5 text-left hidden xl:table-cell"><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">VAC</span></th>
                                <th class="px-3 py-2.5 text-left hidden xl:table-cell"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.FirstSeen)">First Seen @GetSortIcon(ColumnHeaders.FirstSeen)</button></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in SortPlayers(FilterPlayers(playerListData.OnlinePlayers)))
                            {
                                <tr class="border-b border-slate-700/30 hover:bg-slate-800/40 transition-colors cursor-pointer @GetPlayerRowClass(player)" @onclick="() => OpenPlayerActionsModal(player)">
                                    <td class="px-3 py-2.5">
                                        <div class="flex items-center gap-2.5">
                                            <div class="relative shrink-0">
                                                @if (!string.IsNullOrEmpty(player.Avatar))
                                                {
                                                    <img src="@player.Avatar" alt="@player.Name" class="w-8 h-8 rounded-lg object-cover" />
                                                }
                                                else
                                                {
                                                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-orange-500/30 to-amber-600/30 flex items-center justify-center">
                                                        <span class="text-xs font-bold text-orange-300">@(player.Name?.Length > 0 ? player.Name[0].ToString().ToUpper() : "?")</span>
                                                    </div>
                                                }
                                                <div class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-slate-900"></div>
                                            </div>
                                            <span class="font-medium text-white text-sm truncate max-w-[160px]">@player.Name</span>
                                        </div>
                                    </td>
                                    <td class="px-3 py-2.5 hidden xl:table-cell"><span class="font-mono text-xs text-slate-500">@player.SteamId</span></td>
                                    <td class="px-3 py-2.5">
                                        @if (player.CurrentPing.HasValue)
                                        { <span class="text-xs text-slate-300">@player.CurrentPing ms</span> }
                                        else
                                        { <span class="text-slate-600">-</span> }
                                    </td>
                                    <td class="px-3 py-2.5">
                                        @if (player.Health.HasValue)
                                        { <span class="text-xs text-slate-300">@player.Health.Value.ToString("F0")</span> }
                                        else
                                        { <span class="text-slate-600">-</span> }
                                    </td>
                                    <td class="px-3 py-2.5">
                                        @if (!string.IsNullOrEmpty(player.Country))
                                        {
                                            var flagUrl = CountryFlagHelper.GetFlagImageUrl(player.Country);
                                            <div class="flex items-center gap-1.5">
                                                @if (!string.IsNullOrEmpty(flagUrl))
                                                { <img src="@flagUrl" alt="@player.Country" title="@player.Country" class="w-5 h-3.5 rounded-sm" /> }
                                                <span class="text-xs text-slate-400">@player.Country</span>
                                                @if (player.IsVpn)
                                                { <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">VPN</span> }
                                            </div>
                                        }
                                        else
                                        {
                                            @if (player.IsVpn)
                                            { <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">VPN</span> }
                                            else
                                            { <span class="text-slate-600">-</span> }
                                        }
                                    </td>
                                    <td class="px-3 py-2.5 hidden lg:table-cell">
                                        @if (player.SteamAccountCreated.HasValue)
                                        { <span class="text-xs text-slate-300">@GetSteamAge(player.SteamAccountCreated.Value)</span> }
                                        else if (player.ProfileVisibility == 1)
                                        { <span class="text-xs text-slate-500">Private</span> }
                                        else
                                        { <span class="text-slate-600">-</span> }
                                    </td>
                                    <td class="px-3 py-2.5 hidden lg:table-cell">
                                        @if (player.RustPlaytimeMinutes.HasValue)
                                        { var hours = player.RustPlaytimeMinutes.Value / 60.0;
                                            <span class="text-xs text-slate-300">@hours.ToString("N0")h</span> }
                                        else if (player.ProfileVisibility == 1)
                                        { <span class="text-xs text-slate-500">Private</span> }
                                        else
                                        { <span class="text-slate-600">-</span> }
                                    </td>
                                    <td class="px-3 py-2.5 hidden lg:table-cell">
                                        @if (!string.IsNullOrEmpty(player.LastIp))
                                        {
                                            <div class="flex items-center gap-1.5">
                                                <span class="font-mono text-xs text-slate-400">@player.LastIp</span>
                                                @if (player.IsVpn)
                                                { <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">VPN</span> }
                                            </div>
                                        }
                                        else
                                        { <span class="text-slate-600">-</span> }
                                    </td>
                                    <td class="px-3 py-2.5 hidden xl:table-cell">
                                        @if (player.TeamId.HasValue && player.TeamId.Value != 0)
                                        { <span class="text-xs text-slate-300">@player.TeamId</span> }
                                        else
                                        { <span class="text-slate-600">-</span> }
                                    </td>
                                    <td class="px-3 py-2.5 hidden xl:table-cell">
                                        @if (player.VACBanned && player.NumberOfVACBans.HasValue && player.NumberOfVACBans.Value > 0)
                                        { <span class="tw-badge-danger text-[10px]">@player.NumberOfVACBans</span> }
                                        else
                                        { <span class="text-slate-600">-</span> }
                                    </td>
                                    <td class="px-3 py-2.5 hidden xl:table-cell"><span class="text-xs text-slate-500">@player.FirstSeen.ToLocalTime().ToString("dd-MM-yyyy")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="px-3 py-2 border-t border-slate-700/50 bg-slate-800/20">
                    <p class="text-xs text-slate-500">Showing @FilterPlayers(playerListData.OnlinePlayers).Count of @playerListData.OnlinePlayers.Count online players</p>
                </div>
            }
        </div>

        @* Offline Players Section *@
        <div class="tw-card">
            <div class="tw-card-header">
                <div class="flex items-center gap-2">
                    <div class="w-2.5 h-2.5 bg-slate-500 rounded-full"></div>
                    <span class="text-sm font-semibold text-white">Offline Players (@playerListData.TotalOffline)</span>
                </div>
                <span class="text-xs text-slate-500">Click a row for actions</span>
            </div>
            @if (playerListData.OfflinePlayers.Count == 0)
            {
                <div class="tw-card-body">
                    <p class="text-slate-500 text-sm">No offline players</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-slate-700/50 bg-slate-800/20">
                                <th class="px-3 py-2.5 text-left"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.Name)">Player @GetSortIcon(ColumnHeaders.Name)</button></th>
                                <th class="px-3 py-2.5 text-left hidden xl:table-cell"><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Steam ID</span></th>
                                <th class="px-3 py-2.5 text-left"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.Country)">Country @GetSortIcon(ColumnHeaders.Country)</button></th>
                                <th class="px-3 py-2.5 text-left hidden lg:table-cell"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.SteamAge)">Steam Age @GetSortIcon(ColumnHeaders.SteamAge)</button></th>
                                <th class="px-3 py-2.5 text-left hidden lg:table-cell"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.RustHours)">Rust Hours @GetSortIcon(ColumnHeaders.RustHours)</button></th>
                                <th class="px-3 py-2.5 text-left hidden lg:table-cell"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.IP)">IP @GetSortIcon(ColumnHeaders.IP)</button></th>
                                <th class="px-3 py-2.5 text-left hidden xl:table-cell"><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">VAC</span></th>
                                <th class="px-3 py-2.5 text-left"><button class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.LastSeen)">Last Seen @GetSortIcon(ColumnHeaders.LastSeen)</button></th>
                                <th class="px-3 py-2.5 text-left"><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Status</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in SortPlayers(playerListData.OfflinePlayers))
                            {
                                <tr class="border-b border-slate-700/30 hover:bg-slate-800/40 transition-colors cursor-pointer @GetPlayerRowClass(player)" @onclick="() => OpenPlayerActionsModal(player)">
                                    <td class="px-3 py-2.5">
                                        <div class="flex items-center gap-2.5">
                                            <div class="relative shrink-0">
                                                @if (!string.IsNullOrEmpty(player.Avatar))
                                                {
                                                    <img src="@player.Avatar" alt="@player.Name" class="w-8 h-8 rounded-lg object-cover opacity-60" />
                                                }
                                                else
                                                {
                                                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-slate-600/30 to-slate-700/30 flex items-center justify-center">
                                                        <span class="text-xs font-bold text-slate-500">@(player.Name?.Length > 0 ? player.Name[0].ToString().ToUpper() : "?")</span>
                                                    </div>
                                                }
                                            </div>
                                            <span class="font-medium text-slate-300 text-sm truncate max-w-[160px]">@player.Name</span>
                                        </div>
                                    </td>
                                    <td class="px-3 py-2.5 hidden xl:table-cell"><span class="font-mono text-xs text-slate-500">@player.SteamId</span></td>
                                    <td class="px-3 py-2.5">
                                        @if (!string.IsNullOrEmpty(player.Country))
                                        {
                                            var flagUrl = CountryFlagHelper.GetFlagImageUrl(player.Country);
                                            <div class="flex items-center gap-1.5">
                                                @if (!string.IsNullOrEmpty(flagUrl))
                                                { <img src="@flagUrl" alt="@player.Country" title="@player.Country" class="w-5 h-3.5 rounded-sm" /> }
                                                <span class="text-xs text-slate-400">@player.Country</span>
                                                @if (player.IsVpn)
                                                { <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">VPN</span> }
                                            </div>
                                        }
                                        else
                                        {
                                            @if (player.IsVpn)
                                            { <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">VPN</span> }
                                            else
                                            { <span class="text-slate-600">-</span> }
                                        }
                                    </td>
                                    <td class="px-3 py-2.5 hidden lg:table-cell">
                                        @if (player.SteamAccountCreated.HasValue)
                                        { <span class="text-xs text-slate-400">@GetSteamAge(player.SteamAccountCreated.Value)</span> }
                                        else if (player.ProfileVisibility == 1)
                                        { <span class="text-xs text-slate-500">Private</span> }
                                        else
                                        { <span class="text-slate-600">-</span> }
                                    </td>
                                    <td class="px-3 py-2.5 hidden lg:table-cell">
                                        @if (player.RustPlaytimeMinutes.HasValue)
                                        { var hours = player.RustPlaytimeMinutes.Value / 60.0;
                                            <span class="text-xs text-slate-400">@hours.ToString("N0")h</span> }
                                        else if (player.ProfileVisibility == 1)
                                        { <span class="text-xs text-slate-500">Private</span> }
                                        else
                                        { <span class="text-slate-600">-</span> }
                                    </td>
                                    <td class="px-3 py-2.5 hidden lg:table-cell">
                                        @if (!string.IsNullOrEmpty(player.LastIp))
                                        {
                                            <div class="flex items-center gap-1.5">
                                                <span class="font-mono text-xs text-slate-400">@player.LastIp</span>
                                                @if (player.IsVpn)
                                                { <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">VPN</span> }
                                            </div>
                                        }
                                        else
                                        { <span class="text-slate-600">-</span> }
                                    </td>
                                    <td class="px-3 py-2.5 hidden xl:table-cell">
                                        @if (player.VACBanned && player.NumberOfVACBans.HasValue && player.NumberOfVACBans.Value > 0)
                                        { <span class="tw-badge-danger text-[10px]">@player.NumberOfVACBans</span> }
                                        else
                                        { <span class="text-slate-600">-</span> }
                                    </td>
                                    <td class="px-3 py-2.5"><span class="text-xs text-slate-500">@player.LastSeen.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span></td>
                                    <td class="px-3 py-2.5">
                                        @if (player.IsBanned)
                                        { <span class="tw-badge-danger text-[10px]">Banned</span> }
                                        else
                                        { <span class="text-slate-600">-</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="px-3 py-2 border-t border-slate-700/50 bg-slate-800/20 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <p class="text-xs text-slate-500">
                        @{
                            var start = playerListData.OfflineFilteredTotal == 0 ? 0 : ((playerListData.OfflinePage - 1) * playerListData.OfflinePageSize) + 1;
                            var end = Math.Min(playerListData.OfflinePage * playerListData.OfflinePageSize, playerListData.OfflineFilteredTotal);
                        }
                        Showing @start-@end of @playerListData.OfflineFilteredTotal@(string.IsNullOrWhiteSpace(searchTerm) ? "" : " filtered") offline players
                    </p>
                    @{
                        var totalPages = Math.Max(1, (int)Math.Ceiling((double)playerListData.OfflineFilteredTotal / playerListData.OfflinePageSize));
                    }
                    @if (totalPages > 1)
                    {
                        <div class="flex items-center gap-1">
                            <button class="px-2 py-1 rounded border border-slate-700 text-xs text-slate-300 hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed"
                                    disabled="@(offlinePage <= 1)"
                                    @onclick="() => GoToPage(1)">
                                <i class="fas fa-angle-double-left"></i>
                            </button>
                            <button class="px-2 py-1 rounded border border-slate-700 text-xs text-slate-300 hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed"
                                    disabled="@(offlinePage <= 1)"
                                    @onclick="() => GoToPage(offlinePage - 1)">
                                <i class="fas fa-angle-left"></i>
                            </button>
                            <span class="px-2 text-xs text-slate-400">Page @offlinePage of @totalPages</span>
                            <button class="px-2 py-1 rounded border border-slate-700 text-xs text-slate-300 hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed"
                                    disabled="@(offlinePage >= totalPages)"
                                    @onclick="() => GoToPage(offlinePage + 1)">
                                <i class="fas fa-angle-right"></i>
                            </button>
                            <button class="px-2 py-1 rounded border border-slate-700 text-xs text-slate-300 hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed"
                                    disabled="@(offlinePage >= totalPages)"
                                    @onclick="() => GoToPage(totalPages)">
                                <i class="fas fa-angle-double-right"></i>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }

</ContentWrapper>
</PageAccessGuard>

@* Player Actions Modal *@
<TwModal @bind-IsOpen="showPlayerActionsModal" Title="Player Actions" Size="sm">
    <ChildContent>
        @if (selectedPlayerForActions != null)
        {
            <div class="flex items-center gap-3 mb-5 pb-4 border-b border-slate-700/50">
                <div class="relative shrink-0">
                    @if (!string.IsNullOrEmpty(selectedPlayerForActions.Avatar))
                    {
                        <img src="@selectedPlayerForActions.Avatar" alt="@selectedPlayerForActions.Name" class="w-12 h-12 rounded-lg object-cover" />
                    }
                    else
                    {
                        <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-orange-500/30 to-amber-600/30 flex items-center justify-center">
                            <span class="text-sm font-bold text-orange-300">@(selectedPlayerForActions.Name?.Length > 0 ? selectedPlayerForActions.Name[0].ToString().ToUpper() : "?")</span>
                        </div>
                    }
                    @if (IsPlayerOnline(selectedPlayerForActions))
                    {
                        <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 rounded-full border-2 border-slate-900"></div>
                    }
                </div>
                <div class="min-w-0">
                    <p class="text-white font-semibold text-sm truncate">@selectedPlayerForActions.Name</p>
                    <p class="text-slate-500 text-xs font-mono">@selectedPlayerForActions.SteamId</p>
                </div>
                @if (selectedPlayerForActions.IsBanned)
                {
                    <span class="tw-badge-danger text-[10px] ml-auto">Banned</span>
                }
            </div>

            <div class="space-y-1.5">
                @* Navigation Actions *@
                <button class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-800/60 hover:text-white transition-colors text-left"
                        @onclick="() => NavigateToInspect(selectedPlayerForActions)">
                    <i class="fas fa-user w-4 text-center text-blue-400"></i>
                    <span>Inspect Player</span>
                </button>

                <button class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-800/60 hover:text-white transition-colors text-left"
                        @onclick="() => { ClosePlayerActionsModal(); OpenNotesDialog(selectedPlayerForActions); }">
                    <i class="fas fa-sticky-note w-4 text-center text-amber-400"></i>
                    <span>Notes</span>
                </button>

                <button class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-800/60 hover:text-white transition-colors text-left"
                        @onclick="() => { ClosePlayerActionsModal(); NavigateToPlayerReports(selectedPlayerForActions.SteamId); }">
                    <i class="fas fa-flag w-4 text-center text-orange-400"></i>
                    <span>Reports</span>
                </button>

                <a href="https://steamcommunity.com/profiles/@selectedPlayerForActions.SteamId" target="_blank"
                   class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-800/60 hover:text-white transition-colors">
                    <i class="fab fa-steam w-4 text-center text-slate-400"></i>
                    <span>Steam Profile</span>
                    <i class="fas fa-external-link-alt text-[10px] text-slate-600 ml-auto"></i>
                </a>

                @if (IsPlayerOnline(selectedPlayerForActions))
                {
                    <div class="border-t border-slate-700/50 my-2"></div>

                    <button class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-800/60 hover:text-white transition-colors text-left"
                            @onclick="async () => { ClosePlayerActionsModal(); await OpenGiveItemDialog(selectedPlayerForActions); }">
                        <i class="fas fa-gift w-4 text-center text-emerald-400"></i>
                        <span>Give Item</span>
                    </button>

                    <button class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-800/60 hover:text-white transition-colors text-left"
                            @onclick="() => { ClosePlayerActionsModal(); OpenKickDialog(selectedPlayerForActions); }">
                        <i class="fas fa-right-from-bracket w-4 text-center text-amber-400"></i>
                        <span>Kick</span>
                    </button>

                    <button class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-slate-300 hover:bg-slate-800/60 hover:text-white transition-colors text-left"
                            @onclick="async () => { ClosePlayerActionsModal(); await KillPlayer(selectedPlayerForActions); }">
                        <i class="fas fa-skull w-4 text-center text-red-400"></i>
                        <span>Kill</span>
                    </button>
                }

                <div class="border-t border-slate-700/50 my-2"></div>

                @if (selectedPlayerForActions.IsBanned)
                {
                    <button class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-emerald-400 hover:bg-emerald-500/10 transition-colors text-left"
                            @onclick="() => { ClosePlayerActionsModal(); OpenUnbanConfirmDialog(selectedPlayerForActions); }">
                        <i class="fas fa-lock-open w-4 text-center"></i>
                        <span>Unban Player</span>
                    </button>
                }
                else
                {
                    <button class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-red-400 hover:bg-red-500/10 transition-colors text-left"
                            @onclick="() => { ClosePlayerActionsModal(); OpenBanDialog(selectedPlayerForActions); }">
                        <i class="fas fa-gavel w-4 text-center"></i>
                        <span>Ban Player</span>
                    </button>
                }

                <button class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-red-400 hover:bg-red-500/10 transition-colors text-left"
                        @onclick="() => { ClosePlayerActionsModal(); OpenClearDataModal(selectedPlayerForActions); }">
                    <i class="fas fa-trash-alt w-4 text-center"></i>
                    <span>Clear Player Data</span>
                </button>
            </div>
        }
    </ChildContent>
</TwModal>

@* Ban Player Modal *@
<TwModal @bind-IsOpen="showBanModal" Title="@($"Ban Player: {selectedPlayerForBan?.Name ?? ""}")" Size="default">
    <ChildContent>
        @if (selectedPlayerForBan != null)
        {
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Ban Reason *</label>
                    <textarea class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white placeholder:text-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                              rows="3" @bind="banReason" placeholder="Enter reason for ban..."></textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Ban Duration</label>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">Hours</label>
                            <input type="number" class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                                   min="0" @bind="banDurationHours" />
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">Days</label>
                            <input type="number" class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                                   min="0" @bind="banDurationDays" />
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">Weeks</label>
                            <input type="number" class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                                   min="0" @bind="banDurationWeeks" />
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">Months</label>
                            <input type="number" class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                                   min="0" @bind="banDurationMonths" />
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">Years</label>
                            <input type="number" class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                                   min="0" @bind="banDurationYears" />
                        </div>
                        <div class="flex items-end">
                            <span class="text-xs text-slate-500 pb-2">Total: @GetTotalBanHours() hours</span>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Internal Note <span class="text-slate-500 font-normal">(optional)</span></label>
                    <textarea class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white placeholder:text-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                              rows="2" @bind="banInternalNote" placeholder="Add an internal note (only visible to panel admins)..."></textarea>
                </div>

                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" class="w-4 h-4 rounded border-slate-600 bg-slate-800 text-orange-500 focus:ring-orange-500/50" @bind="isGlobalBan" />
                    <span class="text-sm text-slate-300">Global Ban <span class="text-slate-500">(Ban across all servers)</span></span>
                </label>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button class="tw-btn-ghost px-4 py-2 text-sm" @onclick="CloseBanDialog">Cancel</button>
        <button class="tw-btn-warning px-4 py-2 text-sm" @onclick="ConfirmBanPlayer"
                disabled="@(string.IsNullOrWhiteSpace(banReason) || GetTotalBanHours() == 0)">
            <i class="fas fa-gavel mr-2"></i>Ban Player
        </button>
    </FooterContent>
</TwModal>

@* Confirm Ban Modal *@
<TwModal @bind-IsOpen="showConfirmBanModal" Title="Confirm Ban" Size="default">
    <ChildContent>
        <p class="text-slate-300">Are you sure you want to ban <strong class="text-white">@selectedPlayerForBan?.Name</strong>?</p>
        <div class="mt-4 rounded-lg bg-amber-500/10 border border-amber-500/30 p-4">
            <p class="text-sm font-semibold text-amber-400 mb-1">Ban Details:</p>
            <div class="text-xs text-slate-400 space-y-0.5">
                <p>Reason: @banReason</p>
                <p>Duration: @GetTotalBanHours() hours</p>
                <p>Global Ban: @(isGlobalBan ? "Yes" : "No")</p>
            </div>
        </div>
        <p class="text-red-400 text-sm font-semibold mt-4">This action cannot be undone.</p>
    </ChildContent>
    <FooterContent>
        <button class="tw-btn-ghost px-4 py-2 text-sm" @onclick="CancelBan">Cancel</button>
        <button class="tw-btn-danger px-4 py-2 text-sm" @onclick="ExecuteBan">
            <i class="fas fa-gavel mr-2"></i>Confirm Ban
        </button>
    </FooterContent>
</TwModal>

@* Unban Confirmation Modal *@
<TwModal @bind-IsOpen="showUnbanModal" Title="Confirm Unban" Size="default">
