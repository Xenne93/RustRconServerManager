@* Player Notes Modal *@
<TwModal @bind-IsOpen="showNotesModal" Title="@($"Notes: {selectedPlayerForNotes?.Name ?? ""}")" Size="lg" MaxHeight="60vh">
    <ChildContent>
        @if (isLoadingNotes)
        {
            <div class="text-center py-8">
                <div class="tw-spinner mx-auto mb-3"></div>
                <p class="text-slate-500 text-sm">Loading notes...</p>
            </div>
        }
        else if (selectedPlayerForNotes != null)
        {
            @* Add New Note Form *@
            @if (showNoteForm)
            {
                <div class="rounded-lg border border-slate-700/50 bg-slate-800/30 p-4 mb-4">
                    <p class="text-sm font-semibold text-white mb-3">@(editingNoteId.HasValue ? "Edit Note" : "Add New Note")</p>
                    <textarea class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white placeholder:text-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 mb-3"
                              rows="4" @bind="newNoteText" placeholder="Enter your note here..."></textarea>
                    <div class="flex gap-2">
                        <button class="tw-btn-primary px-3 py-1.5 text-sm" @onclick="SaveNote" disabled="@isSavingNote">
                            @if (isSavingNote)
                            {
                                <div class="tw-spinner w-3 h-3 mr-2"></div>
                            }
                            <i class="fas fa-save mr-1"></i>@(editingNoteId.HasValue ? "Update" : "Save")
                        </button>
                        <button class="tw-btn-ghost px-3 py-1.5 text-sm" @onclick="CancelNoteEdit">
                            <i class="fas fa-times mr-1"></i>Cancel
                        </button>
                    </div>
                </div>
            }
            else
            {
                <button class="tw-btn-primary px-3 py-1.5 text-sm mb-4" @onclick="() => { showNoteForm = true; editingNoteId = null; newNoteText = string.Empty; }">
                    <i class="fas fa-plus mr-1"></i>Add New Note
                </button>
            }

            @* Notes List *@
            @if (playerNotes.Count == 0)
            {
                <div class="rounded-lg bg-blue-500/10 border border-blue-500/30 text-blue-400 px-4 py-3 text-sm">
                    <i class="fas fa-info-circle mr-2"></i>No notes for this player yet.
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var note in playerNotes)
                    {
                        <div class="rounded-lg border border-slate-700/50 bg-slate-800/30 p-4">
                            <div class="flex justify-between items-start mb-2">
                                <div class="text-xs text-slate-500">
                                    <i class="fas fa-user mr-1"></i>@note.CreatedBy
                                    <i class="fas fa-clock ml-2 mr-1"></i>@note.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                                    @if (note.UpdatedAt != note.CreatedAt)
                                    {
                                        <span class="ml-2">(edited: @note.UpdatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm"))</span>
                                    }
                                </div>
                                <div class="flex gap-1">
                                    <button class="h-7 w-7 flex items-center justify-center rounded text-slate-400 hover:text-blue-400 hover:bg-slate-700 transition-colors" @onclick="() => EditNote(note)">
                                        <i class="fas fa-edit text-xs"></i>
                                    </button>
                                    <button class="h-7 w-7 flex items-center justify-center rounded text-slate-400 hover:text-red-400 hover:bg-slate-700 transition-colors" @onclick="() => DeleteNote(note.Id)">
                                        <i class="fas fa-trash text-xs"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="text-sm text-slate-300 whitespace-pre-wrap break-words rounded bg-slate-900/50 border border-slate-700/30 p-3">
                                @note.Note
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </ChildContent>
    <FooterContent>
        <button class="tw-btn-ghost px-4 py-2 text-sm" @onclick="CloseNotesDialog">Close</button>
    </FooterContent>
</TwModal>

@* Clear Player Data Modal *@
<TwModal @bind-IsOpen="showClearDataModal" Title="Clear Player Data" Size="default">
    <ChildContent>
        @if (!string.IsNullOrEmpty(clearDataError))
        {
            <div class="rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 text-sm mb-4">@clearDataError</div>
        }
        @if (!string.IsNullOrEmpty(clearDataSuccess))
        {
            <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-4 py-3 text-sm mb-4">@clearDataSuccess</div>
        }

        <p class="text-sm text-slate-400 mb-4">Select which data to clear for <span class="text-white font-medium">@clearDataPlayerName</span>:</p>

        <div class="space-y-2">
            <label class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800/40 cursor-pointer transition-colors">
                <input type="checkbox" @bind="clearChat" class="w-4 h-4 rounded bg-slate-700 border-slate-600 text-orange-500 focus:ring-orange-500/50" />
                <i class="fas fa-comments w-4 text-center text-blue-400"></i>
                <span class="text-sm text-slate-300">Chat Messages</span>
            </label>
            <label class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800/40 cursor-pointer transition-colors">
                <input type="checkbox" @bind="clearKills" class="w-4 h-4 rounded bg-slate-700 border-slate-600 text-orange-500 focus:ring-orange-500/50" />
                <i class="fas fa-crosshairs w-4 text-center text-orange-400"></i>
                <span class="text-sm text-slate-300">Kills</span>
            </label>
            <label class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800/40 cursor-pointer transition-colors">
                <input type="checkbox" @bind="clearDeaths" class="w-4 h-4 rounded bg-slate-700 border-slate-600 text-orange-500 focus:ring-orange-500/50" />
                <i class="fas fa-skull w-4 text-center text-red-400"></i>
                <span class="text-sm text-slate-300">Deaths</span>
            </label>
            <label class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800/40 cursor-pointer transition-colors">
                <input type="checkbox" @bind="clearNotes" class="w-4 h-4 rounded bg-slate-700 border-slate-600 text-orange-500 focus:ring-orange-500/50" />
                <i class="fas fa-sticky-note w-4 text-center text-amber-400"></i>
                <span class="text-sm text-slate-300">Notes</span>
            </label>
            <label class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800/40 cursor-pointer transition-colors">
                <input type="checkbox" @bind="clearReports" class="w-4 h-4 rounded bg-slate-700 border-slate-600 text-orange-500 focus:ring-orange-500/50" />
                <i class="fas fa-flag w-4 text-center text-orange-400"></i>
                <span class="text-sm text-slate-300">Reports</span>
            </label>
            <label class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800/40 cursor-pointer transition-colors">
                <input type="checkbox" @bind="clearBanHistory" class="w-4 h-4 rounded bg-slate-700 border-slate-600 text-orange-500 focus:ring-orange-500/50" />
                <i class="fas fa-gavel w-4 text-center text-slate-400"></i>
                <span class="text-sm text-slate-300">Ban History</span>
            </label>
        </div>

        <div class="mt-5 pt-4 border-t border-slate-700/50">
            <p class="text-xs text-red-400/80 mb-3"><i class="fas fa-exclamation-triangle mr-1"></i>The action below will permanently remove the player entry and ALL associated data.</p>
            <button class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 hover:bg-red-500/20 border border-red-500/30 transition-colors"
                    @onclick="DeletePlayerAndAllData" disabled="@isClearingData">
                @if (isClearingData)
                {
                    <div class="tw-spinner w-3 h-3"></div>
                }
                <i class="fas fa-user-times"></i>
                <span>Delete Player + All Data</span>
            </button>
        </div>
    </ChildContent>
    <FooterContent>
        <div class="flex justify-end gap-2">
            <button type="button" class="px-4 py-2 text-sm font-medium text-slate-300 bg-slate-700 hover:bg-slate-600 rounded-lg transition-colors" @onclick="() => showClearDataModal = false">
                Cancel
            </button>
            <button type="button" class="px-4 py-2 text-sm font-medium text-white bg-orange-500 hover:bg-orange-600 rounded-lg transition-colors disabled:opacity-50"
                    @onclick="ClearSelectedPlayerData" disabled="@(isClearingData || !AnyClearOptionSelected)">
                @if (isClearingData)
                {
                    <i class="fas fa-spinner fa-spin mr-2"></i>
                }
                Clear Selected Data
            </button>
        </div>
    </FooterContent>
</TwModal>

@code {
    // Column header constants for type-safe sorting
    private static class ColumnHeaders
    {
        public const string Name = "Name";
        public const string SteamID = "SteamID";
        public const string Ping = "Ping";
        public const string Health = "Health";
        public const string Country = "Country";
        public const string SteamAge = "SteamAge";
        public const string RustHours = "RustHours";
        public const string IP = "IP";
        public const string FirstSeen = "FirstSeen";
        public const string LastSeen = "LastSeen";
    }

    private PlayerList_PlayerListDTO playerListData = null;
    private readonly PeriodicTimer _timer = new(TimeSpan.FromSeconds(10));
    private readonly CancellationTokenSource _cts = new();
    private NavigationHelper NavHelper => new NavigationHelper(Nav);

    // Search and sort state
    private string searchTerm = "";
    private string sortColumn = ColumnHeaders.Name;
    private bool sortAscending = true;

    // Pagination state
    private int pageSize = 100;
    private int offlinePage = 1;
    private CancellationTokenSource? _searchDebounceCts;

    // Modal visibility state (replaces Bootstrap JS)
    private bool showPlayerActionsModal = false;
    private bool showBanModal = false;
    private bool showConfirmBanModal = false;
    private bool showUnbanModal = false;
    private bool showKickModal = false;
    private bool showNotesModal = false;

    // Player actions modal state
    private PlayerList_PlayerDTO selectedPlayerForActions = null;

    // Ban dialog state
    private PlayerList_PlayerDTO selectedPlayerForBan = null;
    private string banReason = "";
    private int banDurationHours = 0;
    private int banDurationDays = 0;
    private int banDurationWeeks = 0;
