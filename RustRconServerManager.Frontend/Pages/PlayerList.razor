        <button class="tw-btn-ghost px-4 py-2 text-sm" @onclick="CloseUnbanConfirmDialog">Cancel</button>
        <button class="tw-btn-warning px-4 py-2 text-sm" @onclick="ConfirmUnbanPlayer">
            <i class="fas fa-lock-open mr-2"></i>Confirm Unban
        </button>
    </FooterContent>
</TwModal>

@* Give Item Dialog *@
<GiveItemDialog @ref="giveItemDialog" OnItemGiven="OnItemGiven" />

@* Kick Player Modal *@
<TwModal @bind-IsOpen="showKickModal" Title="@($"Kick Player: {selectedPlayerForKick?.Name ?? ""}")" Size="default">
