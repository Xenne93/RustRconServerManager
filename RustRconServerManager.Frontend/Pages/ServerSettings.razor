                                    </label>
                                </div>
                                <i class="fas fa-chevron-down text-slate-400 text-xs transition-transform @(IsWebhookExpanded("playerDisconnect") ? "rotate-180" : "")"></i>
                            </div>
                        </button>
                        @if (IsWebhookExpanded("playerDisconnect"))
                        {
