    private void OnSearchInput(ChangeEventArgs e, string groupName)
    {
        var value = e.Value?.ToString() ?? string.Empty;

        if (!searchTerms.ContainsKey(groupName))
        {
            searchTerms[groupName] = value;
        }
        else
        {
            searchTerms[groupName] = value;
        }

        // Clear existing results if search term is too short
        if (value.Length < 2)
        {
            if (searchResults.ContainsKey(groupName))
            {
                searchResults[groupName].Clear();
            }
            StateHasChanged();
            return;
        }

        // Debounce search - wait 300ms after user stops typing
        searchDebounceTimer?.Dispose();
        searchDebounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await SearchPlayers(groupName);
            });
        }, null, 300, Timeout.Infinite);
    }

