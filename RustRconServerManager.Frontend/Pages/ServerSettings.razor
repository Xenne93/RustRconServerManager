    private async Task SetPluginSource(string pluginName, string? sourceValue)
    {
        // Guard: Android System WebView fires @onchange spuriously during DOM diffing.
        // If the value hasn't actually changed, return immediately to avoid an infinite re-render loop.
        PluginSource? newSource = null;
        if (!string.IsNullOrEmpty(sourceValue) && int.TryParse(sourceValue, out int sourceIntGuard))
            newSource = (PluginSource)sourceIntGuard;
        var existingSource = pluginSources.GetValueOrDefault(pluginName);
        if (newSource == existingSource) return;

        try
        {


            // Parse source value
            PluginSource? source = null;
            if (!string.IsNullOrEmpty(sourceValue) && int.TryParse(sourceValue, out int sourceInt))
            {
                source = (PluginSource)sourceInt;
            }

            var requestBody = new Mods_SetPluginSourceDTO
            {
                PluginName = pluginName,
                Source = source
            };

            var response = await Http.PostAsJsonAsync("/api/Mods/SetPluginSource", requestBody);

            if (response.IsSuccessStatusCode)
            {
                // Update local source tracking
                if (source == null)
                {
                    pluginSources.Remove(pluginName);
                }
                else
                {
                    pluginSources[pluginName] = source;
                }

                // Update the plugin's IsCustom and Source in the local list
                var plugin = plugins.FirstOrDefault(p => (p.FileName ?? "").Replace(".cs", "") == pluginName);
                if (plugin != null)
                {
                    plugin.Source = source;
                    plugin.IsCustom = source == PluginSource.Custom;
                }

                // Clear version check results when source changes
                pluginVersions.Remove(pluginName);
                notFoundPlugins.Remove(pluginName);

                // If source is Umod or Codefling, trigger version check with spinner
                if (source == PluginSource.Umod || source == PluginSource.Codefling)
                {
                    _ = CheckSinglePluginVersion(pluginName, plugin?.Version ?? "0.0.0");
                }

                StateHasChanged();
            }
            else
            {
                Console.WriteLine($"Failed to set plugin source: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting plugin source: {ex.Message}");
        }
    }

