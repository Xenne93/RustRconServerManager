    private async Task LoadPluginVersions()
    {
        try
        {
            // Build list of plugins to check (loaded, non-custom, not previously not found)
            var pluginsToCheck = plugins
                .Where(p => p.Status == PluginStatus.Loaded && !p.IsCustom && p.FileName != null)
                .Select(p => new { Name = p.FileName!.Replace(".cs", ""), Version = p.Version })
                .Where(p => !notFoundPlugins.Contains(p.Name))
                .ToList();

            if (pluginsToCheck.Count == 0)
            {
                Console.WriteLine("No plugins to check versions for");
                return;
            }

            loadingVersions = true;
            await InvokeAsync(StateHasChanged);



            // Create batch request
            var request = new PluginVersionCheckBatchRequest
            {
                Plugins = pluginsToCheck.Select(p => new PluginVersionCheckItem
                {
                    PluginName = p.Name,
                    InstalledVersion = p.Version
                }).ToList()
            };

            Console.WriteLine($"Checking versions for {request.Plugins.Count} plugins in batch");

            var response = await Http.PostAsJsonAsync("/api/Mods/CheckPluginVersionsBatch", request);

            if (response.IsSuccessStatusCode)
            {
                var batchResponse = await response.Content.ReadFromJsonAsync<PluginVersionCheckBatchResponse>();
                if (batchResponse?.Results != null)
                {
                    foreach (var kvp in batchResponse.Results)
                    {
                        if (kvp.Value != null)
                        {
                            pluginVersions[kvp.Key] = kvp.Value;

                            // If plugin truly doesn't exist (404 from all sources), cache it to skip future checks
                            if (kvp.Value.NotFound)
                            {
                                notFoundPlugins.Add(kvp.Key);
                                Console.WriteLine($"Plugin {kvp.Key} marked as not found - will skip future version checks");
                            }
                        }
                    }
                    Console.WriteLine($"Batch version check complete: {batchResponse.CheckedCount}/{batchResponse.TotalCount} plugins checked");
                }
            }
            else
            {
                Console.WriteLine($"Batch version check failed: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in batch plugin version check: {ex.Message}");
        }
        finally
        {
            loadingVersions = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CheckSinglePluginVersion(string pluginName, string installedVersion)
    {
        try
        {
            checkingVersions.Add(pluginName);
            await InvokeAsync(StateHasChanged);

            var response = await Http.GetAsync($"/api/Mods/CheckPluginVersion?pluginName={Uri.EscapeDataString(pluginName)}&installedVersion={Uri.EscapeDataString(installedVersion)}");

            if (response.IsSuccessStatusCode)
            {
                var versionInfo = await response.Content.ReadFromJsonAsync<PluginVersionCheckResult>();
                if (versionInfo != null)
                {
                    pluginVersions[pluginName] = versionInfo;

                    // If plugin truly doesn't exist (404 from all sources), cache it to skip future checks
                    if (versionInfo.NotFound)
                    {
                        notFoundPlugins.Add(pluginName);
                        Console.WriteLine($"Plugin {pluginName} marked as not found - will skip future version checks");
                    }
                }
            }
            else
            {
                // API returned error, create a result with no version info
                pluginVersions[pluginName] = new PluginVersionCheckResult
                {
                    PluginName = pluginName,
                    InstalledVersion = installedVersion,
                    LatestVersion = null,
                    IsUpToDate = false,
                    PluginUrl = null,
                    Source = null
                };
            }
        }
        catch (TaskCanceledException)
        {
            Console.WriteLine($"Version check timed out for {pluginName}");
            pluginVersions[pluginName] = new PluginVersionCheckResult
            {
                PluginName = pluginName,
                InstalledVersion = installedVersion,
                LatestVersion = null,
                IsUpToDate = false,
                PluginUrl = null,
                Source = null
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking version for {pluginName}: {ex.Message}");
            pluginVersions[pluginName] = new PluginVersionCheckResult
            {
                PluginName = pluginName,
                InstalledVersion = installedVersion,
                LatestVersion = null,
                IsUpToDate = false,
                PluginUrl = null,
                Source = null
            };
        }
        finally
        {
            checkingVersions.Remove(pluginName);
            await InvokeAsync(StateHasChanged);
        }
    }

    private PluginVersionCheckResult? GetPluginVersionInfo(string pluginName)
    {
        return pluginVersions.ContainsKey(pluginName) ? pluginVersions[pluginName] : null;
    }

    private int GetOutdatedCount()
    {
        return plugins.Count(plugin =>
        {
            // Skip custom plugins
            if (plugin.IsCustom)
                return false;

            var pluginName = (plugin.FileName ?? "").Replace(".cs", "");
            var versionInfo = GetPluginVersionInfo(pluginName);

            // Only count if successfully checked, has a version, and is outdated
            return versionInfo != null
                && versionInfo.LatestVersion != null
                && !versionInfo.IsUpToDate;
        });
    }

    private bool IsCheckingVersion(string pluginName)
    {
        return loadingVersions || checkingVersions.Contains(pluginName);
    }

