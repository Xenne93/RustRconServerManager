                        <div class="flex items-center justify-between px-4 py-3 bg-purple-500/10 border-b border-purple-500/20">
                            <h6 class="text-sm font-semibold text-purple-400 flex items-center gap-2">
                                <i class="fas fa-user-secret"></i>Private Steam Profile Protection
                            </h6>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" @bind="protectionSettings.BlockPrivateSteamProfiles" class="sr-only peer" />
                                <div class="w-9 h-5 bg-slate-600 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-500"></div>
                                <span class="ml-2 text-sm text-slate-300">@(protectionSettings.BlockPrivateSteamProfiles ? "Enabled" : "Disabled")</span>
                            </label>
                        </div>
                        <div class="p-4">
                            <p class="text-slate-400 text-sm mb-3">
                                <small>Automatically kick or ban players whose Steam profile is set to private. Private profiles make it impossible to verify account history.</small>
                            </p>

