                            {
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-slate-300 mb-1">
                                            <i class="fas fa-gavel mr-1"></i>Action to Take
                                        </label>
                                        <select class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500" @bind="protectionSettings.PrivateSteamProfileAction">
                                            <option value="@PrivateSteamProfileAction.Kick">Kick Player (temporary removal)</option>
                                            <option value="@PrivateSteamProfileAction.Ban">Ban Player (use ban duration)</option>
                                        </select>
                                    </div>
                                    <div class="rounded-lg bg-blue-500/10 border border-blue-500/30 text-blue-400 px-4 py-3 text-sm self-end">
                                        <i class="fas fa-info-circle mr-2"></i>
                                        <small>Players can set their profile to public to join. Ban duration is shared with the global setting above.</small>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="rounded-lg bg-slate-500/10 border border-slate-500/30 text-slate-400 px-4 py-3 text-sm mb-0">
                                    <small><i class="fas fa-toggle-off mr-2"></i>Enable this protection to block players with private Steam profiles.</small>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- VPN/Proxy Detection Card -->
                    <div class="rounded-xl border border-slate-700/50 overflow-hidden mb-4">
                        <div class="flex items-center justify-between px-4 py-3 bg-cyan-500/10 border-b border-cyan-500/20">
                            <h6 class="text-sm font-semibold text-cyan-400 flex items-center gap-2">
                                <i class="fas fa-shield-alt"></i>VPN/Proxy Detection
                            </h6>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" @bind="protectionSettings.EnableVpnCheck" class="sr-only peer" />
                                <div class="w-9 h-5 bg-slate-600 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-cyan-500"></div>
                                <span class="ml-2 text-sm text-slate-300">@(protectionSettings.EnableVpnCheck ? "Enabled" : "Disabled")</span>
                            </label>
                        </div>
                        <div class="p-4">
                            <p class="text-slate-400 text-sm mb-3">
                                <small>Check player IP addresses for VPN/proxy usage on connect using proxycheck.io. Results are cached for 24 hours to reduce API calls. A VPN tag will be shown in the player list when detected.</small>
                            </p>

                            @if (protectionSettings.EnableVpnCheck)
                            {
                                <div class="rounded-lg bg-blue-500/10 border border-blue-500/30 text-blue-400 px-4 py-3 text-sm mb-4">
                                    <i class="fas fa-info-circle mr-2"></i>
                                    <small>When enabled, every player connect will be checked against proxycheck.io. The ProxyCheck API key must be configured in your server's appsettings.json.</small>
                                </div>

                                <!-- VPN Protection sub-option -->
                                <div class="rounded-xl border border-slate-700/50 overflow-hidden">
                                    <div class="flex items-center justify-between px-4 py-3 bg-red-500/5 border-b border-slate-700/30">
                                        <h6 class="text-sm font-medium text-slate-300 flex items-center gap-2">
                                            <i class="fas fa-ban text-red-400"></i>Block VPN/Proxy Players
                                        </h6>
                                        <label class="relative inline-flex items-center cursor-pointer">
                                            <input type="checkbox" @bind="protectionSettings.EnableVpnProtection" class="sr-only peer" />
                                            <div class="w-9 h-5 bg-slate-600 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-red-500"></div>
                                            <span class="ml-2 text-sm text-slate-300">@(protectionSettings.EnableVpnProtection ? "Enabled" : "Disabled")</span>
                                        </label>
                                    </div>
                                    @if (protectionSettings.EnableVpnProtection)
                                    {
                                        <div class="p-4">
                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                                <div>
                                                    <label class="block text-sm font-medium text-slate-300 mb-1">
                                                        <i class="fas fa-gavel mr-1"></i>Action to Take
                                                    </label>
                                                    <select class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500" @bind="protectionSettings.VpnProtectionAction">
                                                        <option value="@VpnProtectionAction.Kick">Kick Player (temporary removal)</option>
                                                        <option value="@VpnProtectionAction.Ban">Ban Player (use ban duration)</option>
                                                    </select>
                                                </div>
                                                <div class="rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-400 px-4 py-3 text-sm self-end">
                                                    <i class="fas fa-exclamation-triangle mr-2"></i>
                                                    <small>Players using a VPN or proxy will be automatically kicked or banned. Players on the exempt list are not affected.</small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="rounded-lg bg-slate-500/10 border border-slate-500/30 text-slate-400 px-4 py-3 text-sm mb-0">
                                    <small><i class="fas fa-toggle-off mr-2"></i>Enable this to check player IPs for VPN/proxy usage on connect.</small>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Ignore Protection Rules Card -->
                    <div class="rounded-xl border border-slate-700/50 overflow-hidden mb-4">
                        <div class="flex items-center justify-between px-4 py-3 bg-emerald-500/10 border-b border-emerald-500/20">
                            <h6 class="text-sm font-semibold text-emerald-400 flex items-center gap-2">
                                <i class="fas fa-user-shield"></i>Ignore Protection Rules for SteamID's
                            </h6>
                        </div>
                        <div class="p-4">
                            <p class="text-slate-400 text-sm mb-3">
                                <small>Players on this list bypass ALL protection checks (country filter, VAC bans, public bans) and can always join. When <strong class="text-slate-300">Whitelist-Only</strong> mode is active, <strong class="text-slate-300">only</strong> players on this list are allowed to connect.</small>
                            </p>

                            <div class="rounded-lg bg-blue-500/10 border border-blue-500/30 text-blue-400 px-4 py-3 text-sm mb-3">
                                <small>
                                    <i class="fas fa-info-circle mr-2"></i>
                                    <strong>Tip:</strong> Add server admins, trusted players, and VIPs here. In Whitelist-Only mode this list also acts as the full access list — anyone not listed will be kicked.
                                </small>
                            </div>

                            <div class="space-y-2 mb-3">
                                <div class="flex">
                                    <span class="flex items-center px-3 bg-slate-800 border border-r-0 border-slate-700 rounded-l-lg text-slate-400">
                                        <i class="fas fa-id-card"></i>
                                    </span>
                                    <input type="text"
                                           class="flex-1 bg-slate-800/50 border border-slate-700 rounded-r-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500"
                                           placeholder="SteamID64 (e.g., 76561198000000001)"
                                           @bind="newWhitelistSteamId"
                                           @onkeypress="HandleWhitelistKeyPress" />
                                </div>
                                <div class="flex">
                                    <span class="flex items-center px-3 bg-slate-800 border border-r-0 border-slate-700 rounded-l-lg text-slate-400">
                                        <i class="fas fa-comment-alt"></i>
                                    </span>
                                    <input type="text"
                                           class="flex-1 bg-slate-800/50 border border-slate-700 px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500"
                                           placeholder="Reason / comment (e.g., Admin, VIP) — optional"
                                           @bind="newWhitelistComment" />
                                    <button class="px-3 py-2 bg-emerald-500 hover:bg-emerald-600 text-white text-sm rounded-r-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                            type="button"
                                            @onclick="AddWhitelistSteamId"
                                            disabled="@(string.IsNullOrWhiteSpace(newWhitelistSteamId))">
                                        <i class="fas fa-plus mr-1"></i>Add
                                    </button>
                                </div>
                            </div>

                            <!-- Ignored SteamIDs -->
                            @if (protectionSettings.WhitelistedSteamIds.Any())
                            {
                                <div class="border border-emerald-500/30 bg-emerald-500/5 rounded-lg p-3">
                                    <label class="block text-sm font-medium text-slate-300 mb-3">
                                        <i class="fas fa-list text-emerald-400 mr-2"></i>Ignored SteamIDs (@protectionSettings.WhitelistedSteamIds.Count)
                                    </label>
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var entry in protectionSettings.WhitelistedSteamIds)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-400">
                                                <i class="fas fa-shield-alt"></i>
                                                <span>
                                                    @entry.SteamId
                                                    @if (!string.IsNullOrWhiteSpace(entry.Comment))
                                                    {
                                                        <span class="text-slate-400 ml-1">(@entry.Comment)</span>
                                                    }
                                                </span>
                                                <button type="button" class="ml-1 hover:text-white transition-colors" @onclick='() => RemoveWhitelistSteamId(entry.SteamId)'>
                                                    <i class="fas fa-times text-[10px]"></i>
                                                </button>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="rounded-lg bg-slate-500/10 border border-slate-500/30 text-slate-400 px-4 py-3 text-sm mb-0">
                                    <small><i class="fas fa-info-circle mr-2"></i>No SteamIDs added. All players will be subject to protection rules.</small>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Save Button -->
                    <div class="flex justify-end gap-2">
                        <button class="bg-orange-500 hover:bg-orange-600 text-white font-medium py-2 px-4 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                @onclick="SaveProtectionSettings"
                                disabled="@protectionSaving">
                            @if (protectionSaving)
                            {
                                <i class="fas fa-spinner fa-spin mr-2"></i>
                            }
                            else
                            {
                                <i class="fas fa-save mr-2"></i>
                            }
                            Save Protection Settings
                        </button>
                    </div>

                    <!-- Messages -->
                    @if (!string.IsNullOrEmpty(protectionSuccessMessage))
                    {
                        <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-4 py-3 text-sm mt-3 mb-0">
                            <i class="fas fa-check-circle mr-2"></i>@protectionSuccessMessage
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(protectionErrorMessage))
                    {
                        <div class="rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 text-sm mt-3 mb-0">
                            <i class="fas fa-exclamation-circle mr-2"></i>@protectionErrorMessage
                        </div>
                    }
                }
        </TwCard>
    }
    else if (activeTab == "webhooks")
    {
        <TwCard HeaderTitle="Discord Webhooks" HeaderIcon="fas fa-bell">
                @if (webhooksLoading)
                {
                    <div class="text-center py-5">
                        <div class="tw-spinner"></div>
                        <p class="mt-3 text-slate-400">Loading webhook settings...</p>
                    </div>
                }
                else if (webhookSettings != null)
                {
                    <p class="text-slate-400 text-sm mb-4">
                        <i class="fas fa-info-circle mr-2"></i>Configure Discord webhooks to receive real-time notifications for server events.
                    </p>

                    <!-- Player Connect Webhook -->
                    <div class="rounded-lg border border-slate-700/50 overflow-hidden mb-3">
                        <button class="w-full flex items-center justify-between px-4 py-3 bg-slate-800/50 hover:bg-slate-800 transition-colors text-left"
                                @onclick='() => ToggleWebhookSection("playerConnect")'>
                            <div class="flex items-center gap-2">
                                <i class="fas fa-user-plus text-emerald-400"></i>
                                <span class="text-sm font-semibold text-white">Player Connect</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <div @onclick:stopPropagation="true">
                                    <label class="relative inline-flex items-center cursor-pointer">
                                        <input type="checkbox" @bind="webhookSettings.EnablePlayerConnectWebhook" class="sr-only peer" />
                                        <div class="w-9 h-5 bg-slate-600 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-500"></div>
                                        <span class="ml-2 text-xs text-slate-300">@(webhookSettings.EnablePlayerConnectWebhook ? "Enabled" : "Disabled")</span>
                                    </label>
                                </div>
                                <i class="fas fa-chevron-down text-slate-400 text-xs transition-transform @(IsWebhookExpanded("playerConnect") ? "rotate-180" : "")"></i>
                            </div>
                        </button>
                        @if (IsWebhookExpanded("playerConnect"))
                        {
                            <div class="px-4 py-4 border-t border-slate-700/50">
                            <div class="mb-3">
                                <label class="block text-sm font-medium text-slate-300 mb-1"><i class="fab fa-discord mr-2"></i>Discord Webhook URL</label>
                                <input type="text" class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500" placeholder="https://discord.com/api/webhooks/..."
                                       @bind="webhookSettings.PlayerConnectWebhookUrl"
                                       disabled="@(!webhookSettings.EnablePlayerConnectWebhook)">
                                <small class="text-xs text-slate-500 mt-1">Triggered when a player connects to the server.</small>
                            </div>

                            <div class="mb-3">
                                <label class="block text-sm font-medium text-slate-300 mb-1"><i class="fas fa-cogs mr-2"></i>Format</label>
                                <select class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500" @bind="webhookSettings.PlayerConnectFormat"
                                        disabled="@(!webhookSettings.EnablePlayerConnectWebhook)">
                                    <option value="@WebhookFormat.Text">Text (Simple message)</option>
                                    <option value="@WebhookFormat.Embed">Embed (Default rich embed)</option>
                                    <option value="@WebhookFormat.Custom">Custom (JSON with variables)</option>
                                </select>
                            </div>

                            @if (webhookSettings.PlayerConnectFormat == WebhookFormat.Text && webhookSettings.EnablePlayerConnectWebhook)
                            {
                                <div class="mb-3">
                                    <label class="block text-sm font-medium text-slate-300 mb-1"><i class="fas fa-align-left mr-2"></i>Text Message</label>
                                    <input type="text" class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500"
                                           @bind="webhookSettings.PlayerConnectTextContent"
                                           placeholder="**{playerName}** joined {serverName}"
                                           disabled="@(!webhookSettings.EnablePlayerConnectWebhook)">
                                    <small class="text-xs text-slate-500 mt-1">
                                        <strong>Available variables:</strong> {playerName}, {steamId}, {ipAddress}, {country}, {serverName}
                                    </small>
                                </div>
                            }

                            @if (webhookSettings.PlayerConnectFormat == WebhookFormat.Custom && webhookSettings.EnablePlayerConnectWebhook)
                            {
                                <div class="mb-3">
                                    <label class="block text-sm font-medium text-slate-300 mb-1"><i class="fas fa-code mr-2"></i>Custom Content (JSON)</label>
                                    <textarea class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500 font-mono" rows="8"
                                              @bind="webhookSettings.PlayerConnectCustomContent"
                                              placeholder='{"content": "{playerName} joined {serverName}"}'
                                              disabled="@(!webhookSettings.EnablePlayerConnectWebhook)"></textarea>
                                    <small class="text-xs text-slate-500 mt-1">
                                        <strong>Available variables:</strong> {playerName}, {steamId}, {ipAddress}, {country}, {serverName}
                                    </small>
                                </div>
