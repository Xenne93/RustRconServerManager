@code {
    private string activeTab = "settings";
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;
    private string? successMessage;
    private ServerSettings_DTO serverSettings = new ServerSettings_DTO();

    // Image upload state
    private bool isUploadingHeader = false;
    private bool isUploadingLogo = false;

    // Permissions Manager state
    private bool permissionsLoading = false;
    private string? permissionsErrorMessage;
    private List<PermissionGroupDTO> permissionGroups = new();
    private string? loadingGroupPlayers = null;
    private string? removingPlayer = null;
    private string? addingPlayer = null;
    private Dictionary<string, string> searchTerms = new();
    private Dictionary<string, List<PlayerSearchResultDTO>> searchResults = new();
    private System.Threading.Timer? searchDebounceTimer;

    // Mods state
    private bool modsLoading = false;
    private string? modsErrorMessage;
    private Mods_ResponseDTO modsResponse = new();
    private List<PluginDTO> plugins = new();
    private Dictionary<string, PluginVersionCheckResult> pluginVersions = new();
    private Dictionary<string, PluginSource?> pluginSources = new(); // Track plugin sources (Umod/Codefling/Custom/null)
    private HashSet<string> checkingVersions = new();
    private HashSet<string> notFoundPlugins = new(); // Plugins that truly don't exist (404 from all sources)
    private bool loadingVersions = false; // Loading state for batch version check
    private string? reloadingPlugin = null;
    private string? unloadingPlugin = null;
    private bool reloadingAll = false;

    // Sorting state
    private string? sortColumn = null;
    private bool sortAscending = true;

    // Webhook collapsible sections state
    private HashSet<string> expandedWebhookSections = new() { "playerConnect" };
    private void ToggleWebhookSection(string section)
    {
        if (!expandedWebhookSections.Add(section))
            expandedWebhookSections.Remove(section);
    }
    private bool IsWebhookExpanded(string section) => expandedWebhookSections.Contains(section);

    // Permissions accordion state
    private HashSet<string> expandedPermissionGroups = new();
    private void TogglePermissionGroup(string group)
    {
        if (!expandedPermissionGroups.Add(group))
            expandedPermissionGroups.Remove(group);
    }
    private bool IsPermissionGroupExpanded(string group) => expandedPermissionGroups.Contains(group);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Validate server access
            bool hasAccess = await ServerValidationHelper.ValidateActiveServerAsync();
            if (!hasAccess)
            {
                return; // ServerValidationHelper handles navigation
            }

            // Load server settings from RCON
            await LoadServerSettings();

            // Pre-load permission groups in the background for faster tab switching
            _ = LoadPermissionGroups();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading server settings: {ex.Message}";
            Console.WriteLine($"Error in ServerSettings.OnInitializedAsync: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadServerSettings()
    {
        try
        {
            isLoading = true;
            errorMessage = null;



            var response = await Http.GetAsync("/api/ServerSettings/GetSettings");

            if (response.IsSuccessStatusCode)
            {
                var settings = await response.Content.ReadFromJsonAsync<ServerSettings_DTO>();
                if (settings != null)
                {
                    // Convert \n to actual newlines for the textarea
                    settings.ServerDescription = settings.ServerDescription.Replace("\\n", "\n");
                    serverSettings = settings;
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to load server settings: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading server settings: {ex.Message}";
            Console.WriteLine($"Error in LoadServerSettings: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveSettings()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            successMessage = null;



            // Convert actual newlines to \n for Rust server compatibility
            var updateDto = new ServerSettings_UpdateDTO
            {
                ServerHostname = serverSettings.ServerHostname,
                ServerDescription = serverSettings.ServerDescription.Replace("\r\n", "\\n").Replace("\n", "\\n"),
                ServerUrl = serverSettings.ServerUrl,
                ServerHeaderImage = serverSettings.ServerHeaderImage,
                ServerLogoImage = serverSettings.ServerLogoImage,
                MaxPlayers = serverSettings.MaxPlayers
            };

            var response = await Http.PostAsJsonAsync("/api/ServerSettings/UpdateSettings", updateDto);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Server settings updated successfully!";
                // Reload settings to confirm changes
                await LoadServerSettings();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to update server settings: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving server settings: {ex.Message}";
            Console.WriteLine($"Error in SaveSettings: {ex}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UploadHeaderImage(InputFileChangeEventArgs e)
    {
        await UploadServerImage(e, "UploadHeaderImage", isHeader: true);
    }

    private async Task UploadLogoImage(InputFileChangeEventArgs e)
    {
        await UploadServerImage(e, "UploadLogoImage", isHeader: false);
    }

    private async Task UploadServerImage(InputFileChangeEventArgs e, string endpoint, bool isHeader)
    {
        var file = e.File;
        if (file == null) return;

        // Validate file size (max 10MB)
        if (file.Size > 10 * 1024 * 1024)
        {
            errorMessage = "File size must be less than 10MB.";
            return;
        }

        try
        {
            if (isHeader)
                isUploadingHeader = true;
            else
                isUploadingLogo = true;

            errorMessage = null;
            StateHasChanged();



            using var content = new MultipartFormDataContent();
            using var fileStream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await fileStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var fileContent = new StreamContent(memoryStream);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync($"/api/ServerImages/{endpoint}", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ImageUploadResponse>();
                if (result != null && !string.IsNullOrEmpty(result.Url))
                {
                    // Get the full URL including the host
                    var baseUrl = Nav.BaseUri.TrimEnd('/');
                    var fullUrl = baseUrl + result.Url;

                    if (isHeader)
                        serverSettings.ServerHeaderImage = fullUrl;
                    else
                        serverSettings.ServerLogoImage = fullUrl;

                    successMessage = "Image uploaded successfully. Don't forget to save your settings!";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to upload image: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading image: {ex.Message}";
            Console.WriteLine($"Error in UploadServerImage: {ex}");
        }
        finally
        {
            if (isHeader)
                isUploadingHeader = false;
            else
                isUploadingLogo = false;
            StateHasChanged();
        }
    }

