    private void SortPlugins(string column)
    {
        if (sortColumn == column)
        {
            // Toggle direction if clicking same column
            sortAscending = !sortAscending;
        }
        else
        {
            // New column - default to ascending
            sortColumn = column;
            sortAscending = true;
        }
        StateHasChanged();
    }

    private List<PluginDTO> GetSortedPlugins()
    {
        if (string.IsNullOrEmpty(sortColumn))
        {
            return plugins;
        }

        IEnumerable<PluginDTO> sorted = sortColumn switch
        {
            "Name" => sortAscending
                ? plugins.OrderBy(p => p.Name)
                : plugins.OrderByDescending(p => p.Name),

            "Version" => sortAscending
                ? plugins.OrderBy(p => ParseVersion(p.Version))
                : plugins.OrderByDescending(p => ParseVersion(p.Version)),

            "Latest" => sortAscending
                ? plugins.OrderBy(p => GetLatestVersionForSorting(p))
                : plugins.OrderByDescending(p => GetLatestVersionForSorting(p)),

            "LoadTime" => sortAscending
                ? plugins.OrderBy(p => ParseLoadTime(p.LoadTime))
                : plugins.OrderByDescending(p => ParseLoadTime(p.LoadTime)),

            "Memory" => sortAscending
                ? plugins.OrderBy(p => ParseMemory(p.MemoryUsage))
                : plugins.OrderByDescending(p => ParseMemory(p.MemoryUsage)),

            _ => plugins
        };

        return sorted.ToList();
    }

    private Version ParseVersion(string versionString)
    {
        // Parse version string like "1.2.3" to Version object for proper sorting
        if (Version.TryParse(versionString, out var version))
        {
            return version;
        }
        return new Version(0, 0, 0);
    }

    private string GetLatestVersionForSorting(PluginDTO plugin)
    {
        var pluginName = (plugin.FileName ?? "").Replace(".cs", "");
        var versionInfo = GetPluginVersionInfo(pluginName);
        return versionInfo?.LatestVersion ?? "0.0.0";
    }

    private double ParseLoadTime(string loadTime)
    {
        // Parse load time like "12.5ms" or "1.2s" to milliseconds
        if (string.IsNullOrEmpty(loadTime) || loadTime == "-")
            return 0;

        var original = loadTime.ToLower();
        var isSeconds = original.Contains("s") && !original.Contains("ms");

        // Remove units
        loadTime = original.Replace("ms", "").Replace("s", "").Trim();

        if (double.TryParse(loadTime, out var time))
        {
            // Convert seconds to milliseconds
            return isSeconds ? time * 1000 : time;
        }
        return 0;
    }

    private double ParseMemory(string memory)
    {
        // Parse memory like "1.5 MB" or "512 KB" to KB
        if (string.IsNullOrEmpty(memory) || memory == "-")
            return 0;

        var original = memory.ToUpper();
        var isMegabytes = original.Contains("MB");

        // Remove units
        memory = original.Replace("MB", "").Replace("KB", "").Trim();

        if (double.TryParse(memory, out var size))
        {
            // Convert MB to KB
            return isMegabytes ? size * 1024 : size;
        }
        return 0;
    }


