                                               min="0"
                                               @bind="protectionSettings.MaxVacBans" />
                                        <small class="text-xs text-slate-500 mt-1 block">Block players with more than this many VAC bans (0 = disabled)</small>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-slate-300 mb-1">
                                            <i class="fas fa-calendar-day mr-1"></i>Min. Days Since Last VAC Ban
                                        </label>
                                        <input type="number"
                                               class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500"
                                               min="0"
                                               @bind="protectionSettings.MinDaysSinceLastVACBan" />
                                        <small class="text-xs text-slate-500 mt-1 block">Block players whose last VAC ban is less than X days old (0 = disabled)</small>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-slate-300 mb-1">
                                            <i class="fas fa-gavel mr-1"></i>Action to Take
                                        </label>
                                        <select class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500" @bind="protectionSettings.VacBanAction">
                                            <option value="@VacBanAction.Kick">Kick Player (temporary removal)</option>
                                            <option value="@VacBanAction.Ban">Ban Player (use ban duration)</option>
                                        </select>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="rounded-lg bg-slate-500/10 border border-slate-500/30 text-slate-400 px-4 py-3 text-sm mb-0">
                                    <small><i class="fas fa-toggle-off mr-2"></i>Enable this protection to prevent players with VAC bans from joining.</small>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Private Steam Profile Protection Card -->
