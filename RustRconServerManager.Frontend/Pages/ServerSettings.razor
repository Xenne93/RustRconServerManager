@page "/server-management"
@using Microsoft.AspNetCore.Authorization
@using RustRconServerManager.Frontend.Components.Layout
@using RustRconServerManager.Frontend.Components.Auth
@using RustRconServerManager.Frontend.Services
@using RustRconServerManager.Shared.ServerSettings
@using RustRconServerManager.Shared.PermissionsManager
@using RustRconServerManager.Shared.Mods
@using RustRconServerManager.Shared.ServerProtection
@using RustRconServerManager.Shared.ServerWebhooks
@using RustRconServerManager.Shared.PluginVersionCheck
@inject HttpClient Http
@inject NavigationManager Nav
@inject ServerValidationHelper ServerValidationHelper
@inject IJSRuntime JSRuntime
@implements IDisposable

@attribute [Authorize]

<PageAccessGuard PageRoute="server-management">
<ContentWrapper>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
        <h3 class="text-xl font-semibold text-white">Server Management</h3>
    </div>

    <!-- Tab Navigation -->
    <div class="flex flex-wrap gap-1 border-b border-slate-700/50 mb-6">
        <button class="px-4 py-2.5 text-sm font-medium transition-colors rounded-t-lg @(activeTab == "settings" ? "text-orange-400 border-b-2 border-orange-400 bg-slate-800/50" : "text-slate-400 hover:text-white")"
                type="button"
                @onclick='() => activeTab = "settings"'>
            <i class="fas fa-cog mr-2"></i>Server Settings
        </button>
        <button class="px-4 py-2.5 text-sm font-medium transition-colors rounded-t-lg @(activeTab == "permissions" ? "text-orange-400 border-b-2 border-orange-400 bg-slate-800/50" : "text-slate-400 hover:text-white")"
                type="button"
                @onclick="SwitchToPermissionsTab">
            <i class="fas fa-user-shield mr-2"></i>Permissions Manager
        </button>
        <button class="px-4 py-2.5 text-sm font-medium transition-colors rounded-t-lg @(activeTab == "mods" ? "text-orange-400 border-b-2 border-orange-400 bg-slate-800/50" : "text-slate-400 hover:text-white")"
                type="button"
                @onclick="SwitchToModsTab">
            <i class="fas fa-puzzle-piece mr-2"></i>Mods
        </button>
        <button class="px-4 py-2.5 text-sm font-medium transition-colors rounded-t-lg @(activeTab == "protection" ? "text-orange-400 border-b-2 border-orange-400 bg-slate-800/50" : "text-slate-400 hover:text-white")"
                type="button"
                @onclick="SwitchToProtectionTab">
            <i class="fas fa-shield-alt mr-2"></i>Server Protection
        </button>
        <button class="px-4 py-2.5 text-sm font-medium transition-colors rounded-t-lg @(activeTab == "webhooks" ? "text-orange-400 border-b-2 border-orange-400 bg-slate-800/50" : "text-slate-400 hover:text-white")"
                type="button"
                @onclick="SwitchToWebhooksTab">
            <i class="fas fa-bell mr-2"></i>Discord Webhooks
        </button>
    </div>

    <!-- Tab Content -->
    @if (activeTab == "settings")
    {
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="tw-spinner"></div>
                <p class="mt-3 text-slate-400">Loading server settings...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 text-sm" role="alert">
                <i class="fas fa-exclamation-triangle mr-2"></i>@errorMessage
            </div>
        }
        else
        {
        <TwCard HeaderTitle="Server Details" HeaderIcon="fas fa-info-circle">
                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-4 py-3 text-sm flex items-center justify-between" role="alert">
                                <span><i class="fas fa-check-circle mr-2"></i>@successMessage</span>
                                <button type="button" class="text-emerald-400 hover:text-white transition-colors" @onclick="() => successMessage = null">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }

                        <form>
                            <!-- Basic Information Section -->
                            <h6 class="text-sm font-semibold text-white mb-3 flex items-center gap-2">
                                <i class="fas fa-tag text-orange-400"></i>Basic Information
                            </h6>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="mb-3">
                                    <label for="serverHostname" class="block text-sm font-medium text-slate-300 mb-1">Server Name</label>
                                    <input type="text"
                                           class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500"
                                           id="serverHostname"
                                           @bind="serverSettings.ServerHostname"
                                           @bind:event="oninput"
                                           placeholder="Enter server name"
                                           disabled="@isSaving" />
                                    <small class="text-xs text-slate-500 mt-1">server.hostname</small>
                                </div>

                                <div class="mb-3">
                                    <label for="maxPlayers" class="block text-sm font-medium text-slate-300 mb-1">Maximum Players</label>
                                    <input type="number"
                                           class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500"
                                           id="maxPlayers"
                                           @bind="serverSettings.MaxPlayers"
                                           @bind:event="oninput"
                                           min="0"
                                           max="1000"
                                           placeholder="Enter max players"
                                           disabled="@isSaving" />
                                    <small class="text-xs text-slate-500 mt-1">server.maxplayers</small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="serverDescription" class="block text-sm font-medium text-slate-300 mb-1">Server Description</label>
                                <textarea class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500"
                                          id="serverDescription"
                                          rows="5"
                                          @bind="serverSettings.ServerDescription"
                                          @bind:event="oninput"
                                          placeholder="Enter server description (use Enter for new lines)"
                                          disabled="@isSaving"></textarea>
                                <small class="text-xs text-slate-500 mt-1">server.description - Press Enter for new lines</small>
                            </div>

                            <hr class="my-4 border-slate-700/50" />

                            <!-- Branding Section -->
                            <h6 class="text-sm font-semibold text-white mb-3 flex items-center gap-2">
                                <i class="fas fa-image text-orange-400"></i>Branding & Links
                            </h6>

                            <div class="mb-3">
                                <label for="serverUrl" class="block text-sm font-medium text-slate-300 mb-1">Server Website</label>
                                <div class="flex">
                                    <span class="flex items-center px-3 bg-slate-800 border border-r-0 border-slate-700 rounded-l-lg text-slate-400">
                                        <i class="fas fa-globe"></i>
                                    </span>
                                    <input type="url"
                                           class="flex-1 bg-slate-800/50 border border-slate-700 rounded-r-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500"
                                           id="serverUrl"
                                           @bind="serverSettings.ServerUrl"
                                           @bind:event="oninput"
                                           placeholder="https://yourwebsite.com"
                                           disabled="@isSaving" />
                                </div>
                                <small class="text-xs text-slate-500 mt-1">server.url</small>
                            </div>

                            <div class="flex items-start gap-3 rounded-lg bg-blue-500/5 border border-blue-500/20 px-4 py-3 mb-3">
                                <i class="fas fa-info-circle text-blue-400 mt-0.5"></i>
                                <p class="text-sm text-slate-300">Uploading an image only works when the panel is facing public (reachable from the internet) - the uploaded file is served by the panel itself, so Steam/Rust+ can only load it if your panel has a public URL. If your panel isn't public, enter a URL to an image hosted elsewhere instead.</p>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="mb-3">
                                    <label for="serverHeaderImage" class="block text-sm font-medium text-slate-300 mb-1">Serverlist Image</label>
                                    <div class="flex">
                                        <span class="flex items-center px-3 bg-slate-800 border border-r-0 border-slate-700 rounded-l-lg text-slate-400">
                                            <i class="fas fa-image"></i>
                                        </span>
                                        <input type="text"
                                               class="flex-1 bg-slate-800/50 border border-slate-700 px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500"
                                               id="serverHeaderImage"
                                               @bind="serverSettings.ServerHeaderImage"
                                               @bind:event="oninput"
                                               placeholder="https://yourwebsite.com/header.png"
                                               disabled="@isSaving" />
                                        <label class="flex items-center px-3 py-2 bg-orange-500 hover:bg-orange-600 text-white text-sm cursor-pointer transition-colors @(!string.IsNullOrEmpty(serverSettings.ServerHeaderImage) ? "" : "rounded-r-lg")" for="headerImageUpload" title="Upload custom image">
                                            @if (isUploadingHeader)
                                            {
                                                <i class="fas fa-spinner fa-spin"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-upload"></i>
                                            }
                                        </label>
                                        <InputFile id="headerImageUpload" OnChange="UploadHeaderImage" accept="image/jpeg,image/png,image/webp" style="display: none;" disabled="@(isSaving || isUploadingHeader)" />
                                        @if (!string.IsNullOrEmpty(serverSettings.ServerHeaderImage))
                                        {
                                            <button type="button" class="flex items-center px-3 py-2 bg-red-500 hover:bg-red-600 text-white text-sm rounded-r-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed" @onclick="DeleteHeaderImage" disabled="@(isSaving || isUploadingHeader)" title="Remove image">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                    <small class="text-xs text-slate-500 mt-1">server.headerimage - Upload your own image or enter a URL</small>
                                </div>

                                <div class="mb-3">
                                    <label for="serverLogoImage" class="block text-sm font-medium text-slate-300 mb-1">Rust+ Logo Image</label>
                                    <div class="flex">
                                        <span class="flex items-center px-3 bg-slate-800 border border-r-0 border-slate-700 rounded-l-lg text-slate-400">
                                            <i class="fas fa-mobile-alt"></i>
                                        </span>
                                        <input type="text"
                                               class="flex-1 bg-slate-800/50 border border-slate-700 px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500"
                                               id="serverLogoImage"
                                               @bind="serverSettings.ServerLogoImage"
                                               @bind:event="oninput"
                                               placeholder="https://yourwebsite.com/logo.png"
                                               disabled="@isSaving" />
                                        <label class="flex items-center px-3 py-2 bg-orange-500 hover:bg-orange-600 text-white text-sm cursor-pointer transition-colors @(!string.IsNullOrEmpty(serverSettings.ServerLogoImage) ? "" : "rounded-r-lg")" for="logoImageUpload" title="Upload custom image">
                                            @if (isUploadingLogo)
                                            {
                                                <i class="fas fa-spinner fa-spin"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-upload"></i>
                                            }
                                        </label>
                                        <InputFile id="logoImageUpload" OnChange="UploadLogoImage" accept="image/jpeg,image/png,image/webp" style="display: none;" disabled="@(isSaving || isUploadingLogo)" />
                                        @if (!string.IsNullOrEmpty(serverSettings.ServerLogoImage))
                                        {
                                            <button type="button" class="flex items-center px-3 py-2 bg-red-500 hover:bg-red-600 text-white text-sm rounded-r-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed" @onclick="DeleteLogoImage" disabled="@(isSaving || isUploadingLogo)" title="Remove image">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                    <small class="text-xs text-slate-500 mt-1">server.logoimage - Upload your own image or enter a URL</small>
                                </div>
                            </div>

                            <hr class="my-4 border-slate-700/50" />

                            <!-- Action Buttons -->
                            <div class="flex gap-2">
                                <button type="button"
                                        class="bg-orange-500 hover:bg-orange-600 text-white font-medium py-2 px-4 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                        @onclick="SaveSettings"
                                        disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <i class="fas fa-spinner fa-spin mr-2"></i>
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-save mr-2"></i>
                                        <span>Save Changes</span>
                                    }
                                </button>
                                <button type="button"
                                        class="bg-slate-700 hover:bg-slate-600 text-slate-300 font-medium py-2 px-4 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                        @onclick="LoadServerSettings"
                                        disabled="@(isSaving || isLoading)">
                                    <i class="fas fa-sync-alt mr-2"></i>Refresh
                                </button>
                            </div>
                        </form>
        </TwCard>
        }
    }
    else if (activeTab == "permissions")
    {
        <!-- Permissions Manager Tab Content -->
        <TwCard>
            <HeaderContent>
                <div class="flex items-center justify-between w-full">
                    <div class="flex items-center gap-2">
                        <i class="fas fa-user-shield text-orange-400"></i>
                        <span class="text-sm font-semibold text-white">Permissions Manager</span>
                    </div>
                    <button type="button" class="bg-orange-500 hover:bg-orange-600 text-white text-xs font-medium py-1 px-2 rounded-lg transition-colors" @onclick="LoadPermissionGroups">
                        <i class="fas fa-sync-alt mr-2"></i>Refresh Groups
                    </button>
                </div>
            </HeaderContent>
            <ChildContent>
                        @if (permissionsLoading)
                        {
                            <div class="text-center py-5">
                                <div class="tw-spinner"></div>
                                <p class="mt-3 text-slate-400">Loading permission groups...</p>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(permissionsErrorMessage))
                        {
                            <div class="rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 text-sm" role="alert">
                                <i class="fas fa-exclamation-triangle mr-2"></i>@permissionsErrorMessage
                            </div>
                            <button type="button" class="bg-orange-500 hover:bg-orange-600 text-white font-medium py-2 px-4 rounded-lg transition-colors mt-3" @onclick="LoadPermissionGroups">
                                <i class="fas fa-sync-alt mr-2"></i>Try Again
                            </button>
                        }
                        else if (permissionGroups == null || !permissionGroups.Any())
                        {
                            <div class="rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-400 px-4 py-3 text-sm" role="alert">
                                <i class="fas fa-info-circle mr-2"></i>
                                <strong>No permission groups found.</strong> Make sure your server has Oxide or Carbon installed.
                            </div>
                        }
                        else
                        {
                            <h6 class="text-sm font-semibold text-white mb-3 flex items-center gap-2">
                                <i class="fas fa-users text-orange-400"></i>Permission Groups (@permissionGroups.Count)
                            </h6>

                            <div class="space-y-3">
                                @foreach (var group in permissionGroups)
                                {
                                    <div class="rounded-lg border border-slate-700/50 overflow-hidden">
                                        <button class="w-full flex items-center justify-between px-4 py-3 bg-slate-800/50 hover:bg-slate-800 transition-colors text-left"
                                                @onclick="() => { TogglePermissionGroup(group.GroupName); LoadGroupPlayers(group.GroupName); }">
                                            <div class="flex items-center gap-2">
                                                <i class="fas fa-users text-orange-400"></i>
                                                <strong class="text-white">@group.GroupName</strong>
                                            </div>
                                            <div class="flex items-center gap-3">
                                                <TwBadge Variant="info">@(group.Players?.Count ?? 0) players</TwBadge>
                                                <i class="fas fa-chevron-down text-slate-400 text-xs transition-transform @(IsPermissionGroupExpanded(group.GroupName) ? "rotate-180" : "")"></i>
                                            </div>
                                        </button>
                                        @if (IsPermissionGroupExpanded(group.GroupName))
                                        {
                                            <div class="px-4 py-4 border-t border-slate-700/50">
                                                <div class="mb-3">
                                                    <h6 class="text-sm font-semibold text-white">Group: @group.GroupName</h6>
                                                    <p class="text-slate-400 text-sm mb-2">
                                                        <i class="fas fa-users mr-1"></i> @group.PlayerCount player(s) in this group
                                                    </p>
                                                </div>

                                                <div class="mb-3">
                                                    <h6 class="text-sm font-semibold text-white mb-2">Add Player to Group</h6>
                                                    <div class="flex mb-2">
                                                        <input type="text"
                                                               class="flex-1 bg-slate-800/50 border border-slate-700 rounded-l-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500"
                                                               placeholder="Search by Steam ID or player name"
                                                               value="@(searchTerms.GetValueOrDefault(group.GroupName) ?? string.Empty)"
                                                               @oninput="(e) => OnSearchInput(e, group.GroupName)">
                                                        <button class="bg-orange-500 hover:bg-orange-600 text-white text-sm font-medium py-2 px-3 rounded-r-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                                                type="button"
                                                                @onclick="() => AddPlayerDirectly(group.GroupName)"
                                                                disabled="@(string.IsNullOrWhiteSpace(searchTerms.GetValueOrDefault(group.GroupName)) || addingPlayer == group.GroupName)">
                                                            @if (addingPlayer == group.GroupName)
                                                            {
                                                                <i class="fas fa-spinner fa-spin mr-1"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="fas fa-user-plus mr-1"></i>
                                                            }
                                                            Add
                                                        </button>
                                                    </div>

                                                    @* Search results dropdown *@
                                                    @if (searchResults.ContainsKey(group.GroupName) && searchResults[group.GroupName].Any() && searchTerms.GetValueOrDefault(group.GroupName)?.Length >= 2)
                                                    {
                                                        <div class="rounded-lg border border-slate-700/50 overflow-hidden max-h-[200px] overflow-y-auto mb-2">
                                                            @foreach (var player in searchResults[group.GroupName])
                                                            {
                                                                <button type="button"
                                                                        class="w-full flex items-center justify-between px-3 py-2 text-left text-sm hover:bg-slate-800/50 border-b border-slate-700/30 last:border-b-0 transition-colors"
                                                                        @onclick="() => SelectPlayer(player.SteamId, player.PlayerName, group.GroupName)">
                                                                    <div>
                                                                        <strong class="text-white">@player.PlayerName</strong>
                                                                        <br />
                                                                        <small class="text-xs text-slate-500">@player.SteamId</small>
                                                                    </div>
                                                                    <small class="text-xs text-slate-500">Last seen: @player.LastSeen.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</small>
                                                                </button>
                                                            }
                                                        </div>
                                                    }

                                                    <small class="text-xs text-slate-500">
                                                        <i class="fas fa-info-circle mr-1"></i>
                                                        Search for players or enter a Steam ID directly
                                                    </small>
                                                </div>

                                                <div class="mb-3">
                                                    <h6 class="text-sm font-semibold text-white mb-2">Players in this Group</h6>
                                                    @if (loadingGroupPlayers == group.GroupName)
                                                    {
                                                        <div class="text-center py-3">
                                                            <i class="fas fa-spinner fa-spin text-orange-400"></i>
                                                            <p class="mt-2 mb-0 text-sm text-slate-400">Loading players...</p>
                                                        </div>
                                                    }
                                                    else if (group.Players?.Any() == true)
                                                    {
                                                        <div class="overflow-x-auto">
                                                            <table class="tw-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Player Name</th>
                                                                        <th>Steam ID</th>
                                                                        <th>Actions</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var player in group.Players)
                                                                    {
                                                                        <tr>
                                                                            <td>@player.PlayerName</td>
                                                                            <td>
                                                                                @if (!string.IsNullOrEmpty(player.SteamId))
                                                                                {
                                                                                    <small class="text-xs text-slate-500">@player.SteamId</small>
                                                                                }
                                                                            </td>
                                                                            <td>
                                                                                @{
                                                                                    var isRemoving = removingPlayer == $"{player.SteamId}_{group.GroupName}";
                                                                                }
                                                                                <button class="bg-red-500 hover:bg-red-600 text-white text-xs py-1 px-2 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                                                                        type="button"
                                                                                        @onclick="() => RemovePlayerFromGroup(player.SteamId, player.PlayerName, group.GroupName)"
                                                                                        disabled="@isRemoving">
                                                                                    @if (isRemoving)
                                                                                    {
                                                                                        <i class="fas fa-spinner fa-spin mr-1"></i>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <i class="fas fa-user-minus"></i>
                                                                                    }
                                                                                    Remove
                                                                                </button>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-lg bg-slate-500/10 border border-slate-500/30 text-slate-400 px-4 py-3 text-sm mb-0">
                                                            <small><i class="fas fa-info-circle mr-1"></i>No players in this group</small>
                                                        </div>
                                                    }
                                                </div>

                                                @if (group.Permissions?.Any() == true)
                                                {
                                                    <div class="mt-3">
                                                        <h6 class="text-sm font-semibold text-white mb-2">Permissions</h6>
                                                        <div class="rounded-lg border border-slate-700/50 overflow-hidden">
                                                            @foreach (var permission in group.Permissions)
                                                            {
                                                                <div class="px-3 py-2 border-b border-slate-700/30 last:border-b-0 text-sm text-slate-300">
                                                                    <small>@permission</small>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
            </ChildContent>
        </TwCard>
    }
    else if (activeTab == "mods")
    {
        <ErrorBoundary>
            <ChildContent>
        <TwCard>
            <HeaderContent>
                <div class="flex items-center justify-between w-full">
                    <div class="flex items-center gap-2">
                        <i class="fas fa-puzzle-piece text-orange-400"></i>
                        <span class="text-sm font-semibold text-white">Server Mods & Plugins</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button class="bg-orange-500 hover:bg-orange-600 text-white text-xs font-medium py-1 px-2 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed" @onclick="LoadPlugins" disabled="@modsLoading">
                            @if (modsLoading)
                            {
                                <i class="fas fa-spinner fa-spin mr-1"></i>
                            }
                            else
                            {
                                <i class="fas fa-sync-alt mr-1"></i>
                            }
                            Refresh
                        </button>
                        <button class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium py-1 px-2 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed" @onclick="LoadPluginVersions" disabled="@(modsLoading || loadingVersions || plugins.Count == 0)">
                            @if (loadingVersions)
                            {
                                <i class="fas fa-spinner fa-spin mr-1"></i>
                            }
                            else
                            {
                                <i class="fas fa-arrow-up mr-1"></i>
                            }
                            Check Updates
                        </button>
                        <button class="bg-amber-500 hover:bg-amber-600 text-white text-xs font-medium py-1 px-2 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed" @onclick="ReloadAllPlugins" disabled="@(modsLoading || reloadingAll)">
                            @if (reloadingAll)
                            {
                                <i class="fas fa-spinner fa-spin mr-1"></i>
                            }
                            else
                            {
                                <i class="fas fa-redo mr-1"></i>
                            }
                            Reload All
                        </button>
                    </div>
                </div>
            </HeaderContent>
            <ChildContent>
                @* Static outer div — always in the DOM so Android System WebView's compositor layer
                   exists before plugin content arrives. Creating this div dynamically (inside @if)
                   caused a paint bug on Android WebView where content was invisible. *@
                <div class="overflow-x-auto">
                @if (modsLoading)
                {
                    <div class="text-center py-5">
                        <div class="tw-spinner"></div>
                        <p class="mt-3 text-slate-400">Loading plugins...</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(modsErrorMessage))
                {
                    <div class="rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 text-sm" role="alert">
                        <i class="fas fa-exclamation-triangle mr-2"></i>@modsErrorMessage
                    </div>
                }
                else if (plugins.Count == 0)
                {
                    <div class="rounded-lg bg-blue-500/10 border border-blue-500/30 text-blue-400 px-4 py-3 text-sm" role="alert">
                        <i class="fas fa-info-circle mr-2"></i>
                        <strong>No plugins found.</strong> Make sure your server has Oxide or Carbon installed.
                    </div>
                }
                else
                {
                    <!-- Stats -->
                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-3">
                        <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-4 py-3 text-sm">
                            <i class="fas fa-check-circle mr-2"></i>
                            <strong>Loaded:</strong> @modsResponse.LoadedCount
                        </div>
                        <div class="rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 text-sm">
                            <i class="fas fa-times-circle mr-2"></i>
                            <strong>Failed:</strong> @modsResponse.FailedCount
                        </div>
                        <div class="rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-400 px-4 py-3 text-sm">
                            <i class="fas fa-pause-circle mr-2"></i>
                            <strong>Unloaded:</strong> @modsResponse.UnloadedCount
                        </div>
                        <div class="rounded-lg bg-blue-500/10 border border-blue-500/30 text-blue-400 px-4 py-3 text-sm">
                            <i class="fas fa-arrow-up mr-2"></i>
                            <strong>Outdated:</strong> @GetOutdatedCount()
                        </div>
                        <div class="rounded-lg bg-orange-500/10 border border-orange-500/30 text-orange-400 px-4 py-3 text-sm">
                            <i class="fas fa-list mr-2"></i>
                            <strong>Total:</strong> @modsResponse.TotalCount
                        </div>
                    </div>

                    <!-- Plugins Table -->
                        <table class="tw-table">
                            <thead>
                                <tr>
                                    <th style="width: 4%;">#</th>
                                    <th style="width: 7%;">Status</th>
                                    <th style="width: 18%; cursor: pointer;" @onclick='() => SortPlugins("Name")'>
                                        Name
                                        @if (sortColumn == "Name")
                                        {
                                            <i class="fas fa-sort-@(sortAscending ? "up" : "down") ml-1"></i>
                                        }
                                    </th>
                                    <th style="width: 7%; cursor: pointer;" @onclick='() => SortPlugins("Version")'>
                                        Version
                                        @if (sortColumn == "Version")
                                        {
                                            <i class="fas fa-sort-@(sortAscending ? "up" : "down") ml-1"></i>
                                        }
                                    </th>
                                    <th style="width: 11%; cursor: pointer;" @onclick='() => SortPlugins("Latest")'>
                                        Latest
                                        @if (sortColumn == "Latest")
                                        {
                                            <i class="fas fa-sort-@(sortAscending ? "up" : "down") ml-1"></i>
                                        }
                                    </th>
                                    <th style="width: 10%;" title="Plugin source (Umod/Codefling/Custom)">Source</th>
                                    <th style="width: 11%;">Author</th>
                                    <th style="width: 7%; cursor: pointer;" @onclick='() => SortPlugins("LoadTime")'>
                                        Load Time
                                        @if (sortColumn == "LoadTime")
                                        {
                                            <i class="fas fa-sort-@(sortAscending ? "up" : "down") ml-1"></i>
                                        }
                                    </th>
                                    <th style="width: 8%; cursor: pointer;" @onclick='() => SortPlugins("Memory")'>
                                        Memory
                                        @if (sortColumn == "Memory")
                                        {
                                            <i class="fas fa-sort-@(sortAscending ? "up" : "down") ml-1"></i>
                                        }
                                    </th>
                                    <th style="width: 21%;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var plugin in GetSortedPlugins())
                                {
                                    <tr class="@GetPluginRowClass(plugin.Status)">
                                        <td>@plugin.Number</td>
                                        <td>
                                            @if (plugin.Status == PluginStatus.Loaded)
                                            {
                                                <TwBadge Variant="success">
                                                    <i class="fas fa-check-circle mr-1"></i>Loaded
                                                </TwBadge>
                                            }
                                            else if (plugin.Status == PluginStatus.Failed)
                                            {
                                                <TwBadge Variant="danger">
                                                    <i class="fas fa-times-circle mr-1"></i>Failed
                                                </TwBadge>
                                            }
                                            else
                                            {
                                                <TwBadge Variant="warning">
                                                    <i class="fas fa-pause-circle mr-1"></i>Unloaded
                                                </TwBadge>
                                            }
                                        </td>
                                        <td>
                                            <strong class="text-white">@plugin.Name</strong>
                                            @if (!string.IsNullOrEmpty(plugin.ErrorMessage))
                                            {
                                                <i class="fas fa-exclamation-circle text-red-400 ml-2"
                                                   style="cursor: help;"
                                                   title="@plugin.ErrorMessage"></i>
                                            }
                                        </td>
                                        <td>@plugin.Version</td>
                                        <td>
                                            @{
                                                var pluginName = (plugin.FileName ?? "").Replace(".cs", "");
                                                var versionInfo = GetPluginVersionInfo(pluginName);
                                                var isCheckingVersion = IsCheckingVersion(pluginName);
                                            }
                                            @if (plugin.IsCustom)
                                            {
                                                <TwBadge Variant="success" title="Custom/Private plugin">
                                                    <i class="fas fa-check mr-1"></i>CUSTOM
                                                </TwBadge>
                                            }
                                            else if (isCheckingVersion)
                                            {
                                                <i class="fas fa-spinner fa-spin text-orange-400" title="Checking for updates..."></i>
                                            }
                                            else if (versionInfo?.LatestVersion != null)
                                            {
                                                @if (versionInfo.IsUpToDate)
                                                {
                                                    <TwBadge Variant="success" title="Up to date">
                                                        <i class="fas fa-check mr-1"></i>@versionInfo.LatestVersion
                                                    </TwBadge>
                                                }
                                                else
                                                {
                                                    <a href="@versionInfo.PluginUrl" target="_blank" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-amber-500/20 text-amber-400 no-underline hover:bg-amber-500/30 transition-colors" title="Update available - Click to visit plugin page">
                                                        <i class="fas fa-arrow-up mr-1"></i>@versionInfo.LatestVersion
                                                    </a>
                                                }
                                                <br />
                                                <small class="text-xs text-slate-500">@versionInfo.Source</small>
                                            }
                                            else if (versionInfo != null && versionInfo.LatestVersion == null)
                                            {
                                                <TwBadge Variant="default" title="Not found on Codefling or Umod">
                                                    <i class="fas fa-question"></i>
                                                </TwBadge>
                                            }
                                            else
                                            {
                                                <span class="text-slate-500">-</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @{
                                                var currentSource = pluginSources.GetValueOrDefault(pluginName);
                                                var sourceText = currentSource switch
                                                {
                                                    PluginSource.Umod => "Umod",
                                                    PluginSource.Codefling => "Codefling",
                                                    PluginSource.Custom => "Custom",
                                                    _ => "Not Set"
                                                };
                                            }
                                            <select class="bg-slate-800/50 border border-slate-700 rounded-lg px-2 py-1 text-white text-xs focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                                                    style="width: auto;"
                                                    @onchange="async (e) => await SetPluginSource(pluginName, e.Value?.ToString())"
                                                    title="Select plugin source for version checking">
                                                <option value="" selected="@(currentSource == null)">Not Set</option>
                                                <option value="@((int)PluginSource.Umod)" selected="@(currentSource == PluginSource.Umod)">Umod</option>
                                                <option value="@((int)PluginSource.Codefling)" selected="@(currentSource == PluginSource.Codefling)">Codefling</option>
                                                <option value="@((int)PluginSource.Custom)" selected="@(currentSource == PluginSource.Custom)">Custom</option>
                                            </select>
                                        </td>
                                        <td>@plugin.Author</td>
                                        <td>@plugin.LoadTime</td>
                                        <td>@plugin.MemoryUsage</td>
                                        <td>
                                            @{
                                                var pluginFileName = (plugin.FileName ?? "").Replace(".cs", "");
                                                var isReloadingThis = reloadingPlugin == pluginFileName;
                                                var isUnloadingThis = unloadingPlugin == pluginFileName;
                                            }
                                            @if (plugin.Status == PluginStatus.Loaded)
                                            {
                                                <button class="bg-orange-500 hover:bg-orange-600 text-white text-xs py-1 px-2 rounded-lg transition-colors mr-1 disabled:opacity-50 disabled:cursor-not-allowed"
                                                        @onclick="() => ReloadPlugin(pluginFileName)"
                                                        disabled="@isReloadingThis">
                                                    @if (isReloadingThis)
                                                    {
                                                        <i class="fas fa-spinner fa-spin"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-sync-alt"></i>
                                                    }
                                                </button>
                                                <button class="bg-amber-500 hover:bg-amber-600 text-white text-xs py-1 px-2 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                                        @onclick="() => UnloadPlugin(pluginFileName)"
                                                        disabled="@isUnloadingThis">
                                                    @if (isUnloadingThis)
                                                    {
                                                        <i class="fas fa-spinner fa-spin"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-power-off"></i>
                                                    }
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="bg-emerald-500 hover:bg-emerald-600 text-white text-xs py-1 px-2 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                                        @onclick="() => LoadPlugin(pluginFileName)"
                                                        disabled="@isReloadingThis">
                                                    @if (isReloadingThis)
                                                    {
                                                        <i class="fas fa-spinner fa-spin"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-play"></i>
                                                    }
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                }
                </div>
            </ChildContent>
        </TwCard>
            </ChildContent>
            <ErrorContent>
                <div class="rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-4">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    <strong>Rendering error in Mods tab.</strong> Please refresh the page.
                    <button class="ml-3 text-xs underline" @onclick='() => { activeTab = "settings"; }'>Go back</button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    }
    else if (activeTab == "protection")
    {
        <TwCard HeaderTitle="Server Protection Settings" HeaderIcon="fas fa-shield-alt">
                @if (protectionLoading)
                {
                    <div class="text-center py-5">
                        <div class="tw-spinner"></div>
                        <p class="mt-3 text-slate-400">Loading protection settings...</p>
                    </div>
                }
                else
                {
                    <!-- Whitelist-Only Server Mode Card -->
                    <div class="rounded-xl border @(protectionSettings.EnableWhitelistOnly ? "border-emerald-500/50" : "border-slate-700/50") overflow-hidden mb-4 transition-colors">
                        <div class="flex items-center justify-between px-4 py-3 @(protectionSettings.EnableWhitelistOnly ? "bg-emerald-500/15 border-b border-emerald-500/30" : "bg-slate-800/50 border-b border-slate-700/50")">
                            <h6 class="text-sm font-semibold @(protectionSettings.EnableWhitelistOnly ? "text-emerald-400" : "text-slate-300") flex items-center gap-2">
                                <i class="fas fa-list-check"></i>Whitelist-Only Server
                            </h6>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" class="sr-only peer"
                                       checked="@protectionSettings.EnableWhitelistOnly"
                                       @onchange="OnWhitelistOnlyToggled" />
                                <div class="w-9 h-5 bg-slate-600 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
                                <span class="ml-2 text-sm text-slate-300">@(protectionSettings.EnableWhitelistOnly ? "Enabled" : "Disabled")</span>
                            </label>
                        </div>
                        <div class="p-4">
                            <p class="text-slate-400 text-sm mb-3">
                                <small>When enabled, only players listed under <strong class="text-slate-300">Ignore Protection Rules for SteamID's</strong> can join the server. All other players are immediately kicked.</small>
                            </p>

                            @if (protectionSettings.EnableWhitelistOnly)
                            {
                                <!-- Warning banner -->
                                <div class="rounded-lg bg-amber-500/15 border border-amber-500/40 text-amber-300 px-4 py-3 text-sm mb-3">
                                    <div class="flex gap-2">
                                        <i class="fas fa-triangle-exclamation mt-0.5 shrink-0"></i>
                                        <div>
                                            <strong class="block mb-0.5">Whitelist-only is active</strong>
                                            Players who are <strong>not</strong> in the "Ignore Protection Rules" list below will be kicked immediately on connect, regardless of any other protection settings.
                                        </div>
                                    </div>
                                </div>

                                <!-- Custom kick message -->
                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-1">
                                        <i class="fas fa-comment-dots mr-1"></i>Kick Message
                                    </label>
                                    <input type="text"
                                           class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 placeholder-slate-500"
                                           placeholder="This server is restricted to whitelisted players only."
                                           @bind="protectionSettings.WhitelistOnlyKickMessage" />
                                    <small class="text-xs text-slate-500 mt-1 block">This message is shown to players who are kicked because they are not on the list.</small>
                                </div>
                            }
                            else
                            {
                                <div class="rounded-lg bg-slate-500/10 border border-slate-500/30 text-slate-400 px-4 py-3 text-sm">
                                    <small><i class="fas fa-toggle-off mr-2"></i>Enable this to restrict server access to listed SteamIDs only.</small>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- General Ban Settings -->
                    <div class="rounded-lg bg-blue-500/10 border border-blue-500/30 text-blue-400 px-4 py-3 text-sm mb-4">
                        <div class="flex items-center">
                            <i class="fas fa-info-circle text-2xl mr-3"></i>
                            <div>
                                <h6 class="text-sm font-semibold text-white mb-1">Global Ban Settings</h6>
                                <small class="text-slate-400">Configure how long players should be banned when they trigger protection rules.</small>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div class="rounded-xl border border-orange-500/30 p-4 h-full">
                            <h6 class="text-sm font-semibold text-white mb-3">
                                <i class="fas fa-clock text-orange-400 mr-2"></i>Ban Duration
                            </h6>
                            <div class="mb-0">
                                <label class="block text-sm font-medium text-slate-300 mb-1">Duration (in hours)</label>
                                <input type="number"
                                       class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500"
                                       min="0"
                                       @bind="protectionSettings.BanDurationMinutes"
                                       placeholder="24" />
                                <small class="text-xs text-slate-500 block mt-2">
                                    <strong>0</strong> = Permanent ban<br />
                                    <strong>1</strong> = 1 hour | <strong>24</strong> = 1 day | <strong>168</strong> = 7 days
                                </small>
                            </div>
                        </div>
                        <div class="rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-400 px-4 py-3 text-sm h-full">
                            <h6 class="text-sm font-semibold text-amber-400 mb-2">
                                <i class="fas fa-exclamation-triangle mr-2"></i>Important
                            </h6>
                            <small class="text-slate-400">
                                This duration is used when the action for a rule is set to <strong class="text-amber-300">Ban Player</strong>.
                                Rules set to <strong class="text-amber-300">Kick Player</strong> ignore this setting — the player is removed temporarily without a ban record.
                                Country violations always result in a ban using this duration.
                            </small>
                        </div>
                    </div>

                    <hr class="my-4 border-slate-700/50" />

                    <!-- Protection Rules -->
                    <h5 class="text-base font-semibold text-white mb-4 flex items-center gap-2">
                        <i class="fas fa-shield-alt text-orange-400"></i>Protection Rules
                    </h5>

                    <!-- Country Filter Card -->
                    <div class="rounded-xl border border-slate-700/50 overflow-hidden mb-4">
                        <div class="flex items-center justify-between px-4 py-3 bg-blue-500/10 border-b border-blue-500/20">
                            <h6 class="text-sm font-semibold text-blue-400 flex items-center gap-2">
                                <i class="fas fa-globe"></i>Country-Based Protection
                            </h6>
                        </div>
                        <div class="p-4">
                            <p class="text-slate-400 text-sm mb-3">
                                <small>Control which countries can connect to your server. Players from blocked countries are banned using the global ban duration above.</small>
                            </p>

                            <div class="mb-3">
                                <label class="block text-sm font-medium text-slate-300 mb-1">Filter Mode</label>
                                <select class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500" @bind="protectionSettings.CountryFilterMode">
                                    <option value="@CountryFilterMode.None">Disabled — Allow all countries</option>
                                    <option value="@CountryFilterMode.Whitelist">Allowlist — Only allow selected countries</option>
                                    <option value="@CountryFilterMode.Blacklist">Blocklist — Block selected countries</option>
                                </select>
                            </div>

                            @if (protectionSettings.CountryFilterMode != CountryFilterMode.None)
                            {
                                var isWhitelist = protectionSettings.CountryFilterMode == CountryFilterMode.Whitelist;
                                var badgeBgClass = isWhitelist ? "bg-emerald-500/20 text-emerald-400" : "bg-red-500/20 text-red-400";
                                var containerClass = isWhitelist ? "border-emerald-500/30 bg-emerald-500/5" : "border-red-500/30 bg-red-500/5";

                                <div class="border rounded-lg p-3 @containerClass">
                                    <label class="block text-sm font-medium text-slate-300 mb-3">
                                        @if (isWhitelist)
                                        {
                                            <i class="fas fa-check-circle text-emerald-400 mr-2"></i>@:Allowed Countries
                                        }
                                        else
                                        {
                                            <i class="fas fa-ban text-red-400 mr-2"></i>@:Blocked Countries
                                        }
                                    </label>

                                    <div class="flex mb-3">
                                        <span class="flex items-center px-3 bg-slate-800 border border-r-0 border-slate-700 rounded-l-lg text-slate-400">
                                            <i class="fas fa-search"></i>
                                        </span>
                                        <input type="text"
                                               class="flex-1 bg-slate-800/50 border border-slate-700 px-3 py-2 text-white text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 placeholder-slate-500 @(!string.IsNullOrWhiteSpace(countrySearchQuery) ? "" : "rounded-r-lg")"
                                               placeholder="Search countries..."
                                               @bind="countrySearchQuery"
                                               @bind:event="oninput" />
                                        @if (!string.IsNullOrWhiteSpace(countrySearchQuery))
                                        {
                                            <button class="px-3 py-2 border border-l-0 border-slate-700 text-slate-400 hover:text-white rounded-r-lg transition-colors" type="button" @onclick="() => countrySearchQuery = string.Empty">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        }
                                    </div>

                                    <!-- Country Dropdown -->
                                    @if (!string.IsNullOrWhiteSpace(countrySearchQuery) && filteredCountries.Any())
                                    {
                                        <div class="rounded-lg border border-slate-700/50 overflow-hidden max-h-[200px] overflow-y-auto mb-3">
                                            @foreach (var country in filteredCountries.Take(10))
                                            {
                                                <button type="button"
                                                        class="w-full flex items-center px-3 py-2 text-left text-sm hover:bg-slate-800/50 border-b border-slate-700/30 last:border-b-0 transition-colors"
                                                        @onclick="() => AddCountry(country.Code)">
                                                    <i class="fas fa-plus-circle text-emerald-400 mr-2"></i>
                                                    <span class="text-white">@country.Name</span>
                                                    <TwBadge Variant="default" Class="ml-auto">@country.Code</TwBadge>
                                                </button>
                                            }
                                        </div>
                                    }

                                    <!-- Selected Countries -->
                                    @if (protectionSettings.CountryList.Any())
                                    {
                                        <div class="flex flex-wrap gap-2 mt-3">
                                            @foreach (var countryCode in protectionSettings.CountryList)
                                            {
                                                var countryName = allCountries.FirstOrDefault(c => c.Code == countryCode)?.Name ?? countryCode;
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium @badgeBgClass">
                                                    <i class="fas fa-flag"></i>
                                                    @countryName (@countryCode)
                                                    <button type="button" class="ml-1 hover:text-white transition-colors" @onclick="() => RemoveCountry(countryCode)">
                                                        <i class="fas fa-times text-[10px]"></i>
                                                    </button>
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rounded-lg bg-slate-500/10 border border-slate-500/30 text-slate-400 px-4 py-3 text-sm mb-0 mt-3">
                                            <small><i class="fas fa-info-circle mr-2"></i>No countries selected. Search and click to add countries to the list.</small>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- VAC Ban Protection Card -->
                    <div class="rounded-xl border border-slate-700/50 overflow-hidden mb-4">
                        <div class="flex items-center justify-between px-4 py-3 bg-red-500/10 border-b border-red-500/20">
                            <h6 class="text-sm font-semibold text-red-400 flex items-center gap-2">
                                <i class="fas fa-ban"></i>VAC Ban Protection
                            </h6>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" @bind="protectionSettings.EnableVacBanProtection" class="sr-only peer" />
                                <div class="w-9 h-5 bg-slate-600 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-500"></div>
                                <span class="ml-2 text-sm text-slate-300">@(protectionSettings.EnableVacBanProtection ? "Enabled" : "Disabled")</span>
                            </label>
