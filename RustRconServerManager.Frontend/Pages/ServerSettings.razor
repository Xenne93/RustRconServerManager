    private void AddCountry(string countryCode)
    {
        if (!protectionSettings.CountryList.Contains(countryCode))
        {
            protectionSettings.CountryList.Add(countryCode);
            countrySearchQuery = string.Empty;
        }
    }

    private void RemoveCountry(string countryCode)
    {
        protectionSettings.CountryList.Remove(countryCode);
    }

    private void AddWhitelistSteamId()
    {
        if (!string.IsNullOrWhiteSpace(newWhitelistSteamId))
        {
            var trimmedId = newWhitelistSteamId.Trim();

            // Basic validation: SteamID64 should be 17 digits
            if (trimmedId.Length == 17 && trimmedId.All(char.IsDigit))
            {
                if (!protectionSettings.WhitelistedSteamIds.Any(e => e.SteamId == trimmedId))
                {
                    protectionSettings.WhitelistedSteamIds.Add(new WhitelistEntryDTO
                    {
                        SteamId = trimmedId,
                        Comment = newWhitelistComment.Trim()
                    });
                    newWhitelistSteamId = string.Empty;
                    newWhitelistComment = string.Empty;
                }
            }
            else
            {
                Console.WriteLine($"Invalid SteamID format: {trimmedId}");
            }
        }
    }

    private void RemoveWhitelistSteamId(string steamId)
    {
        protectionSettings.WhitelistedSteamIds.RemoveAll(e => e.SteamId == steamId);
    }

    private void HandleWhitelistKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddWhitelistSteamId();
        }
    }

