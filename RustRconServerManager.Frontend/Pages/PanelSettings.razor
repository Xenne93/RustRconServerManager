    private async Task LoadVacBanOverrides()
    {
        try
        {
            vacOverridesLoading = true;
            vacOverrideError = null;

            var response = await Http.GetAsync("/api/panelsettings/developer/vac-overrides");
            if (response.IsSuccessStatusCode)
            {
                vacOverrides = await response.Content.ReadFromJsonAsync<List<DeveloperVacBanOverrideDto>>(new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
            else
            {
                vacOverrideError = "Failed to load VAC-ban overrides.";
            }
        }
        catch (Exception ex)
        {
            vacOverrideError = $"Error loading VAC-ban overrides: {ex.Message}";
        }
        finally
        {
            vacOverridesLoading = false;
        }
    }

    private async Task SaveVacBanOverride()
    {
        var steamId = newOverrideSteamId.Trim();
        if (string.IsNullOrEmpty(steamId))
            return;

        vacOverrideSaving = true;
        vacOverrideError = null;

        try
        {
            var response = await Http.PutAsJsonAsync("/api/panelsettings/developer/vac-overrides", new UpsertDeveloperVacBanOverrideDto
            {
                SteamId = steamId,
                VACBanned = newOverrideVacBanned,
                NumberOfVACBans = newOverrideNumberOfBans,
                DaysSinceLastBan = newOverrideDaysSinceLastBan
            });

            if (response.IsSuccessStatusCode)
            {
                newOverrideSteamId = "";
                newOverrideVacBanned = true;
                newOverrideNumberOfBans = 1;
                newOverrideDaysSinceLastBan = 0;
                await LoadVacBanOverrides();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                vacOverrideError = $"Failed to save override: {error}";
            }
        }
        catch (Exception ex)
        {
            vacOverrideError = $"Error: {ex.Message}";
        }
        finally
        {
            vacOverrideSaving = false;
        }
    }

    private async Task RemoveVacBanOverride(string steamId)
    {
        removingSteamId = steamId;
        vacOverrideError = null;

        try
        {
            var response = await Http.DeleteAsync($"/api/panelsettings/developer/vac-overrides/{steamId}");
            if (response.IsSuccessStatusCode)
            {
                vacOverrides.RemoveAll(o => o.SteamId == steamId);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                vacOverrideError = $"Failed to remove override: {error}";
            }
        }
        catch (Exception ex)
        {
            vacOverrideError = $"Error: {ex.Message}";
        }
        finally
        {
            removingSteamId = null;
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        _clockTimer?.Dispose();
        await Task.CompletedTask;
    }
