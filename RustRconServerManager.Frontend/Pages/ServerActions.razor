@page "/server-actions"
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@using Blazored.LocalStorage;
@using Blazored.SessionStorage;
@using RustRconServerManager.Frontend.Components
@using RustRconServerManager.Frontend.Components.Layout
@using RustRconServerManager.Frontend.Components.ServerActions
@using RustRconServerManager.Frontend.Components.Auth
@using RustRconServerManager.Shared.Dashboard
@using RustRconServerManager.Frontend.Services
@inject HttpClient Http;
@inject ILocalStorageService LocalStorage;
@inject ISessionStorageService SessionStorage;
@inject NavigationManager Nav;
@inject ServerValidationHelper ServerValidationHelper;

@attribute [Authorize]

<PageAccessGuard PageRoute="server-actions">
<ContentWrapper>
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <div>
            <h3 class="text-xl font-semibold text-white">Server Actions</h3>
            <p class="text-slate-400 text-sm mt-1">@(ServerBaseInformation?.ServerHostname ?? "Loading server info...")</p>
        </div>
    </div>

    <div class="flex items-start gap-3 rounded-lg bg-blue-500/5 border border-blue-500/20 px-4 py-3 mb-6">
        <i class="fas fa-circle-info text-blue-400 mt-0.5"></i>
        <p class="text-sm text-slate-300">Manage your server with powerful actions like restarting with a countdown timer or at a scheduled time. Players will be notified with your custom reason message before the restart begins.</p>
    </div>

    <div class="max-w-4xl">
        <RestartServerCard />
    </div>
</ContentWrapper>
</PageAccessGuard>

@code {
    private Dashboard_ServerBaseInformationDTO ServerBaseInformation = new();

    protected override async Task OnInitializedAsync()
    {
        bool hasAccess = await ServerValidationHelper.ValidateActiveServerAsync();
        if (!hasAccess)
            return;

        await FetchServerInformation();
    }

    private async Task FetchServerInformation()
    {
        try
        {
            var response = await Http.GetAsync($"/api/Dashboard/GetServerBaseInformation");
            if (response.IsSuccessStatusCode)
            {
                ServerBaseInformation = await response.Content.ReadFromJsonAsync<Dashboard_ServerBaseInformationDTO>() ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching server info: {ex.Message}");
        }
    }
}
