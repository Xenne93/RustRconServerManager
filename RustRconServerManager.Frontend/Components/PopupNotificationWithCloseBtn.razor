@using RustRconServerManager.Frontend.Components.UI

<TwModal @bind-IsOpen="isVisible" Title="@PopupTitle" Size="sm">
    <ChildContent>
        <div class="text-center py-2">
            <div class="mx-auto w-12 h-12 rounded-full bg-orange-500/10 flex items-center justify-center mb-4">
                <i class="fas fa-info-circle text-orange-400 text-lg"></i>
            </div>
            <div class="text-sm text-slate-300">
                @ChildContent
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <div class="flex justify-center w-full">
            <button class="px-4 py-2 text-sm font-medium text-white bg-orange-500 hover:bg-orange-600 rounded-lg transition-colors" @onclick="Close">@CloseBtnText</button>
        </div>
    </FooterContent>
</TwModal>

@code {
    private bool isVisible;

    [Parameter] public string PopupTitle { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string CloseBtnText { get; set; }

    public void Open()
    {
        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
        StateHasChanged();
    }
}
