@using RustRconServerManager.Shared.Scheduler
@using RustRconServerManager.Frontend.Components.UI
@using System.Net.Http.Json
@using System.Text.Json

<TwModal @bind-IsOpen="IsModalOpen" Title='@(IsEditing ? "Edit Scheduled Command" : "Create New Scheduled Command")' Size="lg">
    <ChildContent>
        @if (IsLoading)
        {
            <div class="text-center py-8">
                <div class="tw-spinner mx-auto mb-3"></div>
                <p class="text-slate-500 text-sm">Loading...</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Command Name</label>
                    <input type="text" class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white placeholder:text-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                           @bind="FormData.Name" placeholder="e.g., Daily Restart" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Description</label>
                    <textarea class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white placeholder:text-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500"
                              @bind="FormData.Description" rows="2" placeholder="What does this command do?"></textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">Command</label>
                    <input type="text" class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white placeholder:text-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 font-mono"
                           @bind="FormData.Command" placeholder="e.g., say Welcome to the server!" />
                    <p class="text-xs text-slate-500 mt-1">Enter the RCON command to execute</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Schedule Type</label>
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var (value, label) in ScheduleTypes)
                        {
                            <button type="button"
                                    class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors @(FormData.ScheduleTypeValue == value ? "bg-orange-500 text-white" : "bg-slate-800 text-slate-400 hover:bg-slate-700 hover:text-white border border-slate-700")"
                                    @onclick="() => OnScheduleTypeChange(value)">
                                @label
                            </button>
                        }
                    </div>
                </div>

                <div>
                    @switch (FormData.ScheduleTypeValue)
                    {
                        case 0:
                            <OneTimeScheduleSettings
                                ExecuteAt="@FormData.ExecuteAt"
                                OnExecuteAtChange="@((DateTime? dt) => { FormData.ExecuteAt = dt; })" />
                            break;
                        case 5:
                            <MinuteScheduleSettings
                                IntervalMinutes="@FormData.IntervalMinutes"
                                OnIntervalMinutesChange="@((int? minutes) => { FormData.IntervalMinutes = minutes; })" />
                            break;
                        case 1:
                            <HourlyScheduleSettings
                                IntervalHours="@FormData.IntervalHours"
                                OnIntervalHoursChange="@((int? hours) => { FormData.IntervalHours = hours; })" />
                            break;
                        case 2:
                            <DailyScheduleSettings
                                ExecutionHour="@FormData.ExecutionHour"
                                ExecutionMinute="@FormData.ExecutionMinute"
                                OnExecutionHourChange="@((int? h) => { FormData.ExecutionHour = h; })"
                                OnExecutionMinuteChange="@((int? m) => { FormData.ExecutionMinute = m; })" />
                            break;
                        case 3:
                            <WeeklyScheduleSettings
                                DaysOfWeek="@(FormData.DaysOfWeek ?? "")"
                                ExecutionHour="@FormData.ExecutionHour"
                                ExecutionMinute="@FormData.ExecutionMinute"
                                OnDaysOfWeekChange="@((string days) => { FormData.DaysOfWeek = days; })"
                                OnExecutionHourChange="@((int? h) => { FormData.ExecutionHour = h; })"
                                OnExecutionMinuteChange="@((int? m) => { FormData.ExecutionMinute = m; })" />
                            break;
                        case 4:
                            <MonthlyScheduleSettings
                                DayOfMonth="@FormData.DayOfMonth"
                                ExecutionHour="@FormData.ExecutionHour"
                                ExecutionMinute="@FormData.ExecutionMinute"
                                OnDayOfMonthChange="@((int? d) => { FormData.DayOfMonth = d; })"
                                OnExecutionHourChange="@((int? h) => { FormData.ExecutionHour = h; })"
                                OnExecutionMinuteChange="@((int? m) => { FormData.ExecutionMinute = m; })" />
                            break;
                    }
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 text-sm">
                        @ErrorMessage
                    </div>
                }
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button class="tw-btn-ghost px-4 py-2 text-sm" @onclick="CloseModal">Cancel</button>
        <button class="tw-btn-primary px-4 py-2 text-sm" @onclick="SaveSchedule" disabled="@(IsLoading || IsSaving)">
            @if (IsSaving)
            {
                <div class="tw-spinner w-3 h-3 mr-2"></div>
            }
            @(IsEditing ? "Update" : "Create")
        </button>
    </FooterContent>
</TwModal>

@code {
    [Parameter]
    public int ServerId { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Inject]
    private HttpClient Http { get; set; }

    [Inject]
    private IJSRuntime JSRuntime { get; set; }

    private bool IsModalOpen { get; set; } = false;
    private CreateScheduledCommandDto FormData { get; set; } = new();
    private int? EditingId { get; set; } = null;
    private bool IsEditing { get; set; } = false;
    private bool IsLoading { get; set; } = false;
    private bool IsSaving { get; set; } = false;
    private string ErrorMessage { get; set; } = "";

    private static readonly (int Value, string Label)[] ScheduleTypes = new[]
    {
        (0, "One-Time"),
        (5, "Minutes"),
        (1, "Hourly"),
        (2, "Daily"),
        (3, "Weekly"),
        (4, "Monthly")
    };

    private void CloseModal()
    {
        IsModalOpen = false;
        ErrorMessage = "";
    }

    public async Task ResetFormAsync(ScheduledCommandDto editingCommand = null)
    {
        if (editingCommand != null)
        {
            IsEditing = true;
            EditingId = editingCommand.Id;
            FormData = new()
            {
                RconServerId = editingCommand.RconServerId,
                Name = editingCommand.Name,
                Description = editingCommand.Description,
                Command = editingCommand.Command,
                ScheduleTypeValue = editingCommand.ScheduleTypeValue,
                IntervalHours = editingCommand.IntervalHours,
                ExecutionHour = editingCommand.ExecutionHour,
                ExecutionMinute = editingCommand.ExecutionMinute,
                DaysOfWeek = editingCommand.DaysOfWeek,
                DayOfMonth = editingCommand.DayOfMonth,
                ExecuteAt = editingCommand.ExecuteAt,
                IsActive = editingCommand.IsActive
            };
        }
        else
        {
            IsEditing = false;
            EditingId = null;
            FormData = new()
            {
                RconServerId = ServerId,
                ScheduleTypeValue = 2, // Default to daily
                ExecutionHour = 18,
                ExecutionMinute = 0,
                IsActive = true
            };
        }
        ErrorMessage = "";
        IsModalOpen = true;
        StateHasChanged();
    }

    public void ResetForm(ScheduledCommandDto editingCommand = null)
    {
        // Synchronous wrapper for backward compatibility
        _ = ResetFormAsync(editingCommand);
    }

    private void OnScheduleTypeChange(int scheduleType)
    {
        FormData.ScheduleTypeValue = scheduleType;
        // Reset schedule-specific values
        FormData.IntervalHours = null;
        FormData.ExecutionHour = 18;
        FormData.ExecutionMinute = 0;
        FormData.DaysOfWeek = null;
        FormData.DayOfMonth = null;
        FormData.ExecuteAt = null;
        StateHasChanged();
    }

    private async Task SaveSchedule()
    {
        try
        {
            IsSaving = true;
            ErrorMessage = "";

            if (FormData.RconServerId == 0)
            {
                ErrorMessage = "No server selected";
                IsSaving = false;
                return;
            }

            if (string.IsNullOrWhiteSpace(FormData.Name))
            {
                ErrorMessage = "Name is required";
                IsSaving = false;
                return;
            }

            if (string.IsNullOrWhiteSpace(FormData.Command))
            {
                ErrorMessage = "Command is required";
                IsSaving = false;
                return;
            }

            var scheduleType = (RustRconServerManager.Shared.Scheduler.ScheduleType)FormData.ScheduleTypeValue;
            switch (scheduleType)
            {
                case RustRconServerManager.Shared.Scheduler.ScheduleType.OneTime:
                    if (!FormData.ExecuteAt.HasValue)
                    {
                        ErrorMessage = "Execute At date/time is required for one-time schedules";
                        IsSaving = false;
                        return;
                    }
                    break;
                case RustRconServerManager.Shared.Scheduler.ScheduleType.Hourly:
                    if (!FormData.IntervalHours.HasValue || FormData.IntervalHours <= 0)
                    {
                        ErrorMessage = "Interval Hours is required and must be greater than 0";
                        IsSaving = false;
                        return;
                    }
                    break;
                case RustRconServerManager.Shared.Scheduler.ScheduleType.Daily:
                    if (!FormData.ExecutionHour.HasValue || !FormData.ExecutionMinute.HasValue)
                    {
                        ErrorMessage = "Execution Hour and Minute are required for daily schedules";
                        IsSaving = false;
                        return;
                    }
                    break;
                case RustRconServerManager.Shared.Scheduler.ScheduleType.Weekly:
                    if (string.IsNullOrEmpty(FormData.DaysOfWeek) || !FormData.ExecutionHour.HasValue || !FormData.ExecutionMinute.HasValue)
                    {
                        ErrorMessage = "Days of Week, Hour, and Minute are required for weekly schedules";
                        IsSaving = false;
                        return;
                    }
                    break;
                case RustRconServerManager.Shared.Scheduler.ScheduleType.Monthly:
                    if (!FormData.DayOfMonth.HasValue || !FormData.ExecutionHour.HasValue || !FormData.ExecutionMinute.HasValue)
                    {
                        ErrorMessage = "Day of Month, Hour, and Minute are required for monthly schedules";
                        IsSaving = false;
                        return;
                    }
                    break;
            }

            // Get browser UTC offset and attach to DTO
            try
            {
                var offsetMinutes = await JSRuntime.InvokeAsync<int>("eval", "new Date().getTimezoneOffset()");
                FormData.UtcOffsetMinutes = offsetMinutes;
            }
            catch
            {
                FormData.UtcOffsetMinutes = 0;
            }

            HttpResponseMessage response;

            if (IsEditing && EditingId.HasValue)
            {
                response = await Http.PutAsJsonAsync($"/api/scheduler/{EditingId}", FormData);
            }
            else
            {
                response = await Http.PostAsJsonAsync($"/api/scheduler", FormData);
            }

            if (!response.IsSuccessStatusCode)
            {
                try
                {
                    var content = await response.Content.ReadAsStringAsync();
                    System.Console.WriteLine($"API Response Status: {response.StatusCode}");
                    System.Console.WriteLine($"API Response Content: {content}");

                    if (!string.IsNullOrEmpty(content))
                    {
                        using var doc = JsonDocument.Parse(content);
                        var root = doc.RootElement;

                        if (root.TryGetProperty("error", out var errorProp))
                        {
                            ErrorMessage = errorProp.GetString() ?? "Failed to save scheduled command";
                        }
                        else
                        {
                            ErrorMessage = content;
                        }
                    }
                    else
                    {
                        ErrorMessage = $"Failed to save scheduled command (HTTP {response.StatusCode})";
                    }
                }
                catch (Exception ex)
                {
                    ErrorMessage = $"Error parsing response: {ex.Message}";
                }
            }
            else
            {
                CloseModal();
                await OnSaved.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }
}
