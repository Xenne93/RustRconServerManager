@using RustRconServerManager.Shared.ManageServers
@using RustRconServerManager.Frontend.Services
@using RustRconServerManager.Frontend.Components
@using RustRconServerManager.Frontend.Components.UI
@inject HttpClient Http
@inject NavigationManager Nav
@inject NavigationHelper NavHelper
@inject ServerStateService ServerState
@implements IDisposable

@* Top Navbar - Fixed, full width *@
<header class="fixed top-0 left-0 right-0 z-50 h-16 border-b border-slate-800/50 bg-[rgb(var(--body-bg)/80%)] backdrop-blur-xl">
    <div class="flex items-center justify-between h-full px-4 lg:px-6">
        @* Left: Logo & Mobile menu *@
        <div class="flex items-center gap-4">
            <button type="button"
                    class="lg:hidden tw-btn-ghost tw-btn-icon text-slate-400 hover:text-white"
                    @onclick="OnMobileMenuToggle">
                <i class="fas fa-bars text-lg"></i>
            </button>

            <a href="@NavHelper.GetUrl("")" class="flex items-center gap-3 no-underline">
                <img src="https://cdn.RustRconServerManager.com/images/rpp-logo01.png" alt="Rust RCON Server Manager" class="w-9 h-9 rounded-lg" />
                <span class="hidden sm:block text-lg font-bold text-white">
                    Rust RCON Server Manager
                </span>
            </a>
        </div>

        @* Right: Server Selector, Notifications & User *@
        <div class="flex items-center gap-2">
            @* Hidden until notifications feature is implemented
            <button type="button" class="tw-btn-ghost tw-btn-icon text-slate-400 hover:text-white relative">
                <i class="fas fa-bell"></i>
                <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-orange-500 rounded-full"></span>
            </button>
            *@

            <div class="hidden md:flex items-center">
                <TwDropdown Align="right">
                    <TriggerContent>
                        <button type="button" class="tw-btn-outline flex items-center gap-2">
                            <i class="fas fa-server text-orange-400 text-sm"></i>
                            <span class="max-w-[200px] truncate">
                                @(IsLoading ? "Loading..." : CurrentServerName)
                            </span>
                            @if (!IsLoading && ActiveServerId.HasValue)
                            {
                                @if (ActiveServerIsConnected)
                                {
                                    <span class="tw-badge-success text-[10px]">Online</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-red-500/20 text-red-400 text-[10px] font-medium">Offline</span>
                                }
                            }
                            <i class="fas fa-chevron-down text-xs text-slate-400"></i>
                        </button>
                    </TriggerContent>
                    <ChildContent>
                        <div class="w-64">
                            @if (IsLoading)
                            {
                                <div class="px-3 py-6 text-center text-slate-500 text-sm">
                                    <i class="fas fa-spinner fa-spin mr-2"></i>Loading servers...
                                </div>
                            }
                            else if (Servers?.Count > 0)
                            {
                                @foreach (var server in Servers)
                                {
                                    <TwDropdownItem IsActive="@(server.ServerId == ActiveServerId)"
                                                    OnClick="@(async _ => await SwitchServer(server.ServerId.GetValueOrDefault(), server.ServerName ?? "Unknown"))">
                                        <div class="flex items-center justify-between w-full">
                                            <span>@server.ServerName</span>
                                            @if (server.IsConnected == true)
                                            {
                                                <span class="tw-badge-success text-[10px]">Online</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded-full bg-red-500/20 text-red-400 text-[10px] font-medium">Offline</span>
                                            }
                                        </div>
                                    </TwDropdownItem>
                                }
                                @if (!IsModerator)
                                {
                                    <TwDropdownSeparator />
                                    <TwDropdownItem Href="@NavHelper.GetUrl("manage-servers")">
                                        <i class="fas fa-cog text-xs mr-2"></i>Manage Servers
                                    </TwDropdownItem>
                                }
                            }
                            else
                            {
                                <div class="px-3 py-6 text-center text-slate-500 text-sm">
                                    No servers configured
                                </div>
                                @if (!IsModerator)
                                {
                                    <TwDropdownSeparator />
                                    <TwDropdownItem Href="@NavHelper.GetUrl("manage-servers")">
                                        <i class="fas fa-cog text-xs mr-2"></i>Manage Servers
                                    </TwDropdownItem>
                                }
                            }
                        </div>
                    </ChildContent>
                </TwDropdown>
            </div>

            <ThemeSwitcher />

            <TwDropdown Align="right">
                <TriggerContent>
                    <button type="button" class="tw-btn-ghost flex items-center gap-2 px-2 text-slate-400 hover:text-white">
                        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center">
                            <i class="fas fa-user text-sm"></i>
                        </div>
                        <span class="hidden sm:block text-sm">
                            @(IsLoadingUserInfo ? "Loading..." : (UserEmail ?? "Admin"))
                        </span>
                        <i class="fas fa-chevron-down text-xs"></i>
                    </button>
                </TriggerContent>
                <ChildContent>
                    <div class="w-48">
                        @if (IsLoadingUserInfo)
                        {
                            <div class="px-3 py-4 text-center text-slate-500 text-sm">
                                <i class="fas fa-spinner fa-spin mr-2"></i>Loading...
                            </div>
                        }
                        else
                        {
                            <div class="px-3 py-2 text-xs text-slate-500">
                                <i class="fas fa-envelope mr-1"></i>@(UserEmail ?? "Unknown")
                            </div>
                            <TwDropdownSeparator />
                            @if (!IsModerator)
                            {
                                <TwDropdownItem Href="@NavHelper.GetUrl("Moderators")">
                                    <i class="fas fa-users text-xs mr-2"></i>Moderators
                                </TwDropdownItem>
                            }
                            <TwDropdownItem Href="@NavHelper.GetUrl("Security")">
                                <i class="fas fa-shield-alt text-xs mr-2"></i>Security
                            </TwDropdownItem>
                            @if (!IsModerator)
                            {
                                <TwDropdownItem Href="@NavHelper.GetUrl("panelsettings")">
                                    <i class="fas fa-cog text-xs mr-2"></i>Panel Settings
                                </TwDropdownItem>
                            }
                            <TwDropdownSeparator />
                            <TwDropdownItem IsDanger="true" OnClick="@(async _ => await Logout())">
                                <i class="fas fa-sign-out-alt text-xs mr-2"></i>Logout
                            </TwDropdownItem>
                        }
                    </div>
                </ChildContent>
            </TwDropdown>
        </div>
    </div>
</header>

@code {
    [Parameter] public EventCallback OnMobileMenuToggle { get; set; }

    private List<ManageServers_ServerListEntryDTO> Servers = new();
    private int? ActiveServerId;
    private string CurrentServerName = "Select Server";
    private bool IsLoading = true;
    private bool IsLoadingUserInfo = true;
    private string? UserEmail = null;
    private bool IsModerator = false;
    private bool ActiveServerIsConnected => Servers?.FirstOrDefault(s => s.ServerId == ActiveServerId)?.IsConnected == true;

    protected override async Task OnInitializedAsync()
    {
        ServerState.OnServerChanged += OnServerStateChanged;
        ServerState.OnConnectionStatusChanged += OnConnectionStatusChanged;
        await LoadSelectedServerFromState();
        await LoadServers();
        await LoadUserInfo();
    }

    private void OnServerStateChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadSelectedServerFromState();
            await LoadServers();
            StateHasChanged();
        });
    }

    private void OnConnectionStatusChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadServers();
            StateHasChanged();
        });
    }

    private async Task LoadSelectedServerFromState()
    {
        try
        {
            await ServerState.LoadSelectedServerFromDatabaseAsync();
            var serverId = await ServerState.GetSelectedServerIdAsync();
            if (serverId.HasValue && serverId.Value > 0)
            {
                ActiveServerId = serverId.Value;
            }
            else
            {
                ActiveServerId = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TopNavbar] Error loading selected server: {ex.Message}");
        }
    }

    private async Task LoadServers()
    {
        try
        {
            IsLoading = true;
            var serversList = await Http.GetFromJsonAsync<List<ManageServers_ServerListEntryDTO>>("/api/ManageServers/GetServerList");
            if (serversList != null)
            {
                Servers = serversList;
                var activeServer = Servers.FirstOrDefault(s => s.ServerId == ActiveServerId);
                if (activeServer != null)
                {
                    CurrentServerName = activeServer.ServerName ?? "Unknown Server";
                }
                else if (Servers.Count > 0)
                {
                    // Selected server doesn't exist or no access — auto-select first available
                    var firstServer = Servers[0];
                    var firstId = firstServer.ServerId.GetValueOrDefault();
                    if (firstId > 0)
                    {
                        await ServerState.SetSelectedServerAsync(firstId, firstServer.ServerName ?? "Unknown Server");
                        ActiveServerId = firstId;
                        CurrentServerName = firstServer.ServerName ?? "Unknown Server";
                    }
                }
                else
                {
                    CurrentServerName = "No Servers";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TopNavbar] Error loading servers: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SwitchServer(int serverId, string serverName)
    {
        try
        {
            bool success = await ServerState.SetSelectedServerAsync(serverId, serverName);
            if (success)
            {
                // Stay on the current page instead of always redirecting to dashboard
                var fullUri = Nav.Uri;
                var baseUri = Nav.BaseUri.TrimEnd('/');
                var relativePath = fullUri.Substring(baseUri.Length);

                relativePath = relativePath.TrimStart('/').Split('?')[0];

                // Fall back to dashboard if we can't determine the current page
                if (string.IsNullOrEmpty(relativePath))
                {
                    relativePath = "dashboard";
                }

                NavHelper.NavigateTo(relativePath, true);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TopNavbar] Error switching server: {ex.Message}");
        }
    }

    private async Task LoadUserInfo()
    {
        try
        {
            IsLoadingUserInfo = true;
            var response = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>("/api/Account/BasicInfo");
            if (response.ValueKind != System.Text.Json.JsonValueKind.Undefined)
            {
                UserEmail = response.GetProperty("email").GetString();
                IsModerator = response.GetProperty("isModerator").GetBoolean();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TopNavbar] Error loading user info: {ex.Message}");
            UserEmail = "Unknown";
        }
        finally
        {
            IsLoadingUserInfo = false;
        }
    }

    private async Task Logout()
    {
        try
        {
            await Http.PostAsync("/api/Auth/logout", null);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TopNavbar] Error during logout: {ex.Message}");
        }
        finally
        {
            Nav.NavigateTo(NavHelper.GetUrl("login"), true);
        }
    }

    public void Dispose()
    {
        ServerState.OnServerChanged -= OnServerStateChanged;
        ServerState.OnConnectionStatusChanged -= OnConnectionStatusChanged;
    }
}
