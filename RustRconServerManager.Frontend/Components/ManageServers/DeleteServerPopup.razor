@using RustRconServerManager.Frontend.Components.UI

<TwModal @bind-IsOpen="isVisible" Title="Delete Server" Size="sm">
    <ChildContent>
        <div class="text-center py-2">
            <div class="mx-auto w-12 h-12 rounded-full bg-red-500/10 flex items-center justify-center mb-4">
                <i class="fas fa-trash text-red-400 text-lg"></i>
            </div>
            <p class="text-white font-medium mb-2">Are you sure you want to delete server @serverId?</p>
            <p class="text-sm text-slate-400">By deleting this server you also delete the server's history. This action cannot be undone.</p>
        </div>
    </ChildContent>
    <FooterContent>
        <div class="flex justify-end gap-2 w-full">
            <button class="px-4 py-2 text-sm font-medium text-slate-300 bg-slate-700 hover:bg-slate-600 rounded-lg transition-colors" @onclick="Close">Cancel</button>
            <button class="px-4 py-2 text-sm font-medium text-white bg-red-500 hover:bg-red-600 rounded-lg transition-colors" @onclick="Confirm">Delete</button>
        </div>
    </FooterContent>
</TwModal>

@code {
    private bool isVisible;
    private int serverId;

    [Parameter] public EventCallback<int> OnDelete { get; set; }

    public void Open(int id)
    {
        serverId = id;
        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
        StateHasChanged();
    }

    private async Task Confirm()
    {
        await OnDelete.InvokeAsync(serverId);
        Close();
    }
}
