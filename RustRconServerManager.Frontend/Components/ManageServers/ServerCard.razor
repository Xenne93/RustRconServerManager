@using Blazored.LocalStorage
@using RustRconServerManager.Frontend.Pages
@inject ILocalStorageService LocalStorage


<div class="relative rounded-xl border @(IsSelected ? "border-orange-500/50" : "border-slate-700/50") bg-gradient-to-br from-slate-900/80 to-slate-950/80 h-full flex flex-col transition-colors">
    <!-- Card Header -->
    <div class="px-4 py-3 border-b border-slate-700/50 bg-slate-800/30 flex justify-between items-center rounded-t-xl">
        <h6 class="text-sm font-semibold text-white truncate mr-2">
            <i class="fa-solid fa-server mr-2 text-slate-400"></i>@ServerName
        </h6>
        @if (IsConnected == true)
        {
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-500/20 text-emerald-400 shrink-0">
                <i class="fas fa-check-circle"></i>Online
            </span>
        }
        else
        {
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-red-500/20 text-red-400 shrink-0">
                <i class="fas fa-times-circle"></i>Offline
            </span>
        }
    </div>

    <!-- Card Body -->
    <div class="p-4 flex flex-col flex-1">
        <!-- Connection Info -->
        <div class="space-y-2.5 mb-4">
            <div class="flex justify-between items-center pb-2 border-b border-slate-700/30">
                <span class="text-xs text-slate-500"><i class="fa-solid fa-hashtag mr-1"></i>Server ID</span>
                <span class="text-sm font-semibold text-white">@ServerId</span>
            </div>
            <div class="flex justify-between items-center pb-2 border-b border-slate-700/30">
                <span class="text-xs text-slate-500"><i class="fa-solid fa-network-wired mr-1"></i>IP Address</span>
                <span class="text-sm font-semibold text-white truncate ml-2 max-w-[60%] text-right" title="@ServerAddress">@ServerAddress</span>
            </div>
            <div class="flex justify-between items-center pb-2 border-b border-slate-700/30">
                <span class="text-xs text-slate-500"><i class="fa-solid fa-plug mr-1"></i>Game Port</span>
                @if (GamePort == 0)
                {
                    <i class="fas fa-spinner fa-spin text-slate-400 text-xs"></i>
                }
                else
                {
                    <span class="text-sm font-semibold text-white">@GamePort</span>
                }
            </div>
            <div class="flex justify-between items-center pb-2 border-b border-slate-700/30">
                <span class="text-xs text-slate-500"><i class="fa-solid fa-plug mr-1"></i>Query Port</span>
                @if (QueryPort == 0)
                {
                    <i class="fas fa-spinner fa-spin text-slate-400 text-xs"></i>
                }
                else
                {
                    <span class="text-sm font-semibold text-white">@QueryPort</span>
                }
            </div>
            <div class="flex justify-between items-center pb-2 border-b border-slate-700/30">
                <span class="text-xs text-slate-500"><i class="fa-solid fa-terminal mr-1"></i>RCON Port</span>
                <span class="text-sm font-semibold text-white">@RconPort</span>
            </div>
            <div class="flex justify-between items-center pb-2 border-b border-slate-700/30">
                <span class="text-xs text-slate-500"><i class="fa-solid fa-puzzle-piece mr-1"></i>Panel Mod</span>
                @if (RustRconServerManagerModInstalled == true)
                {
                    <span class="text-emerald-400 text-sm font-semibold"><i class="fas fa-check-circle mr-1"></i>Installed</span>
                }
                else
                {
                    <span class="text-slate-500 text-sm font-semibold"><i class="fas fa-times-circle mr-1"></i>Not Installed</span>
                }
            </div>
            <div class="flex justify-between items-center">
                <span class="text-xs text-slate-500"><i class="fa-solid fa-bolt mr-1"></i>Mod Initialized</span>
                @if (RrsmModInitialized == true)
                {
                    <span class="text-emerald-400 text-sm font-semibold"><i class="fas fa-check-circle mr-1"></i>Yes</span>
                }
                else
                {
                    <span class="text-amber-400 text-sm font-semibold"><i class="fas fa-exclamation-triangle mr-1"></i>No</span>
                }
            </div>
        </div>

        <!-- Active Badge -->
        @if (IsSelected)
        {
            <div class="mb-3">
                <div class="rounded-lg bg-orange-500/10 border border-orange-500/30 text-orange-400 px-3 py-2 text-sm font-medium text-center">
                    <i class="fas fa-star mr-2"></i>Active Server
                </div>
            </div>
        }

        <!-- Action Buttons -->
        <div class="mt-auto space-y-2">
            @if (IsSelected)
            {
                <button class="w-full bg-slate-700 text-slate-400 font-medium py-2 px-4 rounded-lg cursor-not-allowed opacity-60" disabled type="button">
                    <i class="fas fa-check-circle mr-2"></i>Currently Active
                </button>
            }
            else
            {
                <button class="w-full bg-orange-500 hover:bg-orange-600 text-white font-medium py-2 px-4 rounded-lg transition-colors" @onclick="() => OnSelect.InvokeAsync(ServerId.Value)" type="button">
                    <i class="fa-solid fa-check mr-2"></i>Select Server
                </button>
            }
            <div @onfocusout="CloseDropdown">
                <button class="w-full flex items-center justify-center gap-2 border border-slate-600 text-slate-300 hover:bg-slate-700 font-medium py-2 px-4 rounded-lg transition-colors text-sm"
                        type="button" @onclick="ToggleDropdown">
                    <i class="fa-solid fa-cog"></i>
                    <span>Options</span>
                    <i class="fas fa-chevron-down text-xs ml-1"></i>
                </button>
                @if (showDropdown)
                {
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 rounded-lg border border-slate-700 bg-slate-800 shadow-xl z-50 overflow-hidden">
                        <button class="w-full flex items-center gap-2 px-3 py-2 text-sm text-slate-300 hover:bg-slate-700 transition-colors text-left" @onclick="HandleEditClick">
                            <i class="fa-solid fa-edit text-slate-400"></i>Edit Connection
                        </button>
                        <button class="w-full flex items-center gap-2 px-3 py-2 text-sm text-slate-300 hover:bg-slate-700 transition-colors text-left" @onclick="HandleInitializeRrsmModClick">
                            <i class="fa-solid fa-rocket text-slate-400"></i>Initialize Panel Mod
                        </button>
                        <hr class="border-slate-700" />
                        <button class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-400 hover:bg-red-500/10 transition-colors text-left" @onclick="() => OnDeleteServer.InvokeAsync(ServerId.Value)">
                            <i class="fa-solid fa-trash"></i>Delete Server
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {


    [Parameter] public string? ServerName { get; set; }
    [Parameter] public int? ServerId { get; set; }
    [Parameter] public string? ServerAddress { get; set; }
    [Parameter] public int? GamePort { get; set; }
    [Parameter] public int? QueryPort { get; set; }
    [Parameter] public int? RconPort { get; set; }
    [Parameter] public bool? IsConnected { get; set; }
    [Parameter] public int? SelectedServerId { get; set; }
    [Parameter] public string? ModFramework { get; set; }
    [Parameter] public bool? RustRconServerManagerModInstalled { get; set; }
    [Parameter] public bool? RrsmModInitialized { get; set; }
    private bool IsSelected => ServerId == SelectedServerId;

    [Parameter] public EventCallback<int> OnSelect { get; set; }
    [Parameter] public EventCallback<int> OnDeleteServer { get; set; }
    [Parameter] public EventCallback<(int serverId, string serverName, string serverAddress, int rconPort, string modFramework, bool RustRconServerManagerModInstalled)> OnEditServer { get; set; }
    [Parameter] public EventCallback<(int serverId, string serverName)> OnInitializeRrsmMod { get; set; }


    // Check if this server is globally selected (the "active" server).
    private bool isSelectedServer = false;
    private bool showDropdown = false;

    protected override async Task OnInitializedAsync()
    {



    }

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    private async Task CloseDropdown()
    {
        await Task.Delay(150);
        showDropdown = false;
    }

    private void HandleEditClick()
    {
        showDropdown = false;
        if (ServerId.HasValue && RconPort.HasValue)
        {
            OnEditServer.InvokeAsync((
                ServerId.Value,
                ServerName ?? string.Empty,
                ServerAddress ?? string.Empty,
                RconPort.Value,
                ModFramework ?? "None",
                RustRconServerManagerModInstalled ?? false
            ));
        }
    }

    private void HandleInitializeRrsmModClick()
    {
        showDropdown = false;
        if (ServerId.HasValue)
        {
            OnInitializeRrsmMod.InvokeAsync((ServerId.Value, ServerName ?? string.Empty));
        }
    }
}
