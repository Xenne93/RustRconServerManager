@using System.Net
@using RustRconServerManager.Frontend.Components.UI
@inject HttpClient Http
@inject NavigationManager NavigationManager

<TwModal @bind-IsOpen="IsOpen" Title="Initialize Panel Mod" Size="lg">
    <ChildContent>
    <div>
        @if (!IsInitializing && !IsCompleted && !HasError)
        {
            <div class="space-y-4">
                <div class="flex items-start gap-3 rounded-lg bg-orange-500/5 border border-orange-500/20 px-4 py-3">
                    <i class="fas fa-rocket text-orange-400 mt-0.5"></i>
                    <div>
                        <p class="text-sm font-medium text-white mb-1">You are about to initialize the RustRconServerManager Mod.</p>
                        <p class="text-sm text-slate-400">Click Start to check that it's installed and responding.</p>
                    </div>
                </div>

                <p class="text-xs text-slate-500">
                    <i class="fas fa-info-circle mr-1"></i>Make sure the RustRconServerManager mod is installed on your server before proceeding.
                    No further configuration is needed - the panel pulls map and other data from the mod over RCON whenever it's requested,
                    so nothing needs to be exposed on your side.
                </p>
            </div>
        }
        else if (IsInitializing || IsCompleted || HasError)
        {
            <div class="space-y-3 mb-4">
                <div class="flex items-center gap-3">
                    <div class="w-6 shrink-0 flex justify-center">
                        @if (HelloStatus == StepStatus.InProgress)
                        {
                            <i class="fas fa-spinner fa-spin text-orange-400 text-sm"></i>
                        }
                        else if (HelloStatus == StepStatus.Success)
                        {
                            <i class="fas fa-check-circle text-emerald-400 text-sm"></i>
                        }
                        else if (HelloStatus == StepStatus.Failed)
                        {
                            <i class="fas fa-times-circle text-red-400 text-sm"></i>
                        }
                    </div>
                    <div>
                        <span class="text-sm @(HelloStatus == StepStatus.InProgress ? "text-white font-medium" : "text-slate-300")">Checking mod status</span>
                        @if (HelloStatus == StepStatus.Success)
                        {
                            <span class="text-xs text-slate-500 ml-2">Plugin is active</span>
                        }
                    </div>
                </div>
            </div>

            @if (IsCompleted)
            {
                <div class="space-y-3 mt-4">
                    <div class="flex items-start gap-3 rounded-lg bg-emerald-500/5 border border-emerald-500/20 px-4 py-3">
                        <i class="fas fa-check-circle text-emerald-400 mt-0.5"></i>
                        <p class="text-sm font-medium text-emerald-400">Initialization completed successfully!</p>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="flex items-start gap-3 rounded-lg bg-red-500/5 border border-red-500/20 px-4 py-3 mt-4">
                    <i class="fas fa-exclamation-circle text-red-400 mt-0.5"></i>
                    <p class="text-sm text-red-400">@ErrorMessage</p>
                </div>
            }
        }
    </div>
    </ChildContent>
    <FooterContent>
        <div class="flex justify-end gap-2 w-full">
            @if (!IsInitializing && !IsCompleted)
            {
                <button class="px-4 py-2 text-sm font-medium text-slate-300 bg-slate-700 hover:bg-slate-600 rounded-lg transition-colors" @onclick="Close">Cancel</button>
                <button class="px-4 py-2 text-sm font-medium text-white bg-orange-500 hover:bg-orange-600 rounded-lg transition-colors" @onclick="StartInitialization">
                    <i class="fas fa-rocket mr-2"></i>Start
                </button>
            }
            else if (IsInitializing)
            {
                <button class="px-4 py-2 text-sm font-medium text-slate-400 bg-slate-700 rounded-lg cursor-not-allowed opacity-60" disabled>
                    <i class="fas fa-spinner fa-spin mr-2"></i>Please wait...
                </button>
            }
            else if (IsCompleted || HasError)
            {
                <button class="px-4 py-2 text-sm font-medium text-white bg-orange-500 hover:bg-orange-600 rounded-lg transition-colors" @onclick="CloseAndRefresh">Done</button>
            }
        </div>
    </FooterContent>
</TwModal>

@code {
    [Parameter] public EventCallback OnInitialized { get; set; }

    private int ServerId;
    private string ServerName = string.Empty;
    private bool IsInitializing = false;
    private bool IsCompleted = false;
    private bool HasError = false;
    private string ErrorMessage = string.Empty;

    private StepStatus HelloStatus = StepStatus.Pending;

    private enum StepStatus { Pending, InProgress, Success, Failed }

    public bool IsOpen { get; private set; } = false;

    public void Open(int serverId, string serverName)
    {
        ServerId = serverId;
        ServerName = serverName;
        IsInitializing = false;
        IsCompleted = false;
        HasError = false;
        ErrorMessage = string.Empty;
        HelloStatus = StepStatus.Pending;
        IsOpen = true;
        StateHasChanged();
    }

    public void Close()
    {
        IsOpen = false;
        StateHasChanged();
    }

    private async Task CloseAndRefresh()
    {
        IsOpen = false;
        await OnInitialized.InvokeAsync();
        StateHasChanged();
    }

    private async Task StartInitialization()
    {
        IsInitializing = true;
        HasError = false;
        ErrorMessage = string.Empty;
        HelloStatus = StepStatus.InProgress;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync($"/api/Rcon/InitializeRrsmMod/{ServerId}/hello", null);
            if (!response.IsSuccessStatusCode)
            {
                HelloStatus = StepStatus.Failed;
                var error = await response.Content.ReadAsStringAsync();
                ErrorMessage = string.IsNullOrEmpty(error) ? "Failed to connect to the mod." : error;
                HasError = true;
                IsInitializing = false;
                StateHasChanged();
                return;
            }

            HelloStatus = StepStatus.Success;
            IsInitializing = false;
            IsCompleted = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            HelloStatus = StepStatus.Failed;
            ErrorMessage = $"Error: {ex.Message}";
            HasError = true;
            IsInitializing = false;
            StateHasChanged();
        }
    }
}
