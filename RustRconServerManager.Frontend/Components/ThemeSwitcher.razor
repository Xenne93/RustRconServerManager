@using RustRconServerManager.Frontend.Services
@inject ThemeService ThemeService

<button type="button"
        class="tw-btn-ghost tw-btn-icon text-slate-400 hover:text-white"
        title="@(isLight ? "Switch to dark theme" : "Switch to light theme")"
        aria-label="Toggle light/dark theme"
        @onclick="Toggle">
    @if (isLight)
    {
        <i class="fas fa-moon"></i>
    }
    else
    {
        <i class="fas fa-sun"></i>
    }
</button>

@code {
    private bool isLight = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var current = await ThemeService.GetThemeAsync();
                isLight = current == "light";
                StateHasChanged();
            }
            catch
            {
                // JS interop unavailable (e.g. prerendering) - keep the default (dark)
            }
        }
    }

    private async Task Toggle()
    {
        isLight = !isLight;
        await ThemeService.SetThemeAsync(isLight ? "light" : "dark");
    }
}
