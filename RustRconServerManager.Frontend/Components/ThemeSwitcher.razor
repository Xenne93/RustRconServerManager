@using System
@using System.Diagnostics
@inject IJSRuntime JSRuntime

<div class="theme-switcher d-flex gap-2">
    <button type="button"
            class="btn theme-btn"
            data-bs-theme-value="light"
            title="Light theme"
            aria-label="Switch to light theme">
        <i class="fas fa-sun"></i>
    </button>
    <button type="button"
            class="btn theme-btn"
            data-bs-theme-value="dark"
            title="Dark theme"
            aria-label="Switch to dark theme">
        <i class="fas fa-moon"></i>
    </button>
    <button type="button"
            class="btn theme-btn"
            data-bs-theme-value="auto"
            title="Auto (system preference)"
            aria-label="Use system theme preference">
        <i class="fas fa-circle-half-stroke"></i>
    </button>
</div>

<style>
    .theme-switcher {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .theme-btn {
        width: 36px;
        height: 36px;
        min-width: 36px;
        min-height: 36px;
        padding: 0 !important;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        border: 1px solid var(--bs-border-color) !important;
        background-color: var(--card-bg) !important;
        color: var(--bs-body-color) !important;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

    .theme-btn:hover:not(.active) {
        background-color: var(--bs-tertiary-bg) !important;
        border-color: var(--accent-primary) !important;
        color: var(--accent-primary) !important;
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .theme-btn.active {
        background-color: var(--accent-primary) !important;
        border-color: var(--accent-primary) !important;
        color: #000 !important;
        box-shadow: var(--shadow-md);
        font-weight: 600;
    }

    .theme-btn i {
        pointer-events: none;
    }
</style>

@code {
    // Theme switching is handled by JavaScript event delegation in index.html
    // The buttons have data-bs-theme-value attributes that trigger the theme change
}
