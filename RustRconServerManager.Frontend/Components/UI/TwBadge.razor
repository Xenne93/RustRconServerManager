@* Tailwind Badge Component *@

<span class="@GetBadgeClasses()" @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string GetBadgeClasses()
    {
        var variantClass = Variant switch
        {
            "primary" => "tw-badge-primary",
            "success" => "tw-badge-success",
            "warning" => "tw-badge-warning",
            "danger" => "tw-badge-danger",
            "info" => "tw-badge-info",
            _ => "tw-badge-default"
        };

        var sizeClass = Size switch
        {
            "sm" => "text-[10px] px-1.5",
            "lg" => "text-sm px-3 py-1",
            _ => ""
        };

        return $"{variantClass} {sizeClass} {Class}".Trim();
    }
}
