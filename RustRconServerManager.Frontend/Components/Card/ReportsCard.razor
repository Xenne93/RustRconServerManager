@using RustRconServerManager.Shared.PlayerList
@inject HttpClient Http
@inject IJSRuntime JS

<TwCard HeaderTitle="@($"Player Reports ({FilterReportsByArchiveStatus(reports ?? new List<PlayerReportDto>()).Count})")" HeaderIcon="fas fa-flag">
    <HeaderActions>
        <div class="flex rounded-lg overflow-hidden border border-slate-600">
            <button type="button"
                    class="px-3 py-1 text-xs transition-colors @(!showArchived ? "bg-slate-600 text-white" : "text-slate-400 hover:bg-slate-700")"
                    @onclick="() => ToggleArchiveView(false)">
                Active
            </button>
            <button type="button"
                    class="px-3 py-1 text-xs transition-colors @(showArchived ? "bg-slate-600 text-white" : "text-slate-400 hover:bg-slate-700")"
                    @onclick="() => ToggleArchiveView(true)">
                Archived
            </button>
        </div>
    </HeaderActions>
    <ChildContent>
        @if (reports == null)
        {
            <div class="rounded-lg bg-blue-500/10 border border-blue-500/30 text-blue-400 px-4 py-3 text-sm">Loading reports...</div>
        }
        else if (reports.Count == 0)
        {
            <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-4 py-3 text-sm">No reports found for this server</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="tw-table">
                    <thead>
                        <tr>
                            <th class="cursor-pointer hover:text-orange-400 transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.Reporter)">
                                Reporter <span>@GetSortIndicator(ColumnHeaders.Reporter)</span>
                            </th>
                            <th class="cursor-pointer hover:text-orange-400 transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.Reported)">
                                Reported Player <span>@GetSortIndicator(ColumnHeaders.Reported)</span>
                            </th>
                            <th class="cursor-pointer hover:text-orange-400 transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.Type)">
                                Type <span>@GetSortIndicator(ColumnHeaders.Type)</span>
                            </th>
                            <th>Subject</th>
                            <th class="cursor-pointer hover:text-orange-400 transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.Status)">
                                Status <span>@GetSortIndicator(ColumnHeaders.Status)</span>
                            </th>
                            <th class="cursor-pointer hover:text-orange-400 transition-colors" @onclick="() => OnColumnHeaderClick(ColumnHeaders.CreatedAt)">
                                Created <span>@GetSortIndicator(ColumnHeaders.CreatedAt)</span>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in SortReports(FilterReports(FilterReportsByArchiveStatus(reports))))
                        {
                            <tr class="border-b border-slate-700/30 hover:bg-slate-800/30 transition-colors">
                                <td>
                                    <div>
                                        <strong class="text-white">@report.ReporterName</strong>
                                    </div>
                                    <small class="text-slate-400 font-mono">@report.ReporterId</small>
                                </td>
                                <td>
                                    <div>
                                        <strong class="text-white">@report.ReportedName</strong>
                                    </div>
                                    <small class="text-slate-400 font-mono">@report.ReportedId</small>
                                </td>
                                <td>
                                    <TwBadge Variant="default">@report.Type</TwBadge>
                                </td>
                                <td>
                                    <div class="text-slate-400 max-w-[300px] overflow-hidden text-ellipsis whitespace-nowrap">
                                        @report.Subject
                                    </div>
                                    @if (!string.IsNullOrEmpty(report.Message))
                                    {
                                        <small class="text-slate-500 max-w-[300px] overflow-hidden text-ellipsis whitespace-nowrap block">
                                            @report.Message
                                        </small>
                                    }
                                </td>
                                <td>
                                    @if (report.Status == "Pending")
                                    {
                                        <TwBadge Variant="warning">Pending</TwBadge>
                                    }
                                    else if (report.Status == "Reviewed")
                                    {
                                        <TwBadge Variant="success">Reviewed</TwBadge>
                                    }
                                    else if (report.Status == "Dismissed")
                                    {
                                        <TwBadge Variant="default">Dismissed</TwBadge>
                                    }
                                    else
                                    {
                                        <TwBadge Variant="info">@report.Status</TwBadge>
                                    }
                                </td>
                                <td>
                                    <small class="text-slate-400">@report.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</small>
                                </td>
                                <td>
                                    <div class="flex gap-1">
                                        <button class="px-2 py-1 text-xs border border-orange-500/50 text-orange-400 hover:bg-orange-500/10 rounded transition-colors" @onclick="() => ViewReport(report)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="px-2 py-1 text-xs border border-red-500/50 text-red-400 hover:bg-red-500/10 rounded transition-colors" @onclick="() => DeleteReport(report)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
</TwCard>

<!-- Report Detail Modal -->
@if (selectedReport != null && showModal)
{
    <TwModal IsOpen="true" IsOpenChanged="@((bool v) => { if (!v) CloseModal(); })" Title="Report Details" Size="lg">
        <ChildContent>
        <div class="space-y-4">
            <!-- Reporter Information -->
            <div>
                <h6 class="text-slate-400 text-sm mb-2">Reporter Information</h6>
                <div class="rounded-lg border border-slate-700/50 p-3">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                        <div><strong class="text-slate-300">Name:</strong> <span class="text-white">@selectedReport.ReporterName</span></div>
                        <div><strong class="text-slate-300">Steam ID:</strong> <span class="text-white font-mono">@selectedReport.ReporterId</span></div>
                    </div>
                </div>
            </div>

            <!-- Reported Player Information -->
            <div>
                <h6 class="text-slate-400 text-sm mb-2">Reported Player</h6>
                <div class="rounded-lg border border-slate-700/50 p-3">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                        <div><strong class="text-slate-300">Name:</strong> <span class="text-white">@selectedReport.ReportedName</span></div>
                        <div><strong class="text-slate-300">Steam ID:</strong> <span class="text-white font-mono">@selectedReport.ReportedId</span></div>
                    </div>
                </div>
            </div>

            <!-- Report Details -->
            <div>
                <h6 class="text-slate-400 text-sm mb-2">Report Information</h6>
                <div class="mb-2">
                    <strong class="text-slate-300">Type:</strong> <TwBadge Variant="default">@selectedReport.Type</TwBadge>
                </div>
                <div class="mb-2">
                    <strong class="text-slate-300">Subject:</strong>
                    <div class="p-2 border border-slate-700/50 rounded-lg mt-1 text-white">@selectedReport.Subject</div>
                </div>
                @if (!string.IsNullOrEmpty(selectedReport.Message))
                {
                    <div class="mb-2">
                        <strong class="text-slate-300">Message:</strong>
                        <div class="p-2 border border-slate-700/50 rounded-lg mt-1 text-white">@selectedReport.Message</div>
                    </div>
                }
                <div class="mb-2">
                    <strong class="text-slate-300">Created:</strong> <span class="text-white">@selectedReport.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss")</span>
                </div>
            </div>

            <!-- Status Selection -->
            <div>
                <label class="block text-sm font-medium text-slate-300 mb-1">Status</label>
                <select class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 transition-colors" @bind="editStatus">
                    <option value="Pending">Pending</option>
                    <option value="Reviewed">Reviewed</option>
                    <option value="Dismissed">Dismissed</option>
                    <option value="Action Taken">Action Taken</option>
                </select>
            </div>

            <!-- Admin Notes -->
            <div>
                <label class="block text-sm font-medium text-slate-300 mb-1">Admin Notes</label>
                <textarea class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-3 py-2 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-orange-500/50 focus:border-orange-500 transition-colors" rows="4" @bind="editAdminNotes" placeholder="Add notes about this report..."></textarea>
            </div>

            <!-- Archive Toggle -->
            <div>
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" class="w-4 h-4 rounded border-slate-600 bg-slate-800 text-orange-500 focus:ring-orange-500/50" @bind="editIsArchived" />
                    <div>
                        <span class="text-white font-medium">Archive this report</span>
                        <small class="text-slate-500 block">Archived reports are hidden from the active list</small>
                    </div>
                </label>
            </div>

            @if (selectedReport.ReviewedAt.HasValue)
            {
                <div class="rounded-lg bg-blue-500/10 border border-blue-500/30 text-blue-400 px-4 py-3 text-sm">
                    Last reviewed: @selectedReport.ReviewedAt.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss")
                </div>
            }
        </div>
        </ChildContent>

        <FooterContent>
            <TwButton Variant="secondary" OnClick="CloseModal">Close</TwButton>
            <TwButton Variant="primary" OnClick="SaveReport">
                <i class="fas fa-save mr-1"></i>Save Changes
            </TwButton>
        </FooterContent>
    </TwModal>
}

@code {
    [Parameter]
    public int ServerId { get; set; }

    [Parameter]
    public string SearchTerm { get; set; } = "";

    private List<PlayerReportDto>? reports;
    private string sortColumn = ColumnHeaders.CreatedAt;
    private bool sortAscending = false;
    private bool showArchived = false;

    // Modal state
    private bool showModal = false;
    private PlayerReportDto? selectedReport = null;
    private string editStatus = "";
    private string editAdminNotes = "";
    private bool editIsArchived = false;

    // Column header constants for type-safe sorting
    private static class ColumnHeaders
    {
        public const string Reporter = "Reporter";
        public const string Reported = "Reported";
        public const string Type = "Type";
        public const string Status = "Status";
        public const string CreatedAt = "CreatedAt";
    }

    protected override async Task OnInitializedAsync()
    {
        await FetchReports();
    }

    protected override async Task OnParametersSetAsync()
    {
        await FetchReports();
    }

    public async Task RefreshAsync()
    {
        await FetchReports();
    }

    private async Task FetchReports()
    {
        try
        {
            // Don't fetch if ServerId is invalid (0 or less)
            if (ServerId <= 0)
            {
                reports = new List<PlayerReportDto>();
                return;
            }

            reports = await Http.GetFromJsonAsync<List<PlayerReportDto>>($"/api/Dashboard/GetServerReports/{ServerId}");

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching reports: {ex.Message}");
            reports = new List<PlayerReportDto>();
        }
    }

    private List<PlayerReportDto> FilterReports(List<PlayerReportDto> reportsList)
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
            return reportsList;

        var term = SearchTerm.ToLower();
        return reportsList.Where(r =>
            (r.ReporterName ?? "").ToLower().Contains(term) ||
            (r.ReporterId ?? "").ToLower().Contains(term) ||
            (r.ReportedName ?? "").ToLower().Contains(term) ||
            (r.ReportedId ?? "").ToLower().Contains(term) ||
            (r.Subject ?? "").ToLower().Contains(term) ||
            (r.Type ?? "").ToLower().Contains(term)
        ).ToList();
    }

    private List<PlayerReportDto> FilterReportsByArchiveStatus(List<PlayerReportDto> reportsList)
    {
        return reportsList.Where(r => r.IsArchived == showArchived).ToList();
    }

    private void ToggleArchiveView(bool archived)
    {
        showArchived = archived;
    }

    private List<PlayerReportDto> SortReports(List<PlayerReportDto> reportsList)
    {
        var sorted = sortColumn switch
        {
            ColumnHeaders.Reporter => reportsList.OrderBy(r => r.ReporterName ?? ""),
            ColumnHeaders.Reported => reportsList.OrderBy(r => r.ReportedName ?? ""),
            ColumnHeaders.Type => reportsList.OrderBy(r => r.Type ?? ""),
            ColumnHeaders.Status => reportsList.OrderBy(r => r.Status ?? ""),
            ColumnHeaders.CreatedAt => reportsList.OrderBy(r => r.CreatedAt),
            _ => reportsList.OrderBy(r => r.CreatedAt)
        };

        return sortAscending ? sorted.ToList() : sorted.Reverse().ToList();
    }

    private void OnColumnHeaderClick(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column)
            return "";

        return sortAscending ? " ▲" : " ▼";
    }

    private void ViewReport(PlayerReportDto report)
    {
        selectedReport = report;
        editStatus = report.Status;
        editAdminNotes = report.AdminNotes ?? "";
        editIsArchived = report.IsArchived;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        selectedReport = null;
        editStatus = "";
        editAdminNotes = "";
        editIsArchived = false;
    }

    private async Task SaveReport()
    {
        if (selectedReport == null)
            return;

        try
        {
            var updateRequest = new
            {
                Status = editStatus,
                AdminNotes = editAdminNotes,
                IsArchived = editIsArchived
            };

            var response = await Http.PutAsJsonAsync($"/api/Dashboard/UpdateReport/{selectedReport.Id}", updateRequest);

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine($"Report updated successfully");
                CloseModal();
                await FetchReports();
            }
            else
            {
                Console.WriteLine($"Failed to update report");
                await JS.InvokeVoidAsync("alert", "Failed to update report");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating report: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Error updating report");
        }
    }

    private async Task DeleteReport(PlayerReportDto report)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete this report?"))
            return;

        try
        {
            var response = await Http.DeleteAsync($"/api/Dashboard/DeleteReport/{report.Id}");

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine($"Report deleted successfully");
                await FetchReports();
            }
            else
            {
                Console.WriteLine($"Failed to delete report");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting report: {ex.Message}");
        }
    }
}
