@using RustRconServerManager.Frontend.Services
@inject PageAccessService PageAccess
@inject NavigationHelper NavHelper

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Checking access...</span>
        </div>
    </div>
}
else if (hasAccess)
{
    @ChildContent
}
else
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body text-center">
                            <i class="fas fa-lock fa-3x text-danger mb-3" style="-webkit-text-stroke: 0; text-stroke: 0;"></i>
                            <h3>Access Denied</h3>
                            <p class="text-muted">You do not have permission to access this page.</p>
                            <button class="btn btn-primary mt-3" @onclick="GoToDashboard">
                                <i class="fas fa-home me-2"></i>Go to Dashboard
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string PageRoute { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool isLoading = true;
    private bool hasAccess = false;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(PageRoute))
        {
            hasAccess = true;
            isLoading = false;
            return;
        }

        hasAccess = await PageAccess.HasPageAccess(PageRoute);
        isLoading = false;
    }

    private void GoToDashboard()
    {
        NavHelper.NavigateTo("dashboard", true);
    }
}
