# Copy this file to .env and fill in real values (or just run ./setup.sh, which
# generates all of this for you with random credentials).
#
# Get available image tags from: https://github.com/Xenne93/RustRconServerManager/releases
IMAGE_TAG=latest

# Port the app is exposed on
APP_PORT=5000

# Optional: path prefix if you run this behind a reverse proxy at a subpath (e.g. /panel)
PATHBASE=

# Database (bundled MariaDB container - see docker-compose.yml)
DB_NAME=rustrconservermanager
DB_USER=rustrconservermanager
DB_PASSWORD=changeme-generate-a-random-password
MARIADB_ROOT_PASSWORD=changeme-generate-a-random-password

# JWT signing (generate a long random string - do not reuse this example value)
JWT_KEY=changeme-generate-a-random-32-plus-character-key
JWT_ISSUER=RustRconServerManager
JWT_AUDIENCE=RustRconServerManager

# RCON connection encryption key (generate a random string)
RCON_ENCRYPTION_KEY=changeme-generate-a-random-key

# SMTP - required for the "forgot password" email flow. Leave blank to disable it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: Steam API key (player profile/VAC-ban lookups) - https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Optional: proxycheck.io key (VPN/proxy detection in Server Protection) - https://proxycheck.io/
PROXYCHECK_API_KEY=
PROXYCHECK_HMAC_KEY=

# Auto-update: check GitHub Releases on container start and update in place
AUTO_UPDATE=true
SKIP_AUTO_UPDATE=false
